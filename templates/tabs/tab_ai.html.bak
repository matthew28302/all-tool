<div aria-labelledby="tabbtn-ai" class="tab-content" hidden="" id="tab-ai" role="tabpanel" style="padding:0; box-shadow:none; background:transparent;">
<div class="ai-shell">
<aside class="ai-sidebar" id="aiSidebar">
<div class="ai-sidebar-header">
<div style="display:flex; gap:8px; align-items:center;">
<div class="dns-panel-title" style="margin:0; font-size:1.1rem;"><span class="icon" data-lucide="message-square"></span> Chat History</div>
<button class="ai-prompt-btn" onclick="createNewAIChat()" style="padding:4px 10px;">+ mới</button>
</div>
<div style="display:flex; gap:8px; align-items:center;">
<button class="ai-prompt-btn" onclick="clearAllAIChats()" title="Xoá tất cả đoạn chat"><span class="icon" data-lucide="trash-2"></span></button>
</div>
</div>
<div class="ai-history-list" id="aiHistoryList"></div>
</aside>
<div class="ai-chat-pane">
<div class="ai-chat-main">
<div class="ai-chat-header">
<div style="display:flex; flex-direction:column; gap:6px;">
<div class="dns-panel-title" style="display:flex; align-items:center; gap:10px; margin:0;">
                                <span class="icon" data-lucide="bot"></span> AI Chat (Streaming)
                                <span class="ai-badge-active" id="aiActiveModelBadge" title="Model đang sử dụng">meta/llama-3.3-70b-instruct</span>
</div>
</div>
<div style="display:flex; gap:8px;">
<button class="ai-prompt-btn" onclick="deleteActiveAIChat()" title="Xoá đoạn chat hiện tại" type="button"><span class="icon" data-lucide="trash-2"></span></button>
<button class="ai-prompt-btn" id="aiPromptToggle" onclick="toggleAIPromptPanel()" type="button"><span class="icon" data-lucide="settings"></span> Cấu hình Model</button>
</div>
</div>
<div class="ai-chat-messages" id="aiMessagesList"></div>
<div class="ai-composer">
<textarea id="aiComposerInput" onkeydown="onAIComposerKeyDown(event)" placeholder="Nhập tin nhắn... (Enter để gửi, Shift+Enter để xuống dòng)"></textarea>
<div class="ai-attachment-preview" id="aiAttachmentPreview" style="margin-top:0;"></div>
<div class="ai-compose-actions">
<div class="ai-compose-actions-left">
<label class="ai-prompt-btn" style="cursor:pointer; margin:0; font-size:0.85rem;">
                                    📎 Đính kèm
                                    <input hidden="" id="aiFileInput" multiple="" type="file"/>
</label>
<button class="ai-prompt-btn" onclick="clearAIAttachments()" style="margin:0; font-size:0.85rem;" type="button">🧹 Xóa</button>
</div>
<div style="display:flex; gap:10px;">
<button class="btn btn-danger" id="aiStopBtn" onclick="stopAIStream()" style="display:none; border-radius:8px; padding:0 16px; height:40px; font-size:0.9rem;" type="button">🛑 Dừng</button>
<button class="btn btn-primary" id="aiSendBtn" onclick="sendAIRequest(this)" style="border-radius:8px; padding:0 24px; height:40px; font-size:0.95rem; font-weight:700;" type="button"><span class="icon" data-lucide="rocket"></span> Gửi</button>
</div>
</div>
</div>
</div>
<div class="ai-settings-sidebar" id="aiPromptPanel">
<div class="ai-settings-header">
<div style="display:flex; align-items:center; gap:10px;">
<span class="icon" data-lucide="settings"></span>
<div>
<div style="font-weight:700; color:#0f172a;">Cài đặt AI</div>
<div style="font-size:0.85rem; color:#64748b;">API key và cấu hình mô hình</div>
</div>
</div>
<button class="ai-prompt-btn" onclick="toggleAIPromptPanel(false)" type="button" style="height:36px; padding:0 14px; border-radius:10px; font-size:0.9rem;">Đóng</button>
</div>
<div class="ai-settings-sidebar-body">
<div class="ai-sidebar-card">
<div style="display:flex; flex-direction:column; gap:10px;">
<label>Nhà cung cấp:</label>
<select class="dns-input ai-premium-select" id="aiProviderSelect" onchange="onAIProviderChange()">
<option selected="" value="nvidia">NVIDIA NIM</option>
<option value="agnes">Agnes AI</option>
<option value="custom">Custom API</option>
</select>
</div>
<div style="display:flex; flex-direction:column; gap:10px; min-width:0; margin-top:16px;">
<label>Model AI (<span id="aiModelCount">Đang tải...</span>):</label>
<select class="dns-input ai-premium-select" id="aiModelSelect" onchange="onAIModelSelectChange()">
<option value="meta/llama-3.3-70b-instruct">meta/llama-3.3-70b-instruct</option>
</select>
</div>
<div style="display:flex; gap:8px; align-items:flex-end; margin-top:16px;">
<button class="btn btn-primary" id="aiTestSpeedBtn" onclick="testAllModelsSpeed()" style="height:40px; padding:0 16px; border-radius:8px; font-weight:700; font-size:0.9rem; display:flex; align-items:center; gap:6px;" type="button">
<span><span class="icon" data-lucide="zap"></span></span> Kiểm thử
</button>
<button class="btn btn-secondary" onclick="loadAIModels(true)" type="button">
<span><span class="icon" data-lucide="refresh-cw"></span></span> Reload
</button>
</div>
</div>
<div class="ai-sidebar-card">
<div class="ai-filter-row">
<div>
<input class="dns-input" id="aiModelSearchInput" oninput="filterAIModels()" placeholder="Tìm kiếm Model..." style="height:38px; padding:0 12px; font-size:0.9rem; border-radius:8px; width:100%; box-sizing:border-box;" type="text"/>
</div>
<div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
<span style="font-size:0.85rem; font-weight:700; color:#64748b;">Phân loại:</span>
<button class="ai-filter-tab active" data-speed="all" onclick="setAISpeedFilter('all', this)" type="button">Tất cả</button>
<button class="ai-filter-tab" data-speed="fast" onclick="setAISpeedFilter('fast', this)" type="button"><span class="icon" data-lucide="rocket"></span> Nhanh</button>
<button class="ai-filter-tab" data-speed="medium" onclick="setAISpeedFilter('medium', this)" type="button"><span class="icon" data-lucide="zap"></span> T.Bình</button>
<button class="ai-filter-tab" data-speed="slow" onclick="setAISpeedFilter('slow', this)" type="button">🐢 Chậm</button>
<button class="ai-filter-tab" data-speed="working" onclick="setAISpeedFilter('working', this)" type="button"><span class="icon" data-lucide="shield"></span> Hoạt động</button>
</div>
</div>
<div class="ai-presets-row">
<span style="font-size:0.85rem; font-weight:700; color:#64748b;">Gợi ý:</span>
<button class="ai-model-chip" onclick="selectAIModel('meta/llama-3.3-70b-instruct')" type="button"><span class="icon" data-lucide="zap"></span> Llama 3.3 70B</button>
<button class="ai-model-chip" onclick="selectAIModel('deepseek-ai/deepseek-r1')" type="button">🔥 DeepSeek R1</button>
<button class="ai-model-chip" onclick="selectAIModel('nvidia/llama-3.1-nemotron-70b-instruct')" type="button"><span class="icon" data-lucide="bot"></span> Nemotron 70B</button>
<button class="ai-model-chip" onclick="selectAIModel('mistralai/mistral-large-2-instruct')" type="button">💨 Mistral Large 2</button>
<button class="ai-model-chip" onclick="selectAIModel('qwen/qwen2.5-72b-instruct')" type="button"><span class="icon" data-lucide="star"></span> Qwen 2.5 72B</button>
</div>
</div>
<div class="ai-sidebar-card" id="aiTestStatusProgress" style="display:none; margin-top:0px; background:#e0e7ff; color:#3730a3; padding:12px 16px; border-radius:12px; font-size:0.9rem; font-weight:600; text-align:center;">
<span class="icon" data-lucide="zap"></span> Đang kiểm thử kết nối song song...
</div>
<div class="ai-sidebar-card" id="aiCustomKeyBlock" style="display:none; margin-top:0px;">
<div style="display:flex; gap:12px; flex-wrap:wrap;">
<input class="dns-input" id="aiApiKeyInput" onchange="saveAIKeyConfig()" placeholder="API Key" style="flex:1; min-width:200px; padding:10px 12px; font-size:0.9rem; border-radius:8px;" type="text"/>
<input class="dns-input" id="aiApiBaseInput" onchange="saveAIKeyConfig()" placeholder="API Base URL" style="flex:1; min-width:200px; padding:10px 12px; font-size:0.9rem; border-radius:8px;" type="text"/>
</div>
</div>
<div class="ai-sidebar-card">
<div class="field-block" style="margin:0;">
<label class="field-label" style="margin-bottom:8px;">Custom prompt hệ thống</label>
<textarea id="aiCustomPromptInput" placeholder="Dán nội dung prompt hệ thống ở đây..." style="width:100%; min-height:80px; border:1px solid #cbd5e1; border-radius:8px; padding:10px; font:inherit; resize:vertical; box-sizing:border-box; background:#ffffff;"></textarea>
</div>
</div>
<div class="ai-sidebar-card">
<div class="ai-settings-actions">
<button class="btn btn-secondary" onclick="toggleAIPromptPanel(false)" style="height:40px; padding:0 18px; border-radius:12px; font-size:0.95rem;">Đóng</button>
<button class="btn btn-primary" onclick="saveAICustomPrompt(); toggleAIPromptPanel(false);" style="height:40px; padding:0 18px; border-radius:12px; font-size:0.95rem;">💾 Lưu</button>
</div>
</div>
</div>
</div>

<textarea id="aiComposerInput" onkeydown="onAIComposerKeyDown(event)" placeholder="Nhập tin nhắn... (Enter để gửi, Shift+Enter để xuống dòng)"></textarea>
<div class="ai-attachment-preview" id="aiAttachmentPreview" style="margin-top:0;"></div>
<div class="ai-compose-actions">
<div class="ai-compose-actions-left">
<label class="ai-prompt-btn" style="cursor:pointer; margin:0; font-size:0.85rem;">
                                    📎 Đính kèm
                                    <input hidden="" id="aiFileInput" multiple="" type="file"/>
</label>
<button class="ai-prompt-btn" onclick="clearAIAttachments()" style="margin:0; font-size:0.85rem;" type="button">🧹 Xóa</button>
</div>
<div style="display:flex; gap:10px;">
<button class="btn btn-danger" id="aiStopBtn" onclick="stopAIStream()" style="display:none; border-radius:8px; padding:0 16px; height:40px; font-size:0.9rem;" type="button">🛑 Dừng</button>
<button class="btn btn-primary" id="aiSendBtn" onclick="sendAIRequest(this)" style="border-radius:8px; padding:0 24px; height:40px; font-size:0.95rem; font-weight:700;" type="button"><span class="icon" data-lucide="rocket"></span> Gửi</button>
</div>
</div>
</div>
</div>
</div>
</div>
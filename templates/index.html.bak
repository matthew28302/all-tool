<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Network Tools</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23000'/><rect x='2' y='2' width='13' height='13' fill='%23fff'/><rect x='17' y='2' width='13' height='13' fill='%23000' stroke='%23fff' stroke-width='2'/><rect x='2' y='17' width='13' height='13' fill='%23000' stroke='%23fff' stroke-width='2'/><rect x='17' y='17' width='13' height='13' fill='%23fff'/></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/theme-premium.css') }}">
</head>
<body>
    <div class="container">
        <!-- Tab Navigation -->
        <div class="tab-nav" role="tablist" aria-label="Network tool tabs">
            
            <div class="nav-group-header">Mạng & Tên Miền</div>
            
            <button class="tab-btn active" data-tab="dns" id="tabbtn-dns" role="tab" aria-selected="true" aria-controls="tab-dns" tabindex="0" onclick="switchTab('dns')">
                <span class="icon" data-lucide="search"></span> DNS
            </button>
            <button class="tab-btn" data-tab="bulkdns" id="tabbtn-bulkdns" role="tab" aria-selected="false" aria-controls="tab-bulkdns" tabindex="-1" onclick="switchTab('bulkdns')">
                <span class="icon" data-lucide="files"></span> Bulk DNS
            </button>
            <button class="tab-btn" data-tab="dnshistory" id="tabbtn-dnshistory" role="tab" aria-selected="false" aria-controls="tab-dnshistory" tabindex="-1" onclick="switchTab('dnshistory')">
                <span class="icon" data-lucide="history"></span> DNS History
            </button>
            <button class="tab-btn" data-tab="hostcheck" id="tabbtn-hostcheck" role="tab" aria-selected="false" aria-controls="tab-hostcheck" tabindex="-1" onclick="switchTab('hostcheck')">
                <span class="icon" data-lucide="computer"></span> Host Check
            </button>

            <div class="nav-divider"></div>
            <div class="nav-group-header">Công Cụ SSL</div>
            
            <button class="tab-btn" data-tab="sslcheck" id="tabbtn-sslcheck" role="tab" aria-selected="false" aria-controls="tab-sslcheck" tabindex="-1" onclick="switchTab('sslcheck')">
                <span class="icon" data-lucide="shield-check"></span> SSL Check
            </button>
            <button class="tab-btn" data-tab="ssl" id="tabbtn-ssl" role="tab" aria-selected="false" aria-controls="tab-ssl" tabindex="-1" onclick="switchTab('ssl')">
                <span class="icon" data-lucide="lock"></span> SSL Bundle
            </button>
            <button class="tab-btn" data-tab="installssl" id="tabbtn-installssl" role="tab" aria-selected="false" aria-controls="tab-installssl" tabindex="-1" onclick="switchTab('installssl')">
                <span class="icon" data-lucide="hard-drive"></span> Install SSL
            </button>
            <button class="tab-btn" data-tab="ssldecoder" id="tabbtn-ssldecoder" role="tab" aria-selected="false" aria-controls="tab-ssldecoder" tabindex="-1" onclick="switchTab('ssldecoder')">
                <span class="icon" data-lucide="scan-search"></span> SSL Decoder
            </button>
            <button class="tab-btn" data-tab="freessl" id="tabbtn-freessl" role="tab" aria-selected="false" aria-controls="tab-freessl" tabindex="-1" onclick="switchTab('freessl')">
                <span class="icon" data-lucide="gift"></span> SSL Miễn Phí
            </button>

            <div class="nav-divider"></div>
            <div class="nav-group-header">Trợ Lý Ảo</div>
            
            <button class="tab-btn ai-tab-btn" data-tab="ai" id="tabbtn-ai" role="tab" aria-selected="false" aria-controls="tab-ai" tabindex="-1" onclick="switchTab('ai')">
                <span class="icon" data-lucide="message-circle"></span> AI Chat
            </button>
        </div>
        
        <div class="main-content-area">
        <!-- DNS Checker Tab -->
        <div id="tab-dns" class="tab-content active" role="tabpanel" aria-labelledby="tabbtn-dns">
            <div class="dns-shell">
                <div class="dns-hero">
                    <div class="dns-card dns-search-card">
                        <div class="dns-panel-header">
                            <div>
                                <div class="dns-panel-title">DNS Checker</div>
                            </div>
                        </div>

                        <div class="dns-search-row">
                            <input type="text" class="dns-input" id="domainInput"
                                   placeholder="Nhập tên miền (vd: google.com)"
                                   onkeypress="if(event.key==='Enter')checkDNS()">
                            <div style="display:flex;gap:8px;align-items:center;">
                                <div class="dns-view-switch" role="group" aria-label="DNS mode" style="margin-right:6px;">
                                    <button type="button" id="dnsModeDetailBtnInline" class="dns-view-btn active" onclick="setDnsMode('detail')">Detail</button>
                                    <button type="button" id="dnsModeBasicBtnInline" class="dns-view-btn" onclick="setDnsMode('basic')">Basic</button>
                                </div>
                                <div class="dns-actions">
                                    <button class="btn btn-primary" onclick="checkDNS()">🔍</button>
                                        <button class="btn btn-secondary" onclick="clearCache()">🗑️</button>
                                </div>
                            </div>
                        </div>

                        <div class="record-types" id="recordTypes">
                            <label><input type="checkbox" value="A" checked><span>A</span></label>
                            <label><input type="checkbox" value="AAAA"><span>AAAA</span></label>
                            <label><input type="checkbox" value="CNAME" checked><span>CNAME</span></label>
                            <label><input type="checkbox" value="MX"><span>MX</span></label>
                            <label><input type="checkbox" value="TXT"><span>TXT</span></label>
                            <label><input type="checkbox" value="NS"><span>NS</span></label>
                            <label><input type="checkbox" value="SOA"><span>SOA</span></label>
                            <label><input type="checkbox" value="CAA"><span>CAA</span></label>
                        </div>

                    </div>

                    <div class="dns-card dns-stats-card">
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Domain</span>
                            <span class="dns-stat-value accent" id="summaryDomain">-</span>
                        </div>
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">DNSSEC</span>
                            <span class="dns-stat-value error" id="summaryDNSSEC">-</span>
                        </div>
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Resolvers</span>
                            <span class="dns-stat-value accent" id="summaryResolvers">-</span>
                        </div>
                    </div>
                </div>

                <div class="loading" id="loading">
                    <div class="spinner"></div>
                    <p class="dns-loading-note">Đang kiểm tra DNS trên nhiều public resolver...</p>
                </div>

                <div class="results-container" id="results">
                    <div class="dns-card dns-results-panel">
                        <div class="dns-section-head">
                            <div class="section-title">📋 DNS Records</div>
                            <div class="dns-head-actions">
                                    <div class="dns-section-chip" id="dnsRecordCountChip">0 record types</div>
                                    <!-- mode toggle moved inline next to input -->
                                <div class="dns-view-switch" role="group" aria-label="DNS view mode">
                                    <button type="button" id="dnsViewCardBtn" class="dns-view-btn active" onclick="setDnsView('card')">Card</button>
                                    <button type="button" id="dnsViewCompactBtn" class="dns-view-btn" onclick="setDnsView('compact')">Compact</button>
                                </div>
                            </div>
                        </div>
                        <div id="whoisPanel" style="margin-bottom:12px;"></div>
                        <div id="dnsRecords" class="dns-record-grid"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-bulkdns" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-bulkdns" hidden>
            <div class="dns-shell">
                <div class="dns-hero">
                    <div class="dns-card dns-search-card">
                        <div class="dns-panel-header">
                            <div>
                                <div class="dns-panel-title">Bulk DNS</div>
                                
                            </div>
                        </div>

                        <div class="bulk-input-wrap">
                            <textarea id="bulkDomainsInput" class="bulk-input" placeholder="example.com, example.vn&#10;google.com&#10;openai.com"></textarea>
                        </div>

                        <div class="dns-search-row">
                            <div class="dns-actions">
                                <button class="btn btn-primary" onclick="checkBulkDNS()">🔍</button>
                                <button class="btn btn-secondary" onclick="clearBulkDNS()">🗑️</button>
                            </div>
                        </div>

                        
                    </div>

                    <div class="dns-card dns-stats-card">
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Domains</span>
                            <span class="dns-stat-value accent" id="bulkSummaryTotal">-</span>
                        </div>
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Có IP</span>
                            <span class="dns-stat-value success" id="bulkSummaryResolved">-</span>
                        </div>
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Không có IP</span>
                            <span class="dns-stat-value error" id="bulkSummaryMissing">-</span>
                        </div>
                        <div class="dns-stat-row">
                            <span class="dns-stat-label">Cập nhật</span>
                            <span class="dns-stat-value accent" id="bulkSummaryUpdated">-</span>
                        </div>
                    </div>
                </div>

                <div class="loading" id="bulkLoading">
                    <div class="spinner"></div>
                    <p class="dns-loading-note">Đang kiểm tra bulk DNS basic...</p>
                </div>

                <div class="results-container" id="bulkResults">
                    <div class="dns-card dns-results-panel">
                        <div class="dns-section-head">
                            <div class="section-title">📋 Bulk DNS Results</div>
                            <div class="dns-section-chip" id="bulkCountChip">0 domains</div>
                        </div>
                        <div class="bulk-table">
                            <div class="bulk-table-head">
                                <div>Tên miền</div>
                                <div>IP đang trỏ</div>
                                <div>MX</div>
                                <div>Nameserver</div>
                            </div>
                            <div id="bulkResultsTable"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="tab-dnshistory" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-dnshistory" hidden>
            <div class="dnshistory-shell">
                <div class="dns-card dns-search-card">
                    <div class="dns-panel-header">
                        <div>
                            <div class="dns-panel-title">DNS History</div>
                            
                        </div>
                    </div>

                    <div class="dns-search-row">
                        <input type="text" class="dns-input" id="dnsHistoryInput"
                               placeholder="Nhập tên miền (vd: example.com)"
                               onkeypress="if(event.key==='Enter')checkDNSHistory()">
                        <div class="dns-actions">
                            <button class="btn btn-primary" onclick="checkDNSHistory()">🔎</button>
                            <button class="btn btn-secondary" onclick="clearDNSHistory()">🗑️</button>
                        </div>
                    </div>
                </div>

                <div class="dns-card dns-stats-card">
                    <div class="history-source-summary">
                        <div class="history-summary-card">
                            <div class="history-summary-label">Domain</div>
                            <div class="history-summary-value" id="historySummaryDomain">-</div>
                        </div>
                        <div class="history-summary-card">
                            <div class="history-summary-label">Sources</div>
                            <div class="history-summary-value success" id="historySummarySources">-</div>
                        </div>
                        <div class="history-summary-card">
                            <div class="history-summary-label">Records</div>
                            <div class="history-summary-value warning" id="historySummaryRecords">-</div>
                        </div>
                        <div class="history-summary-card">
                            <div class="history-summary-label">Updated</div>
                            <div class="history-summary-value" id="historySummaryUpdated">-</div>
                        </div>
                    </div>
                </div>

                <div class="loading" id="dnsHistoryLoading">
                    <div class="spinner"></div>
                    <p class="dns-loading-note">Đang truy vấn Mnemonic và Robtex...</p>
                </div>

                <div class="results-container" id="dnsHistoryResults">
                    <div class="dns-card dns-results-panel">
                        <div class="dns-section-head">
                            <div class="section-title">🕰️ DNS History Results</div>
                            <div class="dns-head-actions">
                                <div class="dns-section-chip" id="dnsHistoryCountChip">0 records</div>
                            </div>
                        </div>
                        <div id="dnsHistorySourceTabs" class="history-source-tabs"></div>
                        <div id="dnsHistorySourcePanels" class="history-source-panels"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- SSL Check Tab -->
        <div id="tab-sslcheck" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-sslcheck" hidden>
                <div class="sslcheck-header">
                <h2>🛡️ SSL Certificate Check</h2>
            </div>

            <div class="search-box">
                      <div class="search-row">
                      <input type="text" class="search-input" id="sslDomainInput" 
                          placeholder="Nhập tên miền (vd: google.com)" 
                          onkeypress="if(event.key==='Enter')checkSSL()">
                      <button class="btn btn-primary" onclick="checkSSL()">🛡️</button>
                  </div>
            </div>

            <div class="loading" id="sslLoading">
                <div class="spinner"></div>
                <p>Đang kiểm tra SSL...</p>
            </div>

            <div id="sslCheckMessage" class="message"></div>

            <div class="results-container" id="sslCheckResults">
                <div class="ssl-info-grid">
                    <div class="ssl-info-card">
                        <div class="card-title">Trạng thái</div>
                        <div id="sslStatus"></div>
                    </div>
                    <div class="ssl-info-card">
                        <div class="card-title">Còn lại</div>
                        <div class="card-value large" id="sslDaysRemaining">-</div>
                        <div class="card-sub">ngày</div>
                    </div>
                    <div class="ssl-info-card full">
                        <div class="card-title">DATE CERT</div>
                        <div class="cert-date-grid">
                            <div class="cert-date-label">Valid From :</div>
                            <div class="cert-date-value" id="sslValidFrom">-</div>
                            <div class="cert-date-label">Valid To   :</div>
                            <div class="cert-date-value" id="sslValidTo">-</div>
                        </div>
                    </div>
                    <div class="ssl-info-card full">
                        <div class="card-title">Nhà cung cấp SSL (Issuer)</div>
                        <div class="card-value" id="sslIssuer">-</div>
                        <div class="card-sub" id="sslIssuerOrg">-</div>
                    </div>
                    <div class="ssl-info-card full">
                        <div class="card-title">Domain / Subject</div>
                        <div class="card-value" id="sslSubject">-</div>
                        <div class="card-sub" id="sslSubjectOrg">-</div>
                    </div>
                    <div class="ssl-info-card full">
                        <div class="card-title">HTTP Redirect</div>
                        <div class="card-value" id="sslRedirectFinal">-</div>
                        <div class="card-sub" id="sslRedirectChain">-</div>
                    </div>
                    <div class="ssl-info-card full">
                        <div class="card-title">Subject Alternative Names (SAN)</div>
                        <div id="sslSAN" class="san-list">-</div>
                    </div>
                    <div class="ssl-info-card">
                        <div class="card-title">Serial Number</div>
                        <div class="card-value mono-sm" id="sslSerial">-</div>
                    </div>
                    <div class="ssl-info-card">
                        <div class="card-title">Version</div>
                        <div class="card-value" id="sslVersion">-</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Host Check Tab -->
        <div id="tab-hostcheck" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-hostcheck" hidden>
            <div class="hostcheck-header">
                <h2>🖥️ Host Check</h2>
            </div>

            <div class="search-box">
                      <div class="search-row">
                      <input type="text" class="search-input" id="hostInput" 
                          placeholder="Nhập IP hoặc Domain (vd: 8.8.8.8 hoặc google.com)" 
                          onkeypress="if(event.key==='Enter')checkHost()">
                      <button class="btn btn-primary" onclick="checkHost()">🖥️</button>
                  </div>
            </div>

            <div class="loading" id="hostLoading">
                <div class="spinner"></div>
                <p>Đang kiểm tra host...</p>
            </div>

            <div id="hostCheckMessage" class="message"></div>

            <div class="results-container" id="hostCheckResults">
                <div class="host-info-grid">
                    <div class="host-info-card">
                        <div class="card-title">IP Address</div>
                        <div class="card-value mono highlight" id="hostIP">-</div>
                    </div>
                    <div class="host-info-card">
                        <div class="card-title">Hostname</div>
                        <div class="card-value mono" id="hostHostname">-</div>
                    </div>
                    <div class="host-info-card full">
                        <div class="card-title">Nhà cung cấp Hosting (ISP)</div>
                        <div class="card-value highlight" id="hostProvider">-</div>
                        <div class="card-sub" id="hostOrg">-</div>
                    </div>
                    <div class="host-info-card full">
                        <div class="card-title">ASN</div>
                        <div class="card-value mono" id="hostASN">-</div>
                    </div>
                    <div class="host-info-card">
                        <div class="card-title">Reverse DNS</div>
                        <div class="card-value mono mono-sm" id="hostReverseDNS">-</div>
                    </div>
                    <div class="host-info-card">
                        <div class="card-title">Vị trí</div>
                        <div id="hostLocation">-</div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- SSL Decoder Tab -->
        <div id="tab-installssl" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-installssl" hidden>
            <div class="dns-shell">
                <div class="installssl-layout">
                    <div class="installssl-panel">
                        <div class="dns-panel-header">
                            <div>
                                <div class="dns-panel-title">Install SSL</div>
                                
                            </div>
                        </div>

                        <div class="installssl-form-grid">
                            <div class="installssl-field-block">
                                <label class="field-label">Domain *</label>
                                <input type="text" class="dns-input" id="installSslDomain" placeholder="example.com">
                            </div>

                            <div class="installssl-field-block">
                                <label class="field-label">Server IP / Hostname</label>
                                <input type="text" class="dns-input" id="installSslServer" placeholder="vd: 103.77.162.3 hoặc server.example.com (tùy chọn)">
                            </div>

                            <div class="installssl-field-block">
                                <label class="field-label">Root password</label>
                                <input type="password" class="dns-input" id="installSslPassword" placeholder="Nhập mật khẩu root nếu có">
                            </div>

                            <div class="installssl-field-block fullwidth">
                                <label class="field-label">Private Key</label>
                                <textarea class="dns-input pem-editor" id="installSslKey" rows="8" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
                            </div>

                            <div class="installssl-field-block fullwidth">
                                <label class="field-label">Certificate</label>
                                <textarea class="dns-input pem-editor" id="installSslCert" rows="8" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                            </div>

                            <div class="installssl-field-block fullwidth">
                                <label class="field-label">CA Bundle</label>
                                <textarea class="dns-input pem-editor" id="installSslBundle" rows="8" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                            </div>
                        </div>

                        <div class="installssl-actions">
                            <button class="btn btn-primary" onclick="installSslSubmit()">🚀 Cài SSL</button>
                            <button class="btn btn-secondary" onclick="installSslReset()">🧹 Reset</button>
                        </div>

                        <div id="installSslMessage" class="message installssl-message"></div>
                    </div>

                    <div class="installssl-panel alt">
                        <div class="dns-panel-header">
                            <div>
                                <div class="dns-panel-title">Danh sách cert có sẵn</div>
                                
                            </div>
                        </div>
                        <div class="installssl-catalog-config field-block" style="margin-top: 12px;">
                            <label class="field-label">Mở thư mục scan SSL</label>
                            <div class="installssl-folder-row">
                                <input type="text" class="dns-input" id="installSslCatalogPath" placeholder="Ví dụ: /home/youruser/Desktop/ssl">
                                <button class="btn btn-secondary" onclick="installSslChooseFolder()">📂 Open Folder</button>
                                <button class="btn btn-secondary" onclick="installSslResetCatalog()">⟲ Reset</button>
                            </div>
                            
                            <input id="installSslUploadFolder" type="file" webkitdirectory directory multiple style="display:none" onchange="installSslUploadFolderChanged(event)">
                        </div>
                        <div id="installSslCatalogInfo" class="installssl-catalog-info">Đang dùng thư mục mặc định /home/nvpa/Desktop/ssl</div>
                        <div id="installSslCatalogList" class="installssl-catalog">
                            <div class="installssl-empty">Đang quét thư mục SSL...</div>
                        </div>
                    </div>
                </div>

                <div class="installssl-log" style="margin-top:16px;">
                    <div class="installssl-log-header">Log cài SSL</div>
                    <pre id="installSslOutput" class="installssl-output">Chưa có log.</pre>
                </div>
            </div>
        </div>

        <div id="tab-ssldecoder" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-ssldecoder" hidden>
                <div class="ssldecoder-header">
                <h2>🔐 SSL Decoder & Matcher</h2>
            </div>

            <div class="ssldecoder-switch">
                <button id="ssldecoderBtnMatch" class="ssldecoder-mode-btn active" onclick="setSSLDecoderMode('match')">🔗 Match Checker</button>
                <button id="ssldecoderBtnCert" class="ssldecoder-mode-btn" onclick="setSSLDecoderMode('cert')">📜 Certificate Decoder</button>
                <button id="ssldecoderBtnCsr" class="ssldecoder-mode-btn" onclick="setSSLDecoderMode('csr')">📝 CSR Decoder</button>
            </div>
            
            <!-- Cert + Key Match Checker -->
            <div id="decoderPanelMatch" class="decoder-panel active">
                <div class="decoder-section">
                    <h3>🔗 Cert & Key Match Checker <span class="badge badge-match">MATCH CHECK</span></h3>
                    <div class="decoder-row">
                        <div class="decoder-col">
                            <label>Certificate (PEM)</label>
                            <textarea id="matchCertInput" placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----"></textarea>
                        </div>
                        <div class="decoder-col">
                            <label>Private Key (PEM)</label>
                            <textarea id="matchKeyInput" placeholder="-----BEGIN PRIVATE KEY-----&#10;or&#10;-----BEGIN RSA PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----"></textarea>
                        </div>
                    </div>
                    <div id="matchResult" class="match-result pending">Nhập Certificate và Private Key để kiểm tra</div>
                </div>
            </div>
            
            <!-- Certificate Decoder -->
            <div id="decoderPanelCert" class="decoder-panel">
                <div class="decoder-section">
                    <h3>📜 Certificate Decoder <span class="badge badge-decode">DECODE</span></h3>
                    <div class="decoder-col mb-16">
                        <label>Certificate (PEM)</label>
                        <textarea id="decodeCertInput" placeholder="-----BEGIN CERTIFICATE-----&#10;...&#10;-----END CERTIFICATE-----"></textarea>
                    </div>
                    <div id="certDecodeResult" class="decode-result"></div>
                </div>
            </div>
            
            <!-- CSR Decoder -->
            <div id="decoderPanelCsr" class="decoder-panel">
                <div class="decoder-section">
                    <h3>📝 CSR Decoder <span class="badge badge-decode">DECODE</span></h3>
                    <div class="decoder-col mb-16">
                        <label>CSR (Certificate Signing Request)</label>
                        <textarea id="decodeCSRInput" placeholder="-----BEGIN CERTIFICATE REQUEST-----&#10;...&#10;-----END CERTIFICATE REQUEST-----"></textarea>
                    </div>
                    <div id="csrDecodeResult" class="decode-result"></div>
                </div>
            </div>
        </div>
        
        <!-- SSL Bundle Tool Tab -->
        <div id="tab-ssl" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-ssl" hidden>
            <div class="ssl-header">
                <h2>🔒 SSL Certificate Bundle Tool</h2>
                <p>Công cụ gộp chứng chỉ SSL tự động</p>
            </div>

            <div class="ssl-shell">
                <div id="sslModeChooser" class="ssl-choice-grid">
                    <button type="button" class="ssl-choice-card" onclick="setSSLInputMode('zip')">
                        <div class="ssl-choice-icon">📤</div>
                        <div class="ssl-choice-title">Upload ZIP</div>
                        <div class="ssl-choice-copy">Kéo thả hoặc chọn file ZIP để tự tách certificate bundle.</div>
                    </button>
                    <button type="button" class="ssl-choice-card" onclick="setSSLInputMode('folder')">
                        <div class="ssl-choice-icon">📁</div>
                        <div class="ssl-choice-title">Scan Folder</div>
                        <div class="ssl-choice-copy">Chọn thư mục chứa cert, CA bundle và private key để tự phân loại.</div>
                    </button>
                    <button type="button" class="ssl-choice-card" onclick="setSSLInputMode('paste')">
                        <div class="ssl-choice-icon">📋</div>
                        <div class="ssl-choice-title">Paste SSL Content</div>
                        <div class="ssl-choice-copy">Dán trực tiếp Private Key, Certificate và CA Bundle theo PEM multiline.</div>
                    </button>
                </div>

                <div id="sslModePanel" class="ssl-mode-panel is-hidden">
                    <div class="ssl-mode-toolbar">
                        <div class="ssl-mode-pill" id="sslModeLabel">Chọn phương thức nhập</div>
                        <button type="button" class="btn btn-secondary btn-compact" onclick="resetSSLInputMode()">↩ Chọn lại phương thức</button>
                    </div>

                    <div id="sslZipSection" class="ssl-mode-section is-hidden-mode">
                        <div class="ssl-mode-card ssl-upload-card">
                            <h3>
                                <span>📁 Upload ZIP</span>
                                <span class="ssl-detect-chip muted">ZIP only</span>
                            </h3>
                            <div class="upload-area" id="uploadArea">
                                <div class="upload-icon">📁</div>
                                <p><strong>Kéo thả file ZIP vào đây</strong></p>
                                <p class="text-muted mt-10">hoặc</p>
                                <button class="btn btn-primary mt-10" type="button" onclick="document.getElementById('fileInput').click()">
                                    Chọn file ZIP
                                </button>
                                <input type="file" id="fileInput" accept=".zip" class="is-hidden">
                            </div>
                        </div>
                    </div>

                    <div id="sslFolderSection" class="ssl-mode-section is-hidden-mode">
                        <div class="ssl-mode-card ssl-upload-card">
                            <h3>
                                <span>📂 Scan Folder</span>
                                <span class="ssl-detect-chip muted">Directory</span>
                            </h3>
                            <div class="upload-area" id="folderUploadArea">
                                <div class="upload-icon">📂</div>
                                <p><strong>Chọn thư mục chứa SSL files</strong></p>
                                <p class="text-muted mt-10">hoặc</p>
                                <button class="btn btn-primary mt-10" type="button" onclick="document.getElementById('folderInput').click()">
                                    Chọn thư mục
                                </button>
                                <input type="file" id="folderInput" webkitdirectory directory multiple class="is-hidden">
                            </div>
                            <p class="ssl-paste-help">Hệ thống sẽ đọc các file trong thư mục, phân loại certificate và CA bundle, đồng thời tự điền private key nếu tìm thấy file như private.key hoặc private.pem.</p>
                        </div>
                    </div>

                    <div id="sslPasteSection" class="ssl-mode-section is-hidden-mode">
                        <div class="ssl-mode-card">
                            <h3>
                                <span>📝 Paste SSL Content</span>
                                <span class="ssl-detect-chip">Auto detect PEM</span>
                            </h3>
                            <p>Dán theo format mẫu bên dưới. Hệ thống sẽ tự nhận diện Private Key, Cert và CA Bundle.</p>
                            <textarea id="sslPasteInput" class="ssl-paste-input" placeholder="Private Key:\n-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n\nCert:\n-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n\nCA Bundle:\n-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"></textarea>
                            <div class="ssl-paste-help">
                                CA Bundle có thể chứa nhiều block certificate liên tiếp. Nếu paste không đúng format, hệ thống sẽ báo lỗi và giữ nút xử lý ở trạng thái tắt.
                            </div>
                            <div id="sslPasteSummary" class="ssl-detect-summary"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="sslMessage" class="message"></div>

            <div class="ssl-result-area" id="sslResultArea">
                <div class="result-box">
                    <h3>
                        Certificate Bundle
                        <div class="btn-group">
                            <button class="btn btn-secondary" onclick="copySslBundlePart('cert')">📄 Copy Cert</button>
                            <button class="btn btn-secondary" onclick="copySslBundlePart('bundle')">📚 Copy Bundle</button>
                            <button class="btn btn-success" onclick="copySslBundlePart('all')">📋 Copy All</button>
                            <button class="btn btn-info" onclick="downloadBundle()">⬇️ Download</button>
                        </div>
                    </h3>
                    <textarea id="bundleOutput" readonly></textarea>
                </div>

                <div class="result-box">
                    <h3>🔑 Private Key (Optional)</h3>
                    <p class="input-note">Dán private key để tạo PEM và PFX files</p>
                    <textarea id="privateKeyInput" placeholder="-----BEGIN PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----"></textarea>
                    <div class="mt-12">
                        <button class="btn btn-primary" onclick="generatePemAndPfx()" id="generateBtn" disabled>
                            🔧 Generate PEM, PFX & ZIP Package
                        </button>
                    </div>
                </div>

                <div id="additionalResults"></div>
            </div>
        </div>

        <!-- Free SSL Tab -->
        <div id="tab-freessl" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-freessl" hidden>
            <div class="freessl-header">
                <h2>🎁 Nhận SSL Miễn Phí (ACME)</h2>
                <p>Tự động tạo CSR/Key & xác thực để cấp chứng chỉ SSL 90 ngày</p>
            </div>

            <div class="freessl-toolbar-row">
                <div class="freessl-toolbar-actions">
                    <button class="btn btn-green" onclick="freeSslNewOrder()">+ Thêm order mới</button>
                </div>
                <button id="freesslOpenSidebarBtn" class="freessl-hamburger-btn" onclick="freeSslToggleStorage(true)">☰ Danh sách SSL đã cấp</button>
            </div>

            <!-- Progress Steps -->
            <div class="freessl-steps">
                <div class="freessl-step active" id="step1">
                    <div class="step-num">1</div>
                    <span>Nhập Domain</span>
                </div>
                <div class="freessl-step" id="step2">
                    <div class="step-num">2</div>
                    <span>Xác thực</span>
                </div>
                <div class="freessl-step" id="step3">
                    <div class="step-num">3</div>
                    <span>Pre-check</span>
                </div>
                <div class="freessl-step" id="step4">
                    <div class="step-num">4</div>
                    <span>Nhận Cert</span>
                </div>
                <div class="freessl-step" id="step5">
                    <div class="step-num">5</div>
                    <span>Hoàn tất</span>
                </div>
            </div>

            <!-- Step 1: Input -->
            <div class="freessl-card" id="freesslInputCard">
                <h3>⚙️ Bước 1: Cấu hình tên miền</h3>

                <div class="field-block">
                    <label class="field-label">
                        Tên miền <span class="required-star">*</span>
                    </label>
                    <input type="text" class="freessl-input" id="freesslDomain"
                           placeholder="vd: example.com hoặc example.com, *.example.com"
                           oninput="freeSslUpdateSANsPreview()">
                    <div class="field-help">
                        <b>💡 Để cấp SSL cho wildcard, nhập cả hai: </b><code class="code-chip">example.com, *.example.com</code>
                    </div>
                </div>

                <div class="field-block tight">
                    <label class="field-label">
                        Tên miền phụ (SANs) — nhấn Enter để thêm
                    </label>
                    <div class="inline-input-row">
                        <input type="text" class="freessl-input" id="freesslSanInput"
                               placeholder="vd: www.example.com"
                               onkeydown="if(event.key==='Enter'){freeSslAddSan();event.preventDefault();}">
                        <button class="btn btn-secondary" onclick="freeSslAddSan()">+ Thêm</button>
                    </div>
                    <div class="sans-tags" id="freesslSansTags"></div>
                </div>

                <div class="field-block loose">
                    <label class="field-label">
                        Nhà cung cấp SSL <span class="required-star">*</span>
                    </label>
                    <div class="challenge-type-row">
                        <div class="challenge-type-btn selected" id="btnProvLe" onclick="freeSslSelectProvider('letsencrypt')">
                            🔒 Let's Encrypt
                            <div class="provider-caption">Miễn phí, phổ biến nhất</div>
                        </div>
                        <div class="challenge-type-btn" id="btnProvZero" onclick="freeSslSelectProvider('zerossl')">
                            🌐 ZeroSSL
                            <div class="provider-caption">Miễn phí, có dashboard quản lý</div>
                        </div>
                        <div class="challenge-type-btn" id="btnProvSslcom" onclick="freeSslSelectProvider('sslcom')">
                            🛡️ SSL.com
                            <div class="provider-caption">Yêu cầu EAB</div>
                        </div>
                    </div>
                    <div id="freesslProviderNote" class="message-info field-help">
                        🔎 <strong>Let's Encrypt:</strong> hỗ trợ wildcard + multi-domain. Nếu chỉ nhập domain gốc, hệ thống tự thêm <strong>www</strong>.
                    </div>
                </div>

                <div class="field-block loose">
                    <label class="field-label">
                        Phương thức xác thực
                    </label>
                    <div class="challenge-type-row">
                        <div class="challenge-type-btn selected" id="btnDns01" onclick="freeSslSelectChallenge('dns-01')">
                            🌐 DNS-01
                            <div class="provider-caption">Thêm TXT record vào DNS</div>
                        </div>
                        <div class="challenge-type-btn" id="btnHttp01" onclick="freeSslSelectChallenge('http-01')">
                            📁 HTTP-01 (File-based)
                            <div class="provider-caption">Upload file lên webserver</div>
                        </div>
                    </div>
                </div>


                <button class="btn btn-green" id="freesslStartBtn" onclick="freeSslStart()">
                    🚀 Bắt đầu — Tạo CSR & Gửi Order
                </button>
            </div>

            <div id="freesslStorageBackdrop" class="freessl-storage-backdrop" aria-hidden="true" onclick="freeSslToggleStorage(false)"></div>
            <aside id="freesslStorageSidebar" class="freessl-storage-sidebar" aria-label="Danh sách SSL đã lưu" aria-hidden="true">
                <div class="freessl-storage-sidebar-header">
                    <h3>🗂️ Danh sách SSL đã lưu</h3>
                    <button class="btn btn-secondary btn-compact" onclick="freeSslToggleStorage(false)">✕</button>
                </div>
                <div class="freessl-storage-sidebar-body">
                    <div class="freessl-storage-toolbar">
                        <input type="text" class="freessl-input" id="freesslStoredSearch" placeholder="Tìm domain đã lưu..." onkeydown="if(event.key==='Enter'){freeSslLoadStoredList();}">
                        <button class="btn btn-secondary" onclick="freeSslLoadStoredList()">🔄 Tải danh sách</button>
                    </div>
                    <div id="freesslStoredList" class="freessl-storage-list">
                        <div class="freessl-storage-empty">Chưa có SSL nào được lưu.</div>
                    </div>
                </div>
            </aside>

            <!-- Step 2: Show Challenges -->
            <div class="freessl-card" id="freesslChallengeCard" style="display:none;">
                <h3>📋 Bước 2: Thực hiện xác thực</h3>
                <div class="message-info mb-16">
                    ⚠️ Vui lòng thực hiện cấu hình bên dưới trước khi nhấn <strong>Check</strong>.
                    Hệ thống sẽ kiểm tra trước khi gửi yêu cầu xác thực đến nhà cung cấp ACME.
                </div>
                <div id="freesslChallengeList"></div>

                <!-- Step 3: Pre-check -->
                <div class="freessl-action-row">
                    <button class="btn btn-primary" id="freesslVerifyBtn" onclick="freeSslCheck()">
                        🔎 Bước 3: Kiểm tra xác thực (Pre-check)
                    </button>
                    <button class="btn btn-orange" id="freesslRetryBtn" style="display:none;" onclick="freeSslRetryCurrentStep()">
                        🔁 Retry bước xác thực
                    </button>
                </div>
                <div id="freesslLogBox" class="freessl-log-box" style="display:none;"></div>
                <div id="freesslCheckResults" class="mt-12"></div>
            </div>

            <!-- Step 4: Finalize -->
            <div class="freessl-card" id="freesslFinalizeCard" style="display:none;">
                <h3>🏁 Bước 4: Nhận chứng chỉ</h3>
                <div class="message-success mb-16">
                    ✅ Xác thực đã sẵn sàng! Nhấn nút bên dưới để nhà cung cấp ACME cấp chứng chỉ.
                    Quá trình có thể mất 10–60 giây.
                </div>
                <button class="btn btn-green" onclick="freeSslFinalize()" id="freesslFinalizeBtn">
                    🎁 Nhận Chứng Chỉ SSL
                </button>
            </div>

            <!-- Loading + Message (đặt phía dưới để không chen giữa form) -->
            <div class="freessl-loading" id="freesslLoading">
                <div class="spinner"></div>
                <p id="freesslLoadingText">Đang xử lý...</p>
            </div>

            <div id="freesslMessage" class="message"></div>

            <!-- Step 5: Result -->
            <div class="freessl-result-area" id="freesslResultArea">
                <div class="freessl-cert-box">
                    <h4>
                        🎉 Chứng chỉ đã được cấp thành công!
                        <button class="btn btn-green btn-download-all" onclick="freeSslDownloadAll()">
                            ⬇️ Tải Tất Cả (ZIP)
                        </button>
                    </h4>
                    <div class="cert-stack">
                        <div>
                            <label class="cert-label">
                                Certificate (cert.crt)
                                <button class="copy-btn-small" onclick="freeSslCopy('freesslCert')">📋 Copy</button>
                            </label>
                            <textarea id="freesslCert" readonly></textarea>
                        </div>
                        <div>
                            <label class="cert-label">
                                Private Key (private.key)
                                <button class="copy-btn-small" onclick="freeSslCopy('freesslPrivKey')">📋 Copy</button>
                            </label>
                            <textarea id="freesslPrivKey" readonly></textarea>
                        </div>
                        <div>
                            <label class="cert-label">
                                CA Bundle (ca-bundle.crt)
                                <button class="copy-btn-small" onclick="freeSslCopy('freesslCaBundle')">📋 Copy</button>
                            </label>
                            <textarea id="freesslCaBundle" readonly></textarea>
                        </div>
                        <div>
                            <label class="cert-label">
                                Full Chain (fullchain.pem)
                                <button class="copy-btn-small" onclick="freeSslCopy('freesslFullChain')">📋 Copy</button>
                            </label>
                            <textarea id="freesslFullChain" readonly></textarea>
                        </div>
                    </div>
                </div>
                <div class="center-reset">
                    <button class="btn btn-green" onclick="freeSslReset()">🔄 Cấp chứng chỉ mới</button>
                </div>
            </div>
        </div>

        <div id="tab-ai" class="tab-content" role="tabpanel" aria-labelledby="tabbtn-ai" hidden style="padding:0; box-shadow:none; background:transparent;">
            <div class="ai-shell">
                <aside class="ai-sidebar" id="aiSidebar">
                    <div class="ai-sidebar-header">
                        <div style="display:flex; gap:8px; align-items:center;">
                            <div class="dns-panel-title" style="margin:0; font-size:1.1rem;">💬 Chat History</div>
                            <button class="ai-prompt-btn" style="padding:4px 10px;" onclick="createNewAIChat()">+ mới</button>
                        </div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <button class="ai-prompt-btn" title="Xoá tất cả đoạn chat" onclick="clearAllAIChats()">🗑️</button>
                        </div>
                    </div>
                    <div id="aiHistoryList" class="ai-history-list"></div>
                </aside>

                <div class="ai-chat-pane">
                    <div class="ai-chat-header">
                        <div style="display:flex; flex-direction:column; gap:6px;">
                            <div class="dns-panel-title" style="display:flex; align-items:center; gap:10px; margin:0;">
                                🤖 AI Chat (Streaming)
                                <span id="aiActiveModelBadge" class="ai-badge-active" title="Model đang sử dụng">meta/llama-3.3-70b-instruct</span>
                            </div>
                            
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button class="ai-prompt-btn" type="button" onclick="deleteActiveAIChat()" title="Xoá đoạn chat hiện tại">🗑️</button>
                            <button class="ai-prompt-btn" id="aiPromptToggle" type="button" onclick="toggleAIPromptPanel()">⚙️ Cấu hình Model</button>
                        </div>
                    </div>

                    <!-- AI Settings Overlay (Hidden by default, overlays chat messages) -->
                    <div id="aiPromptPanel" class="ai-settings-overlay">
                        <!-- Row 1: Provider, Model Select, Actions -->
                        <div class="ai-provider-row">
                            <div style="display:flex; flex-direction:column; gap:6px;">
                                <label style="font-size:0.85rem; font-weight:700; color:#334155;">Nhà cung cấp:</label>
                                <select id="aiProviderSelect" class="dns-input" style="height:40px; padding:0 12px; font-size:0.9rem; border-radius:8px;" onchange="onAIProviderChange()">
                                    <option value="nvidia" selected>⚡ NVIDIA NIM</option>
                                    <option value="agnes">🤖 Agnes AI</option>
                                    <option value="custom">⚙️ Custom API</option>
                                </select>
                            </div>

                            <div style="display:flex; flex-direction:column; gap:6px; min-width:0;">
                                <label style="font-size:0.85rem; font-weight:700; color:#334155; display:flex; justify-content:space-between;">
                                    <span>Model AI (<span id="aiModelCount">Đang tải...</span>):</span>
                                </label>
                                <select id="aiModelSelect" class="dns-input" style="height:40px; padding:0 12px; font-size:0.9rem; border-radius:8px; text-overflow:ellipsis;" onchange="onAIModelSelectChange()">
                                    <option value="meta/llama-3.3-70b-instruct">meta/llama-3.3-70b-instruct</option>
                                </select>
                            </div>

                            <div style="display:flex; gap:8px; align-items:flex-end;">
                                <button type="button" class="btn btn-primary" style="height:40px; padding:0 16px; background:#4f46e5; border:none; border-radius:8px; font-weight:700; font-size:0.9rem; display:flex; align-items:center; gap:6px;" id="aiTestSpeedBtn" onclick="testAllModelsSpeed()">
                                    <span>⚡</span> Kiểm thử (Song song)
                                </button>
                                <button type="button" class="btn btn-secondary" style="height:40px; padding:0 12px; border-radius:8px; font-weight:600; display:flex; align-items:center; gap:6px;" onclick="loadAIModels(true)">
                                    <span>🔄</span> Reload
                                </button>
                            </div>
                        </div>

                        <!-- Row 2: Search Input & Speed Filters -->
                        <div class="ai-filter-row">
                            <div>
                                <input type="text" id="aiModelSearchInput" class="dns-input" style="height:38px; padding:0 12px; font-size:0.9rem; border-radius:8px; width:100%; box-sizing:border-box;" placeholder="🔍 Tìm kiếm Model..." oninput="filterAIModels()">
                            </div>

                            <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
                                <span style="font-size:0.85rem; font-weight:700; color:#64748b;">Phân loại:</span>
                                <button type="button" class="ai-filter-tab active" data-speed="all" onclick="setAISpeedFilter('all', this)">Tất cả</button>
                                <button type="button" class="ai-filter-tab" data-speed="fast" onclick="setAISpeedFilter('fast', this)">🚀 Nhanh</button>
                                <button type="button" class="ai-filter-tab" data-speed="medium" onclick="setAISpeedFilter('medium', this)">⚡ T.Bình</button>
                                <button type="button" class="ai-filter-tab" data-speed="slow" onclick="setAISpeedFilter('slow', this)">🐢 Chậm</button>
                                <button type="button" class="ai-filter-tab" data-speed="working" onclick="setAISpeedFilter('working', this)">🛡️ Hoạt động</button>
                            </div>
                        </div>

                        <!-- Row 3: Presets -->
                        <div class="ai-presets-row">
                            <span style="font-size:0.85rem; font-weight:700; color:#64748b;">Gợi ý:</span>
                            <button type="button" class="ai-model-chip" onclick="selectAIModel('meta/llama-3.3-70b-instruct')">⚡ Llama 3.3 70B</button>
                            <button type="button" class="ai-model-chip" onclick="selectAIModel('deepseek-ai/deepseek-r1')">🔥 DeepSeek R1</button>
                            <button type="button" class="ai-model-chip" onclick="selectAIModel('nvidia/llama-3.1-nemotron-70b-instruct')">🤖 Nemotron 70B</button>
                            <button type="button" class="ai-model-chip" onclick="selectAIModel('mistralai/mistral-large-2-instruct')">💨 Mistral Large 2</button>
                            <button type="button" class="ai-model-chip" onclick="selectAIModel('qwen/qwen2.5-72b-instruct')">🌟 Qwen 2.5 72B</button>
                        </div>

                        <div id="aiTestStatusProgress" style="display:none; margin-top:0px; background:#e0e7ff; color:#3730a3; padding:12px 16px; border-radius:12px; font-size:0.9rem; font-weight:600; text-align:center;">
                            ⚡ Đang kiểm thử kết nối song song...
                        </div>

                        <div id="aiCustomKeyBlock" style="display:none; margin-top:0px;">
                            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                                <input type="text" id="aiApiKeyInput" class="dns-input" style="flex:1; min-width:200px; padding:10px 12px; font-size:0.9rem; border-radius:8px;" placeholder="API Key" onchange="saveAIKeyConfig()">
                                <input type="text" id="aiApiBaseInput" class="dns-input" style="flex:1; min-width:200px; padding:10px 12px; font-size:0.9rem; border-radius:8px;" placeholder="API Base URL" onchange="saveAIKeyConfig()">
                            </div>
                        </div>

                        <hr style="border:none; border-top:1px solid #e2e8f0; margin:4px 0;" />

                        <div class="field-block" style="margin:0;">
                            <label class="field-label" style="margin-bottom:8px;">Custom prompt hệ thống</label>
                            <textarea id="aiCustomPromptInput" placeholder="Dán nội dung prompt hệ thống ở đây..." style="width:100%; min-height:80px; border:1px solid #cbd5e1; border-radius:8px; padding:10px; font:inherit; resize:vertical; box-sizing:border-box; background:#ffffff;"></textarea>
                        </div>
                        <div style="display:flex; gap:10px; justify-content:flex-end;">
                            <button class="btn btn-secondary" style="height:36px; padding:0 16px; border-radius:8px; font-size:0.9rem;" onclick="toggleAIPromptPanel(false)">Thu gọn ⬆️</button>
                            <button class="btn btn-primary" style="height:36px; padding:0 20px; border-radius:8px; font-size:0.9rem;" onclick="saveAICustomPrompt(); toggleAIPromptPanel(false);">💾 Lưu & Đóng</button>
                        </div>
                    </div>

                    <div id="aiMessagesList" class="ai-chat-messages"></div>

                    <div class="ai-composer">
                        <textarea id="aiComposerInput" placeholder="Nhập tin nhắn... (Enter để gửi, Shift+Enter để xuống dòng)" onkeydown="onAIComposerKeyDown(event)"></textarea>
                        <div id="aiAttachmentPreview" class="ai-attachment-preview" style="margin-top:0;"></div>
                        <div class="ai-compose-actions">
                            <div class="ai-compose-actions-left">
                                <label class="ai-prompt-btn" style="cursor:pointer; margin:0; font-size:0.85rem;">
                                    📎 Đính kèm
                                    <input id="aiFileInput" type="file" multiple hidden>
                                </label>
                                <button class="ai-prompt-btn" type="button" style="margin:0; font-size:0.85rem;" onclick="clearAIAttachments()">🧹 Xóa</button>
                            </div>
                            <div style="display:flex; gap:10px;">
                                <button class="btn btn-danger" type="button" id="aiStopBtn" style="display:none; border-radius:8px; padding:0 16px; height:40px; font-size:0.9rem;" onclick="stopAIStream()">🛑 Dừng</button>
                                <button class="btn btn-primary" type="button" id="aiSendBtn" style="border-radius:8px; padding:0 24px; height:40px; font-size:0.95rem; font-weight:700;" onclick="sendAIRequest(this)">🚀 Gửi</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/forge/0.10.0/forge.min.js"></script>
    <script>
        // ========== Tab Switching ==========
        const tabIds = ['dns', 'bulkdns', 'dnshistory', 'sslcheck', 'hostcheck', 'ssl', 'installssl', 'ssldecoder', 'freessl', 'ai'];

        function switchTab(tab, options = {}) {
            const nextTab = tabIds.includes(tab) ? tab : 'dns';
            const tabButtons = Array.from(document.querySelectorAll('.tab-btn[data-tab]'));
            const panels = Array.from(document.querySelectorAll('.tab-content[id^="tab-"]'));

            tabButtons.forEach(btn => {
                const isActive = btn.dataset.tab === nextTab;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
                btn.setAttribute('tabindex', isActive ? '0' : '-1');
            });

            panels.forEach(panel => {
                const isActive = panel.id === 'tab-' + nextTab;
                panel.classList.toggle('active', isActive);
                panel.hidden = !isActive;
            });

            if (options.focusTab) {
                const activeBtn = document.querySelector(`.tab-btn[data-tab="${nextTab}"]`);
                if (activeBtn) activeBtn.focus();
            }
        }

        function updateTabScrollHint() {
            const nav = document.querySelector('.tab-nav');
            if (!nav) return;
            const scrollable = nav.scrollWidth > nav.clientWidth + 4;
            nav.classList.toggle('is-scrollable', scrollable);
        }

        function initTabNavigationA11y() {
            const tabButtons = Array.from(document.querySelectorAll('.tab-btn[data-tab]'));
            if (tabButtons.length === 0) return;

            tabButtons.forEach((btn, index) => {
                btn.addEventListener('keydown', (event) => {
                    const key = event.key;
                    if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(key)) return;
                    event.preventDefault();

                    let nextIndex = index;
                    if (key === 'ArrowRight') nextIndex = (index + 1) % tabButtons.length;
                    if (key === 'ArrowLeft') nextIndex = (index - 1 + tabButtons.length) % tabButtons.length;
                    if (key === 'Home') nextIndex = 0;
                    if (key === 'End') nextIndex = tabButtons.length - 1;

                    const nextTab = tabButtons[nextIndex];
                    if (nextTab && nextTab.dataset.tab) {
                        switchTab(nextTab.dataset.tab, { focusTab: true });
                    }
                });
            });

            const nav = document.querySelector('.tab-nav');
            if (nav) nav.addEventListener('scroll', updateTabScrollHint, { passive: true });
            window.addEventListener('resize', updateTabScrollHint);
            updateTabScrollHint();
        }

        function clearMessage(elementId) {
            const box = document.getElementById(elementId);
            if (!box) return;
            box.textContent = '';
        }

        let aiMode = 'chat';
        let aiAttachedFiles = [];
        let aiChats = [];
        let aiActiveChatId = null;
        let aiCustomPrompt = '';
        let aiProvider = localStorage.getItem('ai_provider') || 'nvidia';
        let aiSelectedModel = localStorage.getItem('ai_selected_model') || 'meta/llama-3.3-70b-instruct';
        let aiApiKey = localStorage.getItem('ai_api_key') || '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';
        let aiApiBase = localStorage.getItem('ai_api_base') || 'https://integrate.api.nvidia.com/v1';
        let aiAllModelsList = [];
        let aiTestedSpeedMap = {};
        let aiSpeedFilter = 'all';
        let activeAIAbortController = null;

        function escapeHtml(text) { var div = document.createElement('div'); div.textContent = text; return div.innerHTML; }

        function getDefaultAIChat() {
            return {
                id: 'chat-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8),
                title: 'Chat mới',
                createdAt: new Date().toISOString(),
                messages: []
            };
        }

        function saveAIState() {
            localStorage.setItem('ai_chat_history', JSON.stringify(aiChats));
            localStorage.setItem('ai_active_chat_id', aiActiveChatId || '');
            localStorage.setItem('ai_custom_prompt', aiCustomPrompt);
            localStorage.setItem('ai_provider', aiProvider);
            localStorage.setItem('ai_selected_model', aiSelectedModel);
            localStorage.setItem('ai_api_key', aiApiKey);
            localStorage.setItem('ai_api_base', aiApiBase);
        }

        function loadAIState() {
            try {
                const storedChats = JSON.parse(localStorage.getItem('ai_chat_history') || '[]');
                aiChats = Array.isArray(storedChats) ? storedChats : [];
            } catch (err) {
                aiChats = [];
            }
            aiCustomPrompt = localStorage.getItem('ai_custom_prompt') || 'Bạn là trợ lý AI mạnh mẽ, ngắn gọn, rõ ràng và hữu ích bằng tiếng Việt.';
            aiActiveChatId = localStorage.getItem('ai_active_chat_id') || null;
            aiProvider = localStorage.getItem('ai_provider') || 'nvidia';
            aiSelectedModel = localStorage.getItem('ai_selected_model') || 'meta/llama-3.3-70b-instruct';
            aiApiKey = localStorage.getItem('ai_api_key') || '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';
            aiApiBase = localStorage.getItem('ai_api_base') || 'https://integrate.api.nvidia.com/v1';

            if (!aiChats.length) {
                createNewAIChat(false);
            } else if (!aiChats.some(chat => chat.id === aiActiveChatId)) {
                aiActiveChatId = aiChats[0].id;
            }
            saveAIState();

            const providerSelect = document.getElementById('aiProviderSelect');
            if (providerSelect) providerSelect.value = aiProvider;

            const keyInput = document.getElementById('aiApiKeyInput');
            if (keyInput) keyInput.value = aiApiKey;

            const baseInput = document.getElementById('aiApiBaseInput');
            if (baseInput) baseInput.value = aiApiBase;

            updateActiveModelBadge();
            toggleCustomKeyBlock();
            loadAIModels();
        }

        function updateActiveModelBadge() {
            const badge = document.getElementById('aiActiveModelBadge');
            if (badge) {
                const shortName = aiSelectedModel.split('/').pop() || aiSelectedModel;
                const testInfo = aiTestedSpeedMap[aiSelectedModel];
                if (testInfo && testInfo.working) {
                    badge.textContent = `${shortName} (${testInfo.latency_ms}ms)`;
                } else {
                    badge.textContent = shortName;
                }
            }
        }

        function toggleCustomKeyBlock() {
            const block = document.getElementById('aiCustomKeyBlock');
            if (block) {
                block.style.display = (aiProvider === 'custom') ? 'block' : 'none';
            }
        }

        function toggleAISidebar() {
            const sidebar = document.getElementById('aiSidebar');
            if (sidebar) sidebar.classList.toggle('show');
        }

        function onAIProviderChange() {
            const providerSelect = document.getElementById('aiProviderSelect');
            if (providerSelect) aiProvider = providerSelect.value;
            toggleCustomKeyBlock();
            saveAIState();
            loadAIModels(true);
        }

        function saveAIKeyConfig() {
            const keyInput = document.getElementById('aiApiKeyInput');
            if (keyInput) aiApiKey = (keyInput.value || '').trim();
            const baseInput = document.getElementById('aiApiBaseInput');
            if (baseInput) aiApiBase = (baseInput.value || '').trim();
            saveAIState();
            loadAIModels(true);
        }

        async function loadAIModels(forceRefresh = false) {
            const countEl = document.getElementById('aiModelCount');
            if (countEl) countEl.textContent = 'Đang tải...';

            try {
                const url = `/api/ai/models?provider=${encodeURIComponent(aiProvider)}&api_key=${encodeURIComponent(aiApiKey)}&api_base=${encodeURIComponent(aiApiBase)}${forceRefresh ? '&refresh=1' : ''}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!res.ok || data.error) {
                    throw new Error(data.error || 'Lỗi tải danh sách models');
                }

                aiAllModelsList = data.models || [];
                renderAIModelSelect();

                if (countEl) {
                    const providerName = aiProvider === 'nvidia' ? 'NVIDIA NIM' : (aiProvider === 'agnes' ? 'Agnes AI' : 'Custom');
                    countEl.textContent = `${aiAllModelsList.length} models (${providerName})`;
                }
            } catch (err) {
                console.error('Error loading AI models:', err);
                if (countEl) countEl.textContent = 'Lỗi tải models';
            }
        }

        async function testAllModelsSpeed() {
            const statusBox = document.getElementById('aiTestStatusProgress');
            const testBtn = document.getElementById('aiTestSpeedBtn');
            if (statusBox) {
                statusBox.style.display = 'block';
                statusBox.style.background = '#e0e7ff';
                statusBox.style.color = '#3730a3';
                statusBox.textContent = '⚡ Đang khảo sát kết nối song song tới 100+ models... Vui lòng chờ vài giây!';
            }
            if (testBtn) testBtn.disabled = true;

            try {
                const formData = new FormData();
                formData.append('provider', aiProvider);
                formData.append('api_key', aiApiKey);
                formData.append('api_base', aiApiBase);

                const res = await fetch('/api/ai/test-models', { method: 'POST', body: formData });
                const data = await res.json();

                if (!res.ok || data.error) throw new Error(data.error || 'Lỗi khảo sát tốc độ');

                aiTestedSpeedMap = {};
                (data.results || []).forEach(r => {
                    aiTestedSpeedMap[r.id] = r;
                });

                renderAIModelSelect();

                if (statusBox) {
                    statusBox.style.background = '#dcfce7';
                    statusBox.style.color = '#15803d';
                    statusBox.textContent = `✅ Đã kiểm thử song song ${data.total_tested} models: ${data.working_count} models hoạt động 200 OK!`;
                    setTimeout(() => { statusBox.style.display = 'none'; }, 6000);
                }

            } catch (err) {
                if (statusBox) {
                    statusBox.style.background = '#fee2e2';
                    statusBox.style.color = '#b91c1c';
                    statusBox.textContent = `❌ Lỗi kiểm thử: ${err.message}`;
                }
            } finally {
                if (testBtn) testBtn.disabled = false;
            }
        }

        function setAISpeedFilter(filterType, btnEl) {
            aiSpeedFilter = filterType;
            const tabs = document.querySelectorAll('.ai-filter-tab');
            tabs.forEach(t => t.classList.remove('active'));
            if (btnEl) btnEl.classList.add('active');
            renderAIModelSelect();
        }

        function renderAIModelSelect() {
            const selectEl = document.getElementById('aiModelSelect');
            const searchInput = document.getElementById('aiModelSearchInput');
            if (!selectEl) return;

            const filterText = (searchInput ? searchInput.value : '').toLowerCase().trim();

            let filtered = aiAllModelsList.filter(m => {
                const matchSearch = !filterText || m.toLowerCase().includes(filterText);
                if (!matchSearch) return false;

                const testInfo = aiTestedSpeedMap[m];
                if (aiSpeedFilter === 'fast') return testInfo && testInfo.speed === 'fast';
                if (aiSpeedFilter === 'medium') return testInfo && testInfo.speed === 'medium';
                if (aiSpeedFilter === 'slow') return testInfo && testInfo.speed === 'slow';
                if (aiSpeedFilter === 'working') return testInfo ? testInfo.working : true;
                return true;
            });

            selectEl.innerHTML = '';
            if (filtered.length === 0) {
                selectEl.innerHTML = '<option value="">Không có model phù hợp</option>';
                return;
            }

            filtered.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m;
                const testInfo = aiTestedSpeedMap[m];
                if (testInfo) {
                    opt.textContent = `${m} (${testInfo.label} • ${testInfo.latency_ms}ms)`;
                } else {
                    opt.textContent = m;
                }
                if (m === aiSelectedModel) opt.selected = true;
                selectEl.appendChild(opt);
            });

            if (!filtered.includes(aiSelectedModel) && filtered.length > 0) {
                aiSelectedModel = filtered[0];
                selectEl.value = aiSelectedModel;
                saveAIState();
            }
            updateActiveModelBadge();
            updateActiveModelChips();
        }

        function filterAIModels() {
            renderAIModelSelect();
        }

        function onAIModelSelectChange() {
            const selectEl = document.getElementById('aiModelSelect');
            if (selectEl && selectEl.value) {
                aiSelectedModel = selectEl.value;
                saveAIState();
                updateActiveModelBadge();
                updateActiveModelChips();
            }
        }

        function selectAIModel(modelId) {
            aiSelectedModel = modelId;
            saveAIState();

            const selectEl = document.getElementById('aiModelSelect');
            if (selectEl) {
                if (!aiAllModelsList.includes(modelId)) {
                    aiAllModelsList.unshift(modelId);
                    renderAIModelSelect();
                }
                selectEl.value = modelId;
            }
            updateActiveModelBadge();
            updateActiveModelChips();
        }

        function updateActiveModelChips() {
            const chips = document.querySelectorAll('.ai-model-chip');
            chips.forEach(chip => {
                const onclickStr = chip.getAttribute('onclick') || '';
                const isActive = onclickStr.includes(`'${aiSelectedModel}'`);
                chip.classList.toggle('active', isActive);
            });
        }

        function stopAIStream() {
            if (activeAIAbortController) {
                activeAIAbortController.abort();
                activeAIAbortController = null;
            }
            const stopBtn = document.getElementById('aiStopBtn');
            const sendBtn = document.getElementById('aiSendBtn');
            if (stopBtn) stopBtn.style.display = 'none';
            if (sendBtn) sendBtn.disabled = false;
            setAIMessage('info', '⏹️ Đã ngắt kết nối theo yêu cầu.');
        }

        function onAIComposerKeyDown(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendAIRequest(document.getElementById('aiSendBtn'));
            }
        }

        function createNewAIChat(save = true) {
            const chat = getDefaultAIChat();
            aiChats.unshift(chat);
            aiActiveChatId = chat.id;
            if (save) saveAIState();
            renderAIChatList();
            renderAIChatMessages();
        }

        function deleteActiveAIChat() {
            if (!aiChats.length) return;

            const currentIndex = aiChats.findIndex(chat => chat.id === aiActiveChatId);
            const targetIndex = currentIndex >= 0 ? currentIndex : 0;
            const targetChat = aiChats[targetIndex];
            if (!targetChat) return;

            const confirmMessage = targetChat.messages && targetChat.messages.length
                ? 'Bạn có chắc muốn xoá toàn bộ đoạn chat này? Tất cả nội dung trong đoạn chat sẽ bị mất.'
                : 'Bạn có chắc muốn xoá đoạn chat trống này?';
            if (!window.confirm(confirmMessage)) return;

            aiChats.splice(targetIndex, 1);
            if (!aiChats.length) {
                createNewAIChat(false);
                return;
            }

            const nextIndex = Math.min(targetIndex, aiChats.length - 1);
            aiActiveChatId = aiChats[nextIndex].id;
            saveAIState();
            renderAIChatList();
            renderAIChatMessages();
            setAIMessage('info', '🗑️ Đã xoá đoạn chat hiện tại.');
        }

        function clearAllAIChats() {
            if (!aiChats.length) return;
            if (!window.confirm('Bạn có chắc muốn xoá tất cả các đoạn chat? Hành động này không thể hoàn tác.')) return;
            aiChats = [];
            createNewAIChat(false);
            saveAIState();
            renderAIChatList();
            renderAIChatMessages();
            setAIMessage('info', '🗑️ Đã xoá tất cả đoạn chat.');
        }

        function setAIMode(mode) {
            aiMode = 'chat';
        }

        function toggleAIPromptPanel(force = null) {
            const panel = document.getElementById('aiPromptPanel');
            const toggle = document.getElementById('aiPromptToggle');
            const shouldShow = force !== null ? force : !panel.classList.contains('show');
            panel.classList.toggle('show', shouldShow);
            if (toggle) toggle.classList.toggle('active', shouldShow);
            if (shouldShow) {
                const input = document.getElementById('aiCustomPromptInput');
                if (input) input.value = aiCustomPrompt;
                input?.focus();
            }
        }

        function saveAICustomPrompt() {
            const input = document.getElementById('aiCustomPromptInput');
            aiCustomPrompt = (input ? input.value : '').trim() || 'Bạn là trợ lý AI mạnh mẽ, ngắn gọn, rõ ràng và hữu ích bằng tiếng Việt.';
            saveAIState();
            setAIMessage('success', '✅ Custom prompt đã được lưu.');
        }

        function renderAIChatList() {
            const container = document.getElementById('aiHistoryList');
            if (!container) return;
            container.innerHTML = '';
            if (!aiChats.length) {
                container.innerHTML = '<div class="ai-empty">Chưa có cuộc trò chuyện nào.</div>';
                return;
            }
            aiChats.forEach(chat => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'ai-history-item' + (chat.id === aiActiveChatId ? ' active' : '');
                item.innerHTML = `<div class="ai-history-title">${escapeHtml(chat.title || 'Chat mới')}</div><div class="ai-history-meta">${escapeHtml(new Date(chat.createdAt || Date.now()).toLocaleString('vi-VN'))}</div>`;
                item.addEventListener('click', () => {
                    aiActiveChatId = chat.id;
                    saveAIState();
                    renderAIChatList();
                    renderAIChatMessages();
                });
                container.appendChild(item);
            });
        }

        function buildAttachmentMarkup(attachments) {
            if (!attachments || !attachments.length) return '';
            const items = attachments.map(att => {
                if (att.dataUrl && att.type && att.type.startsWith('image/')) {
                    return `<div class="ai-attachment-item"><img src="${att.dataUrl}" alt="${escapeHtml(att.name || 'image')}"></div>`;
                }
                return `<div class="ai-attachment-item">📎 ${escapeHtml(att.name || 'file')}</div>`;
            }).join('');
            return `<div class="ai-attachment-preview">${items}</div>`;
        }

        function renderAIChatMessages() {
            const container = document.getElementById('aiMessagesList');
            if (!container) return;
            const chat = aiChats.find(item => item.id === aiActiveChatId) || aiChats[0];
            if (!chat || !chat.messages.length) {
                container.innerHTML = '<div class="ai-empty">Hãy bắt đầu một cuộc trò chuyện mới.</div>';
                return;
            }
            const frag = document.createDocumentFragment();
            const modelShort = escapeHtml(aiSelectedModel.split('/').pop());
            chat.messages.forEach(message => {
                const bubble = document.createElement('div');
                bubble.className = `ai-chat-bubble ${message.role}`;
                const roleLabel = message.role === 'user' ? 'Bạn' : `AI (${modelShort})`;
                const timeStr = escapeHtml(new Date(message.timestamp || Date.now()).toLocaleTimeString('vi-VN'));
                bubble.innerHTML = `<div class="meta">${roleLabel} • ${timeStr}</div>${escapeHtml(message.content || '')}`;
                if (message.attachments && message.attachments.length) {
                    bubble.innerHTML += buildAttachmentMarkup(message.attachments);
                }
                if (message.mode === 'image' && message.resultData) {
                    const result = message.resultData || {};
                    const imageUrl = result?.data?.[0]?.b64_json ? `data:image/png;base64,${result.data[0].b64_json}` : (result?.data?.[0]?.url || '');
                    bubble.innerHTML += imageUrl ? `<img class="ai-render-image" src="${imageUrl}" alt="Generated image">` : '<div>Không có ảnh để hiển thị.</div>';
                }
                if (message.mode === 'video' && message.resultData) {
                    const result = message.resultData || {};
                    const videoUrl = result?.data?.[0]?.url || '';
                    bubble.innerHTML += videoUrl ? `<video class="ai-render-image" controls src="${videoUrl}"></video>` : '<div>Không có video để hiển thị.</div>';
                }
                frag.appendChild(bubble);
            });
            container.innerHTML = '';
            container.appendChild(frag);
            requestAnimationFrame(() => { container.scrollTop = container.scrollHeight; });
        }

        function setAIMessage(type, text) {
            const box = document.getElementById('aiMessageBox');
            if (!box) return;
            box.innerHTML = '';
            if (!text) return;
            const row = document.createElement('div');
            row.className = 'message-' + type;
            row.textContent = text;
            box.appendChild(row);
        }

        function renderAIStreamingPulse(lastBubble) {
            if (!lastBubble) return;
            lastBubble.classList.add('streaming');
        }

        function attachmentToSerializable(file) {
            return new Promise((resolve) => {
                const item = {
                    name: file.name,
                    type: file.type || 'application/octet-stream',
                    dataUrl: '',
                    file: file
                };
                if (file.type && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = () => {
                        item.dataUrl = reader.result;
                        resolve(item);
                    };
                    reader.onerror = () => resolve(item);
                    reader.readAsDataURL(file);
                } else {
                    resolve(item);
                }
            });
        }

        async function addAIAttachments(files) {
            const items = [];
            for (const file of files) {
                if (!file) continue;
                items.push(await attachmentToSerializable(file));
            }
            aiAttachedFiles = [...aiAttachedFiles, ...items];
            renderAIAttachmentPreview();
        }

        function renderAIAttachmentPreview() {
            const container = document.getElementById('aiAttachmentPreview');
            if (!container) return;
            if (!aiAttachedFiles.length) {
                container.innerHTML = '';
                return;
            }
            container.innerHTML = aiAttachedFiles.map(att => {
                if (att.dataUrl && att.type && att.type.startsWith('image/')) {
                    return `<div class="ai-attachment-item"><img src="${att.dataUrl}" alt="${escapeHtml(att.name || 'image')}"></div>`;
                }
                return `<div class="ai-attachment-item">📎 ${escapeHtml(att.name || 'file')}</div>`;
            }).join('');
        }

        function clearAIAttachments() {
            aiAttachedFiles = [];
            renderAIAttachmentPreview();
        }

        async function sendAIRequest(button) {
            const composer = document.getElementById('aiComposerInput');
            const prompt = (composer ? composer.value : '').trim();
            if (!prompt && aiAttachedFiles.length === 0) {
                setAIMessage('error', 'Vui lòng nhập prompt hoặc đính kèm ít nhất một file.');
                return;
            }

            const stopBtn = document.getElementById('aiStopBtn');
            if (button) button.disabled = true;
            if (stopBtn) stopBtn.style.display = 'inline-block';

            let activeChat = aiChats.find(item => item.id === aiActiveChatId);
            if (!activeChat) {
                createNewAIChat(false);
                activeChat = aiChats[0];
            }

            const userMessage = {
                role: 'user',
                content: prompt || 'Đính kèm file',
                attachments: aiAttachedFiles,
                timestamp: new Date().toISOString(),
                mode: aiMode
            };
            activeChat.messages.push(userMessage);
            if (activeChat.title === 'Chat mới' && prompt) {
                activeChat.title = prompt.slice(0, 36) || 'Chat mới';
            }

            const assistantMessage = {
                role: 'assistant',
                content: '',
                timestamp: new Date().toISOString(),
                mode: aiMode,
                resultData: null
            };
            activeChat.messages.push(assistantMessage);

            renderAIChatList();
            renderAIChatMessages();

            if (composer) composer.value = '';
            const currentAttachments = [...aiAttachedFiles];
            clearAIAttachments();

            const formData = new FormData();
            formData.append('mode', aiMode);
            formData.append('prompt', prompt);
            formData.append('system_prompt', aiCustomPrompt);
            formData.append('model', aiSelectedModel || 'meta/llama-3.3-70b-instruct');
            formData.append('provider', aiProvider);
            formData.append('api_key', aiApiKey);
            formData.append('api_base', aiApiBase);
            formData.append('history', JSON.stringify(activeChat.messages.slice(-8, -1)));
            currentAttachments.forEach(item => {
                if (item && item.file) {
                    formData.append('files', item.file);
                }
            });

            activeAIAbortController = new AbortController();

            // Get reference to the last bubble for direct DOM updates (no re-render)
            const container = document.getElementById('aiMessagesList');
            const lastBubble = container ? container.lastElementChild : null;
            renderAIStreamingPulse(lastBubble);
            const modelShortName = aiSelectedModel.split('/').pop();
            const metaPrefix = `AI (${escapeHtml(modelShortName)}) • `;

            // Debounced save — only saves once every 2s during streaming
            let _saveTimer = null;
            const debouncedSave = () => {
                if (_saveTimer) return;
                _saveTimer = setTimeout(() => { saveAIState(); _saveTimer = null; }, 2000);
            };

            // RAF-batched UI update — avoids multiple reflows per frame
            let _rafPending = false;
            let _latestText = '';
            const scheduleUIUpdate = (text) => {
                _latestText = text;
                if (_rafPending) return;
                _rafPending = true;
                requestAnimationFrame(() => {
                    _rafPending = false;
                    if (lastBubble && lastBubble.classList.contains('assistant')) {
                        const timeStr = new Date().toLocaleTimeString('vi-VN');
                        lastBubble.innerHTML = `<div class="meta">${metaPrefix}${escapeHtml(timeStr)}</div>${escapeHtml(_latestText)}`;
                        if (container) container.scrollTop = container.scrollHeight;
                    }
                });
            };

            try {
                const response = await fetch('/api/ai/stream', {
                    method: 'POST',
                    body: formData,
                    signal: activeAIAbortController.signal
                });

                if (!response.ok) {
                    let errText = '';
                    try {
                        const errJson = await response.json();
                        errText = errJson.error || '';
                    } catch(e) {
                        errText = `HTTP Error ${response.status}`;
                    }
                    throw new Error(errText || 'Khởi tạo luồng stream thất bại.');
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let accumulatedText = '';
                let buffer = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop() || '';

                    let chunkUpdated = false;
                    for (const line of lines) {
                        const trimmed = line.trim();
                        if (!trimmed || trimmed.startsWith(':')) continue;
                        if (trimmed === 'data: [DONE]') break;

                        if (trimmed.startsWith('data: ')) {
                            try {
                                const parsed = JSON.parse(trimmed.slice(6));
                                const choice = parsed.choices?.[0];
                                if (choice?.delta) {
                                    // Ignore reasoning_content entirely to keep responses concise
                                    const chunk = choice.delta.content || '';
                                    if (chunk) {
                                        accumulatedText += chunk;
                                        chunkUpdated = true;
                                    }
                                }
                            } catch (e) {
                                // Skip non-json lines
                            }
                        }
                    }

                    if (chunkUpdated) {
                        // Strip closed <think> blocks and any currently open <think> block at the end
                        let cleanedText = accumulatedText.replace(/<think>[\s\S]*?<\/think>\n*/gi, '').replace(/<think>[\s\S]*$/i, '');
                        // Trim leading newlines if the thinking block was at the very beginning
                        cleanedText = cleanedText.replace(/^\s+/, '');
                        
                        assistantMessage.content = cleanedText;
                        scheduleUIUpdate(cleanedText);
                        debouncedSave();
                    }
                }

                if (!accumulatedText) {
                    assistantMessage.content = 'Đã hoàn thành.';
                }

                // Final save and render
                if (_saveTimer) { clearTimeout(_saveTimer); _saveTimer = null; }
                if (lastBubble) lastBubble.classList.remove('streaming');
                saveAIState();
                renderAIChatMessages();
                setAIMessage('success', '⚡ Phản hồi hoàn tất!');

            } catch (err) {
                if (err.name === 'AbortError') {
                    assistantMessage.content += '\n\n[⏹️ Đã ngắt kết nối theo yêu cầu]';
                    setAIMessage('info', '⏹️ Đã dừng kết nối.');
                } else {
                    assistantMessage.content = '❌ ' + err.message;
                    setAIMessage('error', '❌ ' + err.message);
                }
                if (_saveTimer) { clearTimeout(_saveTimer); _saveTimer = null; }
                if (lastBubble) lastBubble.classList.remove('streaming');
                saveAIState();
                renderAIChatMessages();
            } finally {
                activeAIAbortController = null;
                if (button) button.disabled = false;
                if (stopBtn) stopBtn.style.display = 'none';
            }
        }

        document.getElementById('aiFileInput')?.addEventListener('change', async (event) => {
            const files = Array.from(event.target.files || []);
            if (files.length) await addAIAttachments(files);
            event.target.value = '';
        });

        document.getElementById('aiComposerInput')?.addEventListener('paste', async (event) => {
            const items = Array.from(event.clipboardData?.items || []);
            const imageItems = items.filter(item => item.type && item.type.startsWith('image/'));
            if (imageItems.length) {
                event.preventDefault();
                const files = imageItems.map(item => item.getAsFile()).filter(Boolean);
                if (files.length) await addAIAttachments(files);
            }
        });

        document.getElementById('aiComposerInput')?.addEventListener('drop', async (event) => {
            event.preventDefault();
            const files = Array.from(event.dataTransfer?.files || []);
            if (files.length) await addAIAttachments(files);
        });

        document.getElementById('aiComposerInput')?.addEventListener('dragover', (event) => {
            event.preventDefault();
        });

        if (window.lucide) {
            window.lucide.createIcons();
        }

        function setMessage(elementId, type, text) {
            const box = document.getElementById(elementId);
            if (!box) return;
            box.textContent = '';
            if (!text) return;
            const row = document.createElement('div');
            row.className = 'message-' + type;
            row.textContent = text;
            box.appendChild(row);
        }

        function formatCertDate(value) {
            if (!value) return '-';
            const dt = new Date(value);
            if (Number.isNaN(dt.getTime())) return value;
            const day = String(dt.getDate()).padStart(2, '0');
            const month = String(dt.getMonth() + 1).padStart(2, '0');
            const year = dt.getFullYear();
            return `${day}/${month}/${year}`;
        }
        
        // ========== SSL Check ==========
        async function checkSSL() {
            const domain = document.getElementById('sslDomainInput').value.trim();
            if (!domain) { alert('Vui lòng nhập tên miền'); return; }

            document.getElementById('sslLoading').classList.add('show');
            document.getElementById('sslCheckResults').classList.remove('show');
            clearMessage('sslCheckMessage');

            try {
                const response = await fetch('/api/check-ssl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domain: domain })
                });
                const data = await response.json();

                const hasCertDates = Boolean(data.valid_from || data.valid_to);
                if (data.error && !hasCertDates) {
                    setMessage('sslCheckMessage', 'error', '❌ ' + data.error);
                    document.getElementById('sslCheckResults').classList.remove('show');
                } else {
                    renderSSLResults(data);
                    if (data.error) {
                        setMessage('sslCheckMessage', 'info', 'ℹ️ ' + data.error);
                    }
                }
            } catch (err) {
                setMessage('sslCheckMessage', 'error', '❌ Lỗi kết nối: ' + err.message);
            } finally {
                document.getElementById('sslLoading').classList.remove('show');
            }
        }

        function renderSSLResults(data) {
            // Status
            const statusEl = document.getElementById('sslStatus');
            if (data.valid) {
                statusEl.innerHTML = '<span class="ssl-status-badge valid">✓ Hợp lệ</span>';
            } else {
                statusEl.innerHTML = '<span class="ssl-status-badge invalid">✗ Không hợp lệ</span>';
            }
            
            // Days remaining with color coding
            const daysEl = document.getElementById('sslDaysRemaining');
            const days = data.days_remaining;
            daysEl.textContent = days !== null ? days : '-';
            daysEl.className = 'card-value large';
            if (days !== null) {
                if (days > 30) daysEl.classList.add('success');
                else if (days > 7) daysEl.classList.add('warning');
                else daysEl.classList.add('error');
            }
            
            // Dates
            document.getElementById('sslValidFrom').textContent = formatCertDate(data.valid_from);
            document.getElementById('sslValidTo').textContent = formatCertDate(data.valid_to);
            
            // Issuer
            document.getElementById('sslIssuer').textContent = data.issuer || '-';
            document.getElementById('sslIssuerOrg').textContent = data.issuer_org ? `Tổ chức: ${data.issuer_org}` : '';
            
            // Subject
            document.getElementById('sslSubject').textContent = data.subject || '-';
            document.getElementById('sslSubjectOrg').textContent = data.subject_org ? `Tổ chức: ${data.subject_org}` : '';

            // Redirect diagnostics
            const finalHost = data.final_host || '';
            const finalUrl = data.final_url || '';
            document.getElementById('sslRedirectFinal').textContent = finalHost
                ? `Final host: ${finalHost}${finalUrl ? ' (' + finalUrl + ')' : ''}`
                : 'Không phát hiện redirect hoặc không truy vấn được';

            const chain = Array.isArray(data.redirect_chain) ? data.redirect_chain : [];
            document.getElementById('sslRedirectChain').textContent = chain.length > 1
                ? 'Chain: ' + chain.join(' -> ')
                : 'Chain: -';
            
            // SAN
            const sanEl = document.getElementById('sslSAN');
            sanEl.textContent = '';
            if (data.subject_alt_names && data.subject_alt_names.length > 0) {
                data.subject_alt_names.forEach(san => {
                    const tag = document.createElement('span');
                    tag.className = 'san-item';
                    tag.textContent = san;
                    sanEl.appendChild(tag);
                });
            } else {
                const empty = document.createElement('span');
                empty.className = 'text-muted';
                empty.textContent = 'Không có SAN';
                sanEl.appendChild(empty);
            }
            
            // Serial & Version
            document.getElementById('sslSerial').textContent = data.serial_number || '-';
            document.getElementById('sslVersion').textContent = data.version ? `v${data.version}` : '-';
            
            document.getElementById('sslCheckResults').classList.add('show');
        }
        
        // ========== Host Check ==========
        async function checkHost() {
            const host = document.getElementById('hostInput').value.trim();
            if (!host) { alert('Vui lòng nhập IP hoặc Domain'); return; }

            document.getElementById('hostLoading').classList.add('show');
            document.getElementById('hostCheckResults').classList.remove('show');
            clearMessage('hostCheckMessage');

            try {
                const response = await fetch('/api/check-host', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ host: host })
                });
                const data = await response.json();

                if (data.error && !data.ip) {
                    setMessage('hostCheckMessage', 'error', '❌ ' + data.error);
                } else {
                    renderHostResults(data);
                    if (data.error) {
                        setMessage('hostCheckMessage', 'info', 'ℹ️ ' + data.error);
                    }
                }
            } catch (err) {
                setMessage('hostCheckMessage', 'error', '❌ Lỗi kết nối: ' + err.message);
            } finally {
                document.getElementById('hostLoading').classList.remove('show');
            }
        }

        function renderHostResults(data) {
            document.getElementById('hostIP').textContent = data.ip || '-';
            document.getElementById('hostHostname').textContent = data.hostname || '-';
            document.getElementById('hostProvider').textContent = data.provider || '-';
            document.getElementById('hostOrg').textContent = data.org ? `Organization: ${data.org}` : '';
            document.getElementById('hostASN').textContent = data.asn || '-';
            document.getElementById('hostReverseDNS').textContent = data.reverse_dns || '-';
            
            // Location
            const locEl = document.getElementById('hostLocation');
            locEl.textContent = '';
            if (data.city || data.country) {
                const parts = [data.city, data.region, data.country].filter(Boolean);
                const badge = document.createElement('span');
                badge.className = 'location-badge';
                badge.textContent = '📍 ' + parts.join(', ');
                locEl.appendChild(badge);
            } else {
                locEl.textContent = '-';
            }
            
            document.getElementById('hostCheckResults').classList.add('show');
        }
        
        // ========== DNS Checker ==========
        let dnsViewMode = localStorage.getItem('dns_view_mode') || 'card';
        let dnsMode = localStorage.getItem('dns_mode') || 'detail';

        function setDnsMode(mode) {
            dnsMode = mode === 'basic' ? 'basic' : 'detail';
            localStorage.setItem('dns_mode', dnsMode);
            // update any toggle buttons (inline and header versions)
            const ids = [
                ['dnsModeDetailBtn', 'dnsModeBasicBtn'],
                ['dnsModeDetailBtnInline', 'dnsModeBasicBtnInline']
            ];
            ids.forEach(pair => {
                const detailBtn = document.getElementById(pair[0]);
                const basicBtn = document.getElementById(pair[1]);
                if (detailBtn) detailBtn.classList.toggle('active', dnsMode === 'detail');
                if (basicBtn) basicBtn.classList.toggle('active', dnsMode === 'basic');
            });

            // show/hide record type checkboxes
            const recordTypesEl = document.getElementById('recordTypes');
            if (recordTypesEl) {
                recordTypesEl.style.display = dnsMode === 'basic' ? 'none' : '';
            }
        }

        // initialize UI to stored mode
        setDnsMode(dnsMode);

        function setDnsView(mode) {
            dnsViewMode = mode === 'compact' ? 'compact' : 'card';
            localStorage.setItem('dns_view_mode', dnsViewMode);

            const records = document.getElementById('dnsRecords');
            if (records) {
                records.classList.toggle('compact-view', dnsViewMode === 'compact');
            }

            const cardBtn = document.getElementById('dnsViewCardBtn');
            const compactBtn = document.getElementById('dnsViewCompactBtn');
            if (cardBtn) cardBtn.classList.toggle('active', dnsViewMode === 'card');
            if (compactBtn) compactBtn.classList.toggle('active', dnsViewMode === 'compact');
        }

        async function checkDNS() {
            var domain = document.getElementById('domainInput').value.trim();
            if (!domain) { alert('Vui lòng nhập tên miền'); return; }

            var recordTypes = [];
            document.querySelectorAll('#recordTypes input:checked').forEach(cb => recordTypes.push(cb.value));
            // If basic mode is active, override to use a compact set: A, TXT, MX, SOA
            if (dnsMode === 'basic') {
                recordTypes = ['A','TXT','MX','SOA','NS'];
            }
            if (recordTypes.length === 0) { alert('Vui lòng chọn ít nhất 1 loại record'); return; }

            document.getElementById('loading').classList.add('show');
            document.getElementById('results').classList.remove('show');

            try {
                let endpoint = '/api/check-dns';
                let body = { domain: domain, record_types: recordTypes };
                if (dnsMode === 'basic') {
                    endpoint = '/api/check-dns-basic';
                    // send only requested types (basic supports subset)
                    body = { domain: domain, record_types: recordTypes };
                }

                var dnsPromise = fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                
                if (dnsMode === 'basic') {
                    checkWhois(domain);
                }

                var response = await dnsPromise;
                var data = await response.json();
                if (data.error) { alert('Lỗi: ' + data.error); return; }
                if (dnsMode === 'basic') {
                    renderBasicResults(data);
                } else {
                    document.getElementById('whoisPanel').innerHTML = '';
                    renderResults(data);
                }
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            } finally {
                document.getElementById('loading').classList.remove('show');
            }
        }

        function renderBasicResults(data) {
            document.getElementById('summaryDomain').textContent = data.domain || '-';
            document.getElementById('summaryResolvers').textContent = (data.resolver_used && data.resolver_used.ip) ? data.resolver_used.name + ' (' + data.resolver_used.ip + ')' : 'Single resolver';

            var dnssecEnabled = data.dnssec && data.dnssec.enabled;
            var summaryDNSSEC = document.getElementById('summaryDNSSEC');
            summaryDNSSEC.textContent = dnssecEnabled ? 'Enabled' : 'Disabled';
            summaryDNSSEC.className = 'dns-stat-value ' + (dnssecEnabled ? 'success' : 'error');

            // Build cards for each returned record type
            var records = data.records || {};
            var recordsHtml = '';
            var types = Object.keys(records);
            document.getElementById('dnsRecordCountChip').textContent = types.length + ' record types';

            types.forEach(function(type) {
                var r = records[type] || { status: 'no_record', record: null };
                var recList = Array.isArray(r.records) ? r.records : (r.record ? [r.record] : []);
                var recMarkup = recList.length > 0
                    ? recList.map(function(item) {
                        return '<span class="dns-record-value">' + escapeHtml(String(item)) + '</span>';
                    }).join('')
                    : '<span class="dns-empty-value">No record</span>';

                recordsHtml += '<div class="dns-record-card">' +
                    '<div class="dns-record-header"><div><div class="dns-record-title">' + escapeHtml(type) + ' (Basic)</div><div class="dns-record-subtitle">Representative record from single resolver</div></div><span class="dns-rate ' + (r.status === 'success' ? 'full' : 'none') + '">' + (r.status === 'success' ? 'OK' : 'No') + '</span></div>' +
                    '<div class="dns-record-body"><div style="padding:12px;">' +
                    '<div class="dns-resolver-values">' + recMarkup + '</div>' +
                    '</div></div></div>';
            });

            // SSL summary card (basic)
            var ssl = data.ssl || {};
            var sslHtml = '<div class="dns-record-card">' +
                '<div class="dns-record-header"><div><div class="dns-record-title">SSL (Basic)</div><div class="dns-record-subtitle">Issuer & Expiry (quick probe)</div></div><span class="dns-rate ' + (ssl.days_remaining>0 ? 'full' : 'none') + '">' + (ssl.days_remaining!=null ? ssl.days_remaining + 'd' : '-') + '</span></div>' +
                '<div class="dns-record-body"><div style="padding:12px;">' +
                '<div class="check-result-row ssl-basic-row ' + (ssl.issuer ? 'ok' : 'fail') + '"><strong>Issuer:</strong><span class="ssl-basic-value">' + escapeHtml(ssl.issuer || '-') + '</span></div>' +
                '<div class="check-result-row ssl-basic-row ' + (ssl.valid_from ? 'ok' : 'fail') + '"><strong>Valid From:</strong><span class="ssl-basic-value">' + (ssl.valid_from ? formatCertDate(ssl.valid_from) : '-') + '</span></div>' +
                '<div class="check-result-row ssl-basic-row ' + (ssl.valid_to ? 'ok' : 'fail') + '"><strong>Valid To:</strong><span class="ssl-basic-value">' + (ssl.valid_to ? formatCertDate(ssl.valid_to) : '-') + '</span></div>' +
                (ssl.error ? ('<div class="check-result-row fail">Error: ' + escapeHtml(ssl.error) + '</div>') : '') +
                '</div></div></div>';

            document.getElementById('dnsRecords').innerHTML = recordsHtml + sslHtml;
            setDnsView(dnsViewMode);
            document.getElementById('results').classList.add('show');
        }

        function renderResults(data) {
            document.getElementById('summaryDomain').textContent = data.domain;
            var resolverCount = data.summary && data.summary.resolver_count ? data.summary.resolver_count : Object.keys((data.dns_records && data.dns_records.A && data.dns_records.A.servers) || {}).length;
            document.getElementById('summaryResolvers').textContent = resolverCount + ' public resolvers';

            var dnssecEnabled = data.summary.dnssec_enabled;
            var summaryDNSSEC = document.getElementById('summaryDNSSEC');
            summaryDNSSEC.textContent = dnssecEnabled ? 'Enabled' : 'Disabled';
            summaryDNSSEC.className = 'dns-stat-value ' + (dnssecEnabled ? 'success' : 'error');

            var recordsHtml = '';
            var recordTypes = Object.keys(data.dns_records || {});
            document.getElementById('dnsRecordCountChip').textContent = recordTypes.length + ' record types';

            recordTypes.forEach(function(type) {
                var typeData = data.dns_records[type];
                var rateParts = typeData.success_rate.split('/');
                var successCount = parseInt(rateParts[0], 10), totalCount = parseInt(rateParts[1], 10);
                var rateClass = successCount === totalCount ? 'full' : (successCount > 0 ? 'partial' : 'none');

                var resolverHtml = '';
                for (var serverName in typeData.servers) {
                    var serverData = typeData.servers[serverName];
                    var hasRecords = serverData.records && serverData.records.length > 0;
                    var statusClass = serverData.status === 'success' ? 'success' : 'error';
                    var statusIcon = serverData.status === 'success' ? '✓' : '✕';
                    var recordsStr = hasRecords
                        ? serverData.records.map(function(record) { return '<span class="dns-record-value">' + escapeHtml(record) + '</span>'; }).join('')
                        : '<span class="dns-empty-value">No record</span>';

                    resolverHtml += '<div class="dns-resolver-card ' + statusClass + '">' +
                        '<div class="dns-resolver-top"><div><div class="dns-resolver-name">' + escapeHtml(serverName) + '</div><div class="dns-resolver-ip">' + escapeHtml(serverData.ip) + '</div></div><span class="dns-resolver-status ' + statusClass + '">' + statusIcon + '</span></div>' +
                        '<div class="dns-resolver-values">' + recordsStr + '</div>' +
                    '</div>';
                }

                recordsHtml += '<div class="dns-record-card">' +
                    '<div class="dns-record-header"><div><div class="dns-record-title">' + type + ' Record</div><div class="dns-record-subtitle">Parallel lookup on public resolvers</div></div><span class="dns-rate ' + rateClass + '">' + typeData.success_rate + '</span></div>' +
                    '<div class="dns-record-body"><div class="dns-resolver-grid">' + resolverHtml + '</div></div>' +
                '</div>';
            });
            document.getElementById('dnsRecords').innerHTML = recordsHtml;
            setDnsView(dnsViewMode);

            document.getElementById('results').classList.add('show');
        }

        function normalizeBulkDomain(value) {
            return String(value || '')
                .trim()
                .toLowerCase()
                .replace(/^https?:\/\//, '')
                .replace(/\/.*$/, '')
                .replace(/:.+$/, '')
                .replace(/^www\./, '')
                .trim();
        }

        function parseBulkDomains(text) {
            const items = String(text || '').split(/[\n,]+/);
            const seen = new Set();
            const domains = [];
            items.forEach(item => {
                const domain = normalizeBulkDomain(item);
                if (domain && !seen.has(domain)) {
                    seen.add(domain);
                    domains.push(domain);
                }
            });
            return domains;
        }

        async function checkBulkDNS() {
            const bulkInput = document.getElementById('bulkDomainsInput');
            const text = bulkInput ? bulkInput.value : '';
            const domains = parseBulkDomains(text);

            if (domains.length === 0) {
                alert('Vui lòng nhập ít nhất 1 tên miền');
                return;
            }

            document.getElementById('bulkLoading').classList.add('show');
            document.getElementById('bulkResults').classList.remove('show');

            try {
                const response = await fetch('/api/check-dns-bulk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domains: domains })
                });
                const data = await response.json();
                if (data.error) {
                    alert('Lỗi: ' + data.error);
                    return;
                }
                renderBulkDNSResults(data);
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            } finally {
                document.getElementById('bulkLoading').classList.remove('show');
            }
        }

        function renderBulkDNSResults(data) {
            const results = Array.isArray(data.results) ? data.results : [];
            document.getElementById('bulkCountChip').textContent = (data.count || results.length || 0) + ' domains';
            document.getElementById('bulkSummaryTotal').textContent = data.count || results.length || 0;
            const resolved = results.filter(item => item.ip && item.ip !== '-').length;
            document.getElementById('bulkSummaryResolved').textContent = resolved;
            document.getElementById('bulkSummaryMissing').textContent = (data.count || results.length || 0) - resolved;
            document.getElementById('bulkSummaryUpdated').textContent = new Date().toLocaleString('vi-VN');

            const container = document.getElementById('bulkResultsTable');
            if (results.length === 0) {
                container.innerHTML = '<div class="bulk-table-row"><div class="bulk-cell" style="grid-column:1/-1;color:#94a3b8;">Chưa có dữ liệu</div></div>';
            } else {
                container.innerHTML = '';
                const frag = document.createDocumentFragment();
                results.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'bulk-table-row';
                    const mx = item.mx || [];
                    const ns = item.nameserver || [];
                    const err = item.error ? '<div class="bulk-error-note">' + escapeHtml(item.error) + '</div>' : '';
                    row.innerHTML = '<div class="bulk-cell"><span class="bulk-domain-pill">' + escapeHtml(item.domain || '-') + '</span>' + err + '</div>' +
                        '<div class="bulk-cell">' + escapeHtml(item.ip || '-') + '</div>' +
                        '<div class="bulk-cell">' + bulkRenderValues(mx) + '</div>' +
                        '<div class="bulk-cell">' + bulkRenderValues(ns) + '</div>';
                    frag.appendChild(row);
                });
                container.appendChild(frag);
            }
            document.getElementById('bulkResults').classList.add('show');
        }

        function bulkRenderValues(value) {
            if (!value || value === '-') {
                return '<span class="bulk-empty">-</span>';
            }
            const parts = Array.isArray(value)
                ? value.map(item => String(item).trim()).filter(Boolean)
                : String(value)
                    .split(/\s*,\s*|\n+/)
                    .map(item => item.trim())
                    .filter(Boolean);
            if (parts.length <= 1) {
                return '<span class="dns-record-value">' + escapeHtml(value) + '</span>';
            }
            return '<div class="bulk-value-lines">' + parts.map(function(part) {
                return '<span class="bulk-value-line dns-record-value">' + escapeHtml(part) + '</span>';
            }).join('') + '</div>';
        }

        function clearBulkDNS() {
            const input = document.getElementById('bulkDomainsInput');
            if (input) input.value = '';
            document.getElementById('bulkResultsTable').innerHTML = '';
            document.getElementById('bulkResults').classList.remove('show');
            document.getElementById('bulkSummaryTotal').textContent = '-';
            document.getElementById('bulkSummaryResolved').textContent = '-';
            document.getElementById('bulkSummaryMissing').textContent = '-';
            document.getElementById('bulkSummaryUpdated').textContent = '-';
            document.getElementById('bulkCountChip').textContent = '0 domains';
        }

        let dnsHistorySourceId = 'combined';

        function formatHistoryTimestamp(value) {
            if (!value) return '-';
            const dt = new Date(value);
            if (Number.isNaN(dt.getTime())) return String(value);
            return dt.toLocaleString('vi-VN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                hour12: false,
                timeZoneName: 'short',
            });
        }

        function clearDNSHistory() {
            const input = document.getElementById('dnsHistoryInput');
            if (input) input.value = '';
            document.getElementById('dnsHistorySourceTabs').innerHTML = '';
            document.getElementById('dnsHistorySourcePanels').innerHTML = '';
            document.getElementById('dnsHistoryResults').classList.remove('show');
            document.getElementById('dnsHistoryCountChip').textContent = '0 records';
            document.getElementById('historySummaryDomain').textContent = '-';
            document.getElementById('historySummarySources').textContent = '-';
            document.getElementById('historySummaryRecords').textContent = '-';
            document.getElementById('historySummaryUpdated').textContent = '-';
            dnsHistorySourceId = 'combined';
        }

        function setDNSHistorySource(sourceId) {
            dnsHistorySourceId = sourceId;
            const tabButtons = Array.from(document.querySelectorAll('[data-history-source]'));
            const sourcePanels = Array.from(document.querySelectorAll('.history-source-pane'));

            tabButtons.forEach(btn => {
                const isActive = btn.dataset.historySource === sourceId;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            sourcePanels.forEach(panel => {
                const isActive = panel.dataset.historySource === sourceId;
                panel.classList.toggle('active', isActive);
                panel.hidden = !isActive;
            });
        }

        function renderHistoryRecord(record) {
            const values = [];
            if (record.flags && record.flags.length > 0) {
                record.flags.forEach(flag => {
                    values.push('<span class="history-record-pill">' + escapeHtml(String(flag)) + '</span>');
                });
            }
            if (record.tlp) {
                values.push('<span class="history-record-pill">TLP: ' + escapeHtml(String(record.tlp)) + '</span>');
            }
            if (record.customer) {
                values.push('<span class="history-record-pill">Customer: ' + escapeHtml(String(record.customer)) + '</span>');
            }

            const metaParts = [
                'Class: ' + escapeHtml(String(record.rrclass || '-')),
                'First: ' + escapeHtml(formatHistoryTimestamp(record.first_seen)),
                'Last: ' + escapeHtml(formatHistoryTimestamp(record.last_seen)),
            ];
            if (record.count !== null && record.count !== undefined) {
                metaParts.push('Count: ' + escapeHtml(String(record.count)));
            }

            const noteHtml = record.note
                ? '<div class="history-record-note">' + escapeHtml(record.note) + '</div>'
                : '';

            return '<div class="history-record-item">' +
                '<div class="history-record-top">' +
                    '<div>' +
                        '<div class="history-record-title"><span class="history-record-pill" style="margin-right:8px;">' + escapeHtml(String(record.rrtype || '-')) + '</span>' + escapeHtml(String(record.query || '-')) + ' → ' + escapeHtml(String(record.answer || '-')) + '</div>' +
                        '<div class="history-record-meta">' + metaParts.map(function(part) { return '<span>' + part + '</span>'; }).join('') + '</div>' +
                    '</div>' +
                    '<div class="history-record-meta" style="flex-direction:column;align-items:flex-end;gap:4px;">' +
                        '<span>' + escapeHtml(String(record.source_label || '-')) + '</span>' +
                        (record.source_id ? '<span>' + escapeHtml(String(record.source_id)) + '</span>' : '') +
                    '</div>' +
                '</div>' +
                (values.length > 0 ? '<div class="history-record-values">' + values.join('') + '</div>' : '') +
                noteHtml +
            '</div>';
        }

        function renderHistorySourcePane(source) {
            const timeline = Array.isArray(source.timeline) ? source.timeline : [];
            const typeCounts = source.type_counts || {};
            const typeChips = Object.keys(typeCounts).map(function(type) {
                return '<span class="dns-section-chip">' + escapeHtml(type) + ': ' + escapeHtml(String(typeCounts[type])) + '</span>';
            }).join('');

            const summaryHtml = '<div class="history-source-summary">' +
                '<div class="history-summary-card"><div class="history-summary-label">Records</div><div class="history-summary-value">' + escapeHtml(String(source.record_count || 0)) + '</div></div>' +
                '<div class="history-summary-card"><div class="history-summary-label">Buckets</div><div class="history-summary-value success">' + escapeHtml(String(timeline.length || 0)) + '</div></div>' +
                '<div class="history-summary-card"><div class="history-summary-label">Endpoint</div><div class="history-summary-value warning" title="' + escapeHtml(String(source.endpoint || '-')) + '">' + escapeHtml(String(source.endpoint || '-')) + '</div></div>' +
                '<div class="history-summary-card"><div class="history-summary-label">Status</div><div class="history-summary-value ' + (source.status === 'ok' ? 'success' : 'error') + '">' + escapeHtml(String(source.status || 'ok')) + '</div></div>' +
            '</div>';

            const typeHtml = typeChips ? '<div class="history-record-values" style="margin-bottom:14px;">' + typeChips + '</div>' : '';

            let timelineHtml = '';
            if (source.error) {
                timelineHtml = '<div class="history-source-error">' + escapeHtml(String(source.error)) + '</div>';
            } else if (!timeline.length) {
                timelineHtml = '<div class="history-empty">Không có dữ liệu history từ nguồn này.</div>';
            } else {
                timelineHtml = '<div class="history-timeline">' + timeline.map(function(bucket) {
                    const bucketRecords = Array.isArray(bucket.records) ? bucket.records : [];
                    const bucketTypes = bucket.type_counts || {};
                    const bucketChips = Object.keys(bucketTypes).map(function(type) {
                        return '<span class="dns-section-chip">' + escapeHtml(type) + ': ' + escapeHtml(String(bucketTypes[type])) + '</span>';
                    }).join('');
                    const groupedByType = bucketRecords.reduce(function(acc, record) {
                        const type = String(record.rrtype || 'UNKNOWN').toUpperCase();
                        if (!acc[type]) acc[type] = [];
                        acc[type].push(record);
                        return acc;
                    }, {});
                    const typeCards = Object.keys(groupedByType).sort().map(function(type) {
                        const typeRecords = groupedByType[type] || [];
                        return '<div class="history-type-card">' +
                            '<div class="history-type-head">' +
                                '<div class="history-type-title">' + escapeHtml(type) + '</div>' +
                                '<div class="history-type-count">' + escapeHtml(String(typeRecords.length)) + ' records</div>' +
                            '</div>' +
                            '<div class="history-type-body">' + typeRecords.map(renderHistoryRecord).join('') + '</div>' +
                        '</div>';
                    }).join('');

                    return '<div class="history-timeline-bucket">' +
                        '<div class="history-bucket-head">' +
                            '<div>' +
                                '<div class="history-bucket-title">' + escapeHtml(String(bucket.bucket_label || 'Không rõ')) + '</div>' +
                                '<div class="history-bucket-meta">' + escapeHtml(String(bucket.record_count || 0)) + ' records tại cùng thời điểm</div>' +
                            '</div>' +
                            '<div class="history-record-values">' + bucketChips + '</div>' +
                        '</div>' +
                        '<div class="history-type-grid">' +
                            typeCards +
                        '</div>' +
                    '</div>';
                }).join('') + '</div>';
            }

            return '<section class="history-source-pane" data-history-source="' + escapeHtml(String(source.id || 'unknown')) + '">' +
                summaryHtml +
                typeHtml +
                timelineHtml +
            '</section>';
        }

        function renderDNSHistoryResults(data) {
            document.getElementById('dnsHistoryCountChip').textContent = (data.total_records || 0) + ' records';
            document.getElementById('historySummaryDomain').textContent = data.domain || '-';
            document.getElementById('historySummarySources').textContent = (data.provider_count || (data.sources ? data.sources.length : 0)) || 0 + ' sources';
            document.getElementById('historySummaryRecords').textContent = data.total_records || 0;
            document.getElementById('historySummaryUpdated').textContent = data.timestamp ? new Date(data.timestamp).toLocaleString('vi-VN') : '-';
            
            // Show UI container first so spinner and layout are visible
            document.getElementById('dnsHistoryResults').classList.add('show');
            document.getElementById('dnsHistorySourceTabs').innerHTML = '<div style="padding:10px; color:#94a3b8;">Đang xây dựng giao diện, vui lòng đợi...</div>';
            document.getElementById('dnsHistorySourcePanels').innerHTML = '';

            // Defer heavy DOM building to next frame to avoid blocking UI
            requestAnimationFrame(() => {
                setTimeout(() => {
                    const sources = Array.isArray(data.sources) ? data.sources : [];
                    const tabs = [];
                    const panes = [];

                    sources.forEach(function(source, index) {
                        const sourceId = String(source.id || 'source-' + index);
                        const label = source.label || sourceId;
                        tabs.push('<button type="button" class="history-source-btn" data-history-source="' + escapeHtml(sourceId) + '" onclick="setDNSHistorySource(\'' + sourceId.replace(/'/g, "\\'") + '\')">' + escapeHtml(label) + ' (' + escapeHtml(String(source.record_count || 0)) + ')</button>');
                        panes.push(renderHistorySourcePane(source));
                    });

                    document.getElementById('dnsHistorySourceTabs').innerHTML = tabs.join('');
                    document.getElementById('dnsHistorySourcePanels').innerHTML = panes.join('');

                    const activeSource = sources.find(function(source) { return source.id === dnsHistorySourceId; }) || sources[0];
                    if (activeSource) {
                        setDNSHistorySource(activeSource.id);
                    }
                }, 50);
            });
        }

        async function checkDNSHistory() {
            const input = document.getElementById('dnsHistoryInput');
            const domain = input ? input.value.trim() : '';
            if (!domain) { alert('Vui lòng nhập tên miền'); return; }

            document.getElementById('dnsHistoryLoading').classList.add('show');
            document.getElementById('dnsHistoryResults').classList.remove('show');

            try {
                const response = await fetch('/api/check-dns-history', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domain: domain })
                });
                const data = await response.json();
                if (data.error) {
                    alert('Lỗi: ' + data.error);
                    return;
                }
                renderDNSHistoryResults(data);
            } catch (err) {
                alert('Lỗi kết nối: ' + err.message);
            } finally {
                document.getElementById('dnsHistoryLoading').classList.remove('show');
            }
        }

        function escapeHtml(text) { var div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
        function clearCache() { fetch('/api/clear-cache', { method: 'POST' }).then(() => alert('✓ Cache đã được xóa')).catch(err => alert('Lỗi: ' + err.message)); }

        // WHOIS integration: call backend /api/whois and render fields similar to whois_lookup.py --json
        async function checkWhois(domain) {
            domain = (domain || document.getElementById('domainInput').value.trim()).trim();
            if (!domain) { alert('Vui lòng nhập tên miền'); return; }
            var panel = document.getElementById('whoisPanel');
            panel.innerHTML = '<div class="result-box message-info">Đang lấy WHOIS…</div>';
            try {
                var resp = await fetch('/api/whois', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domain: domain, include_html: false })
                });
                var data = await resp.json();
                if (data.error) {
                    panel.innerHTML = '<div class="message message-error">Lỗi WHOIS: ' + escapeHtml(data.error) + '</div>';
                    return;
                }
                renderWhois(data);
            } catch (err) {
                panel.innerHTML = '<div class="message message-error">Lỗi kết nối WHOIS: ' + escapeHtml(err.message) + '</div>';
            }
        }

        function renderWhois(data) {
            var panel = document.getElementById('whoisPanel');
            if (!panel) return;
            var html = '<div class="dns-record-card">';
            html += '<div class="dns-record-header">';
            html += '<div><div class="dns-record-title">WHOIS</div><div class="dns-record-subtitle">Kết quả từ whois.pavietnam.net</div></div>';
            html += '<span class="dns-rate full">' + escapeHtml(data.domain || '-') + '</span>';
            html += '</div>';
            html += '<div class="dns-record-body">';
            html += '<div class="dns-resolver-grid" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">';
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Status</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml((data.status_line || data.status) || '-') + '</span></div></div>';
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Creation Date</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml(data.creation_date || '-') + '</span></div></div>';
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Expiry Date</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml(data.expiry_date || '-') + '</span></div></div>';
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Registrant</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml(data.registrant_name || '-') + '</span></div></div>';
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Registrar</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml(data.registrar_name || '-') + '</span></div></div>';
            // Registrar IANA ID / Abuse contact removed from UI per request
            html += '<div class="dns-resolver-card success"><div class="dns-resolver-name">Registry Lock</div><div class="dns-resolver-values"><span class="dns-record-value">' + escapeHtml(data.registry_lock || '-') + '</span></div></div>';
            html += '</div>';

            if (data.name_servers && data.name_servers.length > 0) {
                html += '<div style="margin-top:14px;"><div class="dns-record-subtitle" style="margin-bottom:8px;">Name Servers</div><div class="dns-resolver-values">' + data.name_servers.map(function(ns) { return '<span class="dns-record-value">' + escapeHtml(ns) + '</span>'; }).join('') + '</div></div>';
            }
            if (data.errors && data.errors.length > 0) {
                html += '<div style="margin-top:14px; padding:12px 14px; border-radius:12px; background:#fef2f2; color:#b91c1c; border:1px solid #fee2e2;"><strong>Errors:</strong> ' + escapeHtml(data.errors.join('; ')) + '</div>';
            }
            html += '</div></div>';
            panel.innerHTML = html;
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // ========== SSL Tool ==========
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('fileInput');
        const folderUploadArea = document.getElementById('folderUploadArea');
        const folderInput = document.getElementById('folderInput');
        const sslResultArea = document.getElementById('sslResultArea');
        const bundleOutput = document.getElementById('bundleOutput');
        const sslMessage = document.getElementById('sslMessage');
        const privateKeyInput = document.getElementById('privateKeyInput');
        const generateBtn = document.getElementById('generateBtn');
        const sslModeChooser = document.getElementById('sslModeChooser');
        const sslModePanel = document.getElementById('sslModePanel');
        const sslModeLabel = document.getElementById('sslModeLabel');
        const sslZipSection = document.getElementById('sslZipSection');
        const sslFolderSection = document.getElementById('sslFolderSection');
        const sslPasteSection = document.getElementById('sslPasteSection');
        const sslPasteInput = document.getElementById('sslPasteInput');
        const sslPasteSummary = document.getElementById('sslPasteSummary');

        let inputMode = null;
        let sslMessageTimer = null;
        let currentDomain = '', currentBundle = '', currentZipFilename = '', currentOriginalFiles = {};
        window.sslBundleParts = { cert: '', bundle: '', all: '' };

        function updateGenerateButtonState() {
            generateBtn.disabled = !(privateKeyInput.value.trim() && currentBundle.trim());
        }

        function normalizePemText(text) {
            return String(text || '')
                .replace(/\r\n/g, '\n')
                .replace(/\r/g, '\n')
                .trim();
        }

        function extractPemBlocksFromText(text, kind) {
            const normalized = normalizePemText(text);
            if (!normalized) return [];
            const pattern = kind === 'key'
                ? /-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----[\s\S]*?-----END (?:[A-Z ]+ )?PRIVATE KEY-----/gi
                : /-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/gi;
            return normalized.match(pattern) || [];
        }

        function setSslSectionState(section, visible) {
            if (!section) return;
            section.classList.toggle('is-hidden-mode', !visible);
            section.classList.toggle('is-visible-mode', visible);
        }

        function detectPrivateKeyFromFiles(files) {
            const entries = Object.entries(files || {});
            const privateKeyNames = ['private.key', 'private.pem', 'key.pem', 'key.key', 'key.txt', 'privkey.pem', 'server.key', 'domain.key'];
            for (const [filename, content] of entries) {
                const lowerName = String(filename).toLowerCase();
                const trimmed = String(content || '').trim();
                if (privateKeyNames.some(name => lowerName.endsWith(name))) {
                    return normalizePemText(trimmed);
                }
                if (/-----BEGIN (?:RSA |EC )?PRIVATE KEY-----/i.test(trimmed)) {
                    return normalizePemText(trimmed);
                }
            }
            return '';
        }

        async function readFilesFromFileList(fileList) {
            const files = {};
            const originalFiles = {};
            for (const file of Array.from(fileList || [])) {
                if (!file || file.size === 0) continue;
                const content = await file.text();
                const relativePath = String(file.webkitRelativePath || file.name || '').replace(/\\/g, '/');
                const normalizedKey = relativePath || String(file.name || '');
                files[normalizedKey.toLowerCase()] = content;
                originalFiles[normalizedKey.toLowerCase()] = content;
            }
            return { files, originalFiles };
        }

        function renderSslPasteSummary(items) {
            if (!sslPasteSummary) return;
            sslPasteSummary.innerHTML = '';
            const chipItems = Array.isArray(items) ? items : [];
            if (chipItems.length === 0) {
                const chip = document.createElement('span');
                chip.className = 'ssl-detect-chip muted';
                chip.textContent = 'Chưa có dữ liệu';
                sslPasteSummary.appendChild(chip);
                return;
            }
            chipItems.forEach(item => {
                const chip = document.createElement('span');
                chip.className = 'ssl-detect-chip' + (item.state ? ' ' + item.state : '');
                chip.textContent = item.label;
                sslPasteSummary.appendChild(chip);
            });
        }

        function clearParsedSslBundleState(options = {}) {
            currentBundle = '';
            currentZipFilename = '';
            currentDomain = '';
            currentOriginalFiles = {};
            window.sslBundleParts = { cert: '', bundle: '', all: '' };
            bundleOutput.value = '';
            if (!options.keepPrivateKey) privateKeyInput.value = '';
            sslResultArea.classList.remove('show');
            updateGenerateButtonState();
        }

        function applySslBundleParts(parts, meta = {}) {
            const safeParts = parts || { cert: '', bundle: '', all: '' };
            currentBundle = normalizePemText(safeParts.all);
            currentDomain = meta.domain || currentDomain || 'ssl-bundle';
            currentZipFilename = meta.filename || currentZipFilename;
            bundleOutput.value = currentBundle;
            privateKeyInput.value = normalizePemText(meta.privateKey || privateKeyInput.value);
            window.sslBundleParts = {
                cert: normalizePemText(safeParts.cert),
                bundle: normalizePemText(safeParts.bundle),
                all: normalizePemText(safeParts.all)
            };
            sslResultArea.classList.add('show');
            updateGenerateButtonState();
        }

        function setSSLInputMode(mode) {
            const nextMode = mode === 'paste' ? 'paste' : (mode === 'folder' ? 'folder' : 'zip');
            inputMode = nextMode;
            if (sslModeChooser) sslModeChooser.classList.add('is-hidden');
            if (sslModePanel) sslModePanel.classList.remove('is-hidden');
            if (sslModeLabel) {
                if (nextMode === 'zip') {
                    sslModeLabel.textContent = 'Đang dùng: Upload ZIP';
                } else if (nextMode === 'folder') {
                    sslModeLabel.textContent = 'Đang dùng: Scan Folder';
                } else {
                    sslModeLabel.textContent = 'Đang dùng: Paste SSL Content';
                }
            }
            setSslSectionState(sslZipSection, nextMode === 'zip');
            setSslSectionState(sslFolderSection, nextMode === 'folder');
            setSslSectionState(sslPasteSection, nextMode === 'paste');
            if (nextMode === 'paste' && sslPasteInput && document.activeElement !== sslPasteInput) {
                setTimeout(() => sslPasteInput.focus(), 0);
            }
        }

        function resetSSLInputMode() {
            inputMode = null;
            if (sslModeChooser) sslModeChooser.classList.remove('is-hidden');
            if (sslModePanel) sslModePanel.classList.add('is-hidden');
            setSslSectionState(sslZipSection, false);
            setSslSectionState(sslPasteSection, false);
            if (sslModeLabel) sslModeLabel.textContent = 'Chọn phương thức nhập';
            if (fileInput) fileInput.value = '';
            if (folderInput) folderInput.value = '';
            if (sslPasteInput) sslPasteInput.value = '';
            renderSslPasteSummary([]);
            clearParsedSslBundleState();
            showSSLMessage('', 'info');
        }

        function parseSslPasteContent(text) {
            const normalized = normalizePemText(text);
            const hasLabels = /(?:^|\n)\s*Private Key\s*:/i.test(normalized) || /(?:^|\n)\s*Cert(?:ificate)?\s*:/i.test(normalized) || /(?:^|\n)\s*CA Bundle\s*:/i.test(normalized);

            const privateKeySection = (normalized.match(/(?:^|\n)\s*Private Key\s*:\s*([\s\S]*?)(?=\n\s*(?:Cert(?:ificate)?|CA Bundle)\s*:|$)/i) || [])[1] || normalized;
            const certSection = (normalized.match(/(?:^|\n)\s*Cert(?:ificate)?\s*:\s*([\s\S]*?)(?=\n\s*CA Bundle\s*:|$)/i) || [])[1] || normalized;
            const caSection = (normalized.match(/(?:^|\n)\s*CA Bundle\s*:\s*([\s\S]*)$/i) || [])[1] || '';

            const errors = [];
            const privateKeyBlocks = extractPemBlocksFromText(privateKeySection, 'key');
            const certBlocks = extractPemBlocksFromText(certSection, 'cert');
            const caBlocks = caSection ? extractPemBlocksFromText(caSection, 'cert') : [];

            if (privateKeyBlocks.length === 0) {
                errors.push('Không tìm thấy Private Key');
            } else {
                try {
                    forge.pki.privateKeyFromPem(normalizePemText(privateKeyBlocks[0]));
                } catch (error) {
                    errors.push('Không tìm thấy Private Key');
                }
            }

            if (certBlocks.length === 0) {
                errors.push('Certificate không hợp lệ');
            } else {
                try {
                    forge.pki.certificateFromPem(normalizePemText(certBlocks[0]));
                } catch (error) {
                    errors.push('Certificate không hợp lệ');
                }
            }

            if (caSection.trim() && caBlocks.length === 0) {
                errors.push('CA Bundle thiếu hoặc sai format');
            }

            if (errors.length > 0) {
                return { valid: false, errors };
            }

            const privateKeyPem = normalizePemText(privateKeyBlocks[0]);
            const certPem = normalizePemText(certBlocks[0]);
            const caBundleBlocks = caSection ? caBlocks : certBlocks.slice(1);

            if (caBundleBlocks.length > 0) {
                for (const block of caBundleBlocks) {
                    try {
                        forge.pki.certificateFromPem(normalizePemText(block));
                    } catch (error) {
                        return { valid: false, errors: ['CA Bundle thiếu hoặc sai format'] };
                    }
                }
            }

            const caBundlePem = normalizePemText(caBundleBlocks.join('\n'));
            const allPem = normalizePemText([certPem, caBundlePem].filter(Boolean).join('\n'));

            return {
                valid: true,
                privateKeyPem,
                certPem,
                caBundlePem,
                allPem,
                summary: [
                    { label: 'Private Key', state: 'success' },
                    { label: 'Certificate', state: 'success' },
                    { label: `CA Bundle${caBundleBlocks.length ? ' × ' + caBundleBlocks.length : ''}`, state: caBundleBlocks.length ? 'success' : 'muted' }
                ]
            };
        }

        privateKeyInput.addEventListener('input', updateGenerateButtonState);

        if (sslPasteInput) {
            sslPasteInput.addEventListener('input', () => {
                if (inputMode !== 'paste') setSSLInputMode('paste');

                const rawValue = sslPasteInput.value || '';
                if (!rawValue.trim()) {
                    clearParsedSslBundleState();
                    renderSslPasteSummary([]);
                    showSSLMessage('', 'info');
                    return;
                }

                const parsed = parseSslPasteContent(rawValue);
                if (parsed.valid) {
                    applySslBundleParts({ cert: parsed.certPem, bundle: parsed.caBundlePem, all: parsed.allPem }, { privateKey: parsed.privateKeyPem, domain: 'ssl-paste-bundle' });
                    renderSslPasteSummary(parsed.summary);
                    showSSLMessage('✅ Đã nhận diện Private Key, Certificate và CA Bundle.', 'success');
                } else {
                    clearParsedSslBundleState();
                    renderSslPasteSummary([{ label: parsed.errors[0] || 'Chưa sẵn sàng', state: 'error' }]);
                    showSSLMessage('❌ ' + parsed.errors[0], 'error');
                }
            });
        }

        uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('dragover'); });
        uploadArea.addEventListener('dragleave', () => { uploadArea.classList.remove('dragover'); });
        uploadArea.addEventListener('drop', (e) => { e.preventDefault(); uploadArea.classList.remove('dragover'); if (e.dataTransfer.files.length > 0) handleFile(e.dataTransfer.files[0]); });
        fileInput.addEventListener('change', (e) => { if (e.target.files.length > 0) handleFile(e.target.files[0]); });

        if (folderUploadArea) {
            folderUploadArea.addEventListener('dragover', (e) => { e.preventDefault(); folderUploadArea.classList.add('dragover'); });
            folderUploadArea.addEventListener('dragleave', () => { folderUploadArea.classList.remove('dragover'); });
            folderUploadArea.addEventListener('drop', (e) => {
                e.preventDefault();
                folderUploadArea.classList.remove('dragover');
                const droppedFiles = Array.from(e.dataTransfer?.files || []);
                if (droppedFiles.length > 0) {
                    handleFolderFiles(droppedFiles);
                }
            });
        }
        if (folderInput) {
            folderInput.addEventListener('change', (e) => { if (e.target.files.length > 0) handleFolderFiles(e.target.files); });
        }

        function showSSLMessage(msg, type) {
            if (sslMessageTimer) {
                clearTimeout(sslMessageTimer);
                sslMessageTimer = null;
            }
            if (!sslMessage) return;
            sslMessage.innerHTML = msg ? '<div class="message-' + type + '">' + msg + '</div>' : '';
            if (type !== 'info' && msg) {
                sslMessageTimer = setTimeout(() => {
                    sslMessage.innerHTML = '';
                }, 5000);
            }
        }

        async function handleFile(file) {
            if (!file.name.endsWith('.zip')) { showSSLMessage('Vui lòng chọn file ZIP!', 'error'); return; }

            setSSLInputMode('zip');
            clearParsedSslBundleState();
            renderSslPasteSummary([]);
            document.getElementById('additionalResults').innerHTML = '';
            showSSLMessage('Đang xử lý file...', 'info');

            try {
                const zip = await JSZip.loadAsync(file);
                currentDomain = file.name.replace('.zip', '').toLowerCase();
                currentZipFilename = file.name;

                const files = {};
                for (const [filename, fileObj] of Object.entries(zip.files)) {
                    if (!fileObj.dir) {
                        const content = await fileObj.async('string');
                        const basename = filename.split('/').pop().toLowerCase();
                        files[basename] = content;
                        currentOriginalFiles[basename] = content;
                    }
                }

                const bundleParts = processFullBundle(files);
                if (bundleParts && bundleParts.all) {
                    const privateKeyPem = detectPrivateKeyFromFiles(files);
                    applySslBundleParts(bundleParts, { domain: currentDomain, filename: file.name, privateKey: privateKeyPem });
                    renderSslPasteSummary([
                        { label: 'ZIP parsed', state: 'success' },
                        { label: 'Certificate bundle ready', state: 'success' }
                    ]);
                    sslResultArea.classList.add('show');
                    showSSLMessage('✅ Xử lý thành công! Tìm thấy ' + (bundleParts.all.match(/BEGIN CERTIFICATE/g) || []).length + ' certificates.', 'success');
                } else {
                    clearParsedSslBundleState();
                    showSSLMessage('❌ Không tìm thấy file certificate hợp lệ!', 'error');
                }
            } catch (error) {
                clearParsedSslBundleState();
                showSSLMessage('❌ Lỗi khi xử lý file: ' + error.message, 'error');
            }
        }

        async function handleFolderFiles(fileList) {
            if (!fileList || fileList.length === 0) {
                showSSLMessage('Vui lòng chọn thư mục có file!', 'error');
                return;
            }

            setSSLInputMode('folder');
            clearParsedSslBundleState();
            renderSslPasteSummary([]);
            document.getElementById('additionalResults').innerHTML = '';
            showSSLMessage('Đang đọc thư mục...', 'info');

            try {
                const { files, originalFiles } = await readFilesFromFileList(fileList);
                currentDomain = 'folder-upload';
                currentZipFilename = '';
                currentOriginalFiles = originalFiles;

                const bundleParts = processFullBundle(files);
                if (bundleParts && bundleParts.all) {
                    const privateKeyPem = detectPrivateKeyFromFiles(files);
                    applySslBundleParts(bundleParts, { domain: currentDomain, filename: 'folder', privateKey: privateKeyPem });
                    renderSslPasteSummary([
                        { label: 'Folder scanned', state: 'success' },
                        { label: 'Certificate bundle ready', state: 'success' }
                    ]);
                    sslResultArea.classList.add('show');
                    showSSLMessage('✅ Đã đọc thư mục thành công! Tìm thấy ' + (bundleParts.all.match(/BEGIN CERTIFICATE/g) || []).length + ' certificates.', 'success');
                } else {
                    clearParsedSslBundleState();
                    showSSLMessage('❌ Không tìm thấy file certificate hợp lệ trong thư mục!', 'error');
                }
            } catch (error) {
                clearParsedSslBundleState();
                showSSLMessage('❌ Lỗi khi đọc thư mục: ' + error.message, 'error');
            }
        }

        function processFullBundle(files) {
            function normalizePemText(text) {
                return String(text || '')
                    .replace(/\r\n/g, '\n')
                    .replace(/\r/g, '\n')
                    .replace(/\n{3,}/g, '\n\n')
                    .trim();
            }

            const certFiles = [];
            for (const [filename, content] of Object.entries(files)) {
                if (typeof content === 'string' && content.includes('BEGIN CERTIFICATE')) {
                    certFiles.push([filename, content]);
                }
            }
            console.log('Tất cả file chứng chỉ:', certFiles.map(([n]) => n));

            const certRegex = /-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g;
            const extracted = [];

            for (const [filename, content] of certFiles) {
                const matches = content.match(certRegex) || [];
                matches.forEach(pem => extracted.push({ pem: normalizePemText(pem), filename }));
            }

            console.log('Tổng số đoạn cert tách được:', extracted.length);

            // Parse + dedupe theo fingerprint DER để tránh trùng giữa .crt và .txt
            const parsedCerts = [];
            const seenFp = new Set();

            for (const item of extracted) {
                try {
                    const cert = forge.pki.certificateFromPem(item.pem);
                    const der = forge.asn1.toDer(forge.pki.certificateToAsn1(cert)).getBytes();
                    const fp = forge.md.sha256.create().update(der).digest().toHex();
                    if (seenFp.has(fp)) continue;
                    seenFp.add(fp);

                    const subjectDN = cert.subject.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                    const issuerDN = cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                    const basicConstraints = (cert.extensions || []).find(ext => ext.name === 'basicConstraints');
                    const keyUsage = (cert.extensions || []).find(ext => ext.name === 'keyUsage');
                    const isCA = !!((basicConstraints && basicConstraints.cA) || (keyUsage && keyUsage.keyCertSign));
                    const isSelfSigned = subjectDN === issuerDN;
                    const subjectCN = cert.subject.getField('CN')?.value || '';

                    parsedCerts.push({
                        pem: item.pem,
                        filename: item.filename,
                        cert,
                        fp,
                        subjectDN,
                        issuerDN,
                        subjectCN,
                        isCA,
                        isSelfSigned,
                    });
                } catch (e) {
                    // Skip invalid certificate blocks
                }
            }

            if (parsedCerts.length === 0) return '';

            function normalizeHost(v) {
                return (v || '').toLowerCase().trim().replace(/^\*\./, '').replace(/^www\./, '').replace(/\.$/, '');
            }

            function wildcardMatches(pattern, host) {
                const p = (pattern || '').toLowerCase().trim();
                const h = (host || '').toLowerCase().trim();
                if (!p || !h) return false;
                if (p.startsWith('*.')) {
                    const suffix = p.slice(2);
                    return h === suffix || h.endsWith('.' + suffix);
                }
                return h === p;
            }

            function certNames(certObj) {
                const names = new Set();
                if (certObj.subjectCN) names.add(certObj.subjectCN.toLowerCase());
                const sanExt = (certObj.cert.extensions || []).find(ext => ext.name === 'subjectAltName');
                if (sanExt && Array.isArray(sanExt.altNames)) {
                    sanExt.altNames
                        .filter(alt => alt && alt.type === 2 && alt.value)
                        .forEach(alt => names.add(String(alt.value).toLowerCase()));
                }
                return Array.from(names);
            }

            const preferredHosts = new Set();
            if (currentDomain) {
                const base = normalizeHost(currentDomain.replace(/\.zip$/i, ''));
                if (base) {
                    preferredHosts.add(base);
                    preferredHosts.add('www.' + base);
                }
            }
            const preferredHostList = Array.from(preferredHosts);

            const issuerSet = new Set(parsedCerts.map(c => c.issuerDN));
            const subjectSet = new Set(parsedCerts.map(c => c.subjectDN));

            // Chọn leaf cert theo đặc tính chain thay vì regex CN theo hãng CA.
            const scored = parsedCerts.map(c => {
                let score = 0;
                if (!c.isCA) score += 6;
                if (!c.isSelfSigned) score += 4;
                if (!issuerSet.has(c.subjectDN)) score += 2; // không phát hành cert khác
                if (subjectSet.has(c.issuerDN) && c.subjectDN !== c.issuerDN) score += 1; // có parent trong tập cert

                const names = certNames(c);
                if (preferredHostList.length > 0) {
                    const hasPreferredName = preferredHostList.some(host => names.some(name => wildcardMatches(name, host) || wildcardMatches(host, name)));
                    if (hasPreferredName) score += 8;
                }

                const filenameHint = c.filename || '';
                if (/bundle|chain|root|ca|intermediate|trust/i.test(filenameHint)) score -= 2;
                if (/star|wildcard|domain|server|cert/i.test(filenameHint)) score += 1;

                // Ưu tiên cert có thời hạn kết thúc xa hơn nếu điểm tương đương
                let notAfterTs = 0;
                try {
                    notAfterTs = new Date(c.cert.validity.notAfter).getTime() || 0;
                } catch (e) {}

                return { certObj: c, score, notAfterTs };
            });

            scored.sort((a, b) => {
                if (b.score !== a.score) return b.score - a.score;
                return b.notAfterTs - a.notAfterTs;
            });

            let leaf = scored[0].certObj;

            // Chốt an toàn: nếu leaf bị CA, thử chọn cert non-CA tốt nhất
            if (leaf.isCA) {
                const nonCa = scored.find(x => !x.certObj.isCA && !x.certObj.isSelfSigned);
                if (nonCa) leaf = nonCa.certObj;
            }

            const bySubject = new Map();
            parsedCerts.forEach(c => {
                if (!bySubject.has(c.subjectDN)) bySubject.set(c.subjectDN, []);
                bySubject.get(c.subjectDN).push(c);
            });

            const chain = [leaf];
            const used = new Set([leaf.fp]);
            let current = leaf;

            while (current && current.issuerDN && current.subjectDN !== current.issuerDN) {
                const candidates = (bySubject.get(current.issuerDN) || []).filter(c => !used.has(c.fp));
                if (candidates.length === 0) break;

                candidates.sort((a, b) => {
                    if (a.isSelfSigned !== b.isSelfSigned) return a.isSelfSigned ? 1 : -1;
                    if (a.isCA !== b.isCA) return a.isCA ? -1 : 1;
                    return 0;
                });

                const issuerCert = candidates[0];
                chain.push(issuerCert);
                used.add(issuerCert.fp);
                current = issuerCert;
            }

            // Bổ sung CA còn thiếu (nếu có) để tránh mất chain khi file bundle chứa nhiều đoạn.
            const extraCAs = parsedCerts
                .filter(c => c.fp !== leaf.fp)
                .filter(c => c.isCA)
                .filter(c => !used.has(c.fp))
                .sort((a, b) => {
                    // ưu tiên intermediate trước root self-signed
                    if (a.isSelfSigned !== b.isSelfSigned) return a.isSelfSigned ? 1 : -1;
                    return a.subjectDN.localeCompare(b.subjectDN);
                });

            const finalList = [...chain, ...extraCAs];

            console.log('Domain cert selected:', leaf.filename, '| CN:', leaf.subjectCN || leaf.subjectDN);
            console.log('Bundle certs selected:', finalList.slice(1).map(c => c.subjectCN || c.subjectDN));
            console.log('Bundle có', finalList.length, 'đoạn cert');

            const bundle = normalizePemText(finalList.map(c => c.pem).join('\n'));
            const certPem = normalizePemText(leaf.pem);
            const caBundlePem = normalizePemText(finalList.slice(1).map(c => c.pem).join('\n'));

            return {
                all: bundle,
                cert: certPem,
                bundle: caBundlePem,
            };
        }

        function removeDuplicateCerts(bundle) {
            const certRegex = /(-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----)/g;
            const certificates = bundle.match(certRegex) || [];
            const parsedCerts = [];
            
            certificates.forEach(cert => {
                try {
                    const parsed = forge.pki.certificateFromPem(cert);
                    parsedCerts.push({ pem: cert.trim(), cert: parsed, subject: parsed.subject.getField('CN')?.value || 'Unknown', issuer: parsed.issuer.getField('CN')?.value || 'Unknown' });
                } catch (e) {}
            });
            
            const uniqueCerts = [];
            const seen = new Set();
            parsedCerts.forEach(item => { if (!seen.has(item.pem)) { seen.add(item.pem); uniqueCerts.push(item); } });
            
            return sortCertificateChain(uniqueCerts).map(item => item.pem).join('\n');
        }

        function sortCertificateChain(certObjects) {
            if (certObjects.length <= 1) return certObjects;
            
            let leafCert = null;
            const remaining = [];
            
            for (const certObj of certObjects) {
                const subjectDN = certObj.cert.subject.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                const issuerDN = certObj.cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                const isSelfSigned = subjectDN === issuerDN;
                
                if (!isSelfSigned && !leafCert) {
                    const isLeaf = !certObjects.some(other => {
                        const otherIssuerDN = other.cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                        return otherIssuerDN === subjectDN;
                    });
                    if (isLeaf) leafCert = certObj; else remaining.push(certObj);
                } else {
                    remaining.push(certObj);
                }
            }
            
            if (!leafCert && certObjects.length > 0) {
                leafCert = certObjects.find(c => { const s = c.cert.subject.attributes.map(a => `${a.shortName}=${a.value}`).join(','); const i = c.cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(','); return s !== i; }) || certObjects[0];
                const leafIndex = certObjects.indexOf(leafCert);
                remaining.push(...certObjects.filter((_, idx) => idx !== leafIndex));
            }
            
            const chain = [leafCert];
            let current = leafCert;
            
            while (remaining.length > 0 && current) {
                const currentIssuerDN = current.cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                const issuerIndex = remaining.findIndex(certObj => certObj.cert.subject.attributes.map(a => `${a.shortName}=${a.value}`).join(',') === currentIssuerDN);
                if (issuerIndex !== -1) { const issuerCert = remaining.splice(issuerIndex, 1)[0]; chain.push(issuerCert); current = issuerCert; } else break;
            }
            if (remaining.length > 0) chain.push(...remaining);
            return chain;
        }

        function copyTextToClipboard(text, successMessage) {
            const value = String(text || '')
                .replace(/\r\n/g, '\n')
                .replace(/\r/g, '\n')
                .trim();
            if (!value) {
                showSSLMessage('❌ Không có dữ liệu để copy!', 'error');
                return;
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(value).then(() => {
                    showSSLMessage(successMessage || '✅ Đã copy vào clipboard!', 'success');
                }).catch(() => {
                    showSSLMessage('❌ Không thể copy dữ liệu!', 'error');
                });
                return;
            }

            const textarea = document.createElement('textarea');
            textarea.value = value;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showSSLMessage(successMessage || '✅ Đã copy vào clipboard!', 'success');
            } catch (err) {
                showSSLMessage('❌ Không thể copy dữ liệu!', 'error');
            } finally {
                document.body.removeChild(textarea);
            }
        }

        function copySslBundlePart(part) {
            const parts = window.sslBundleParts || { cert: '', bundle: '', all: '' };
            if (part === 'cert') {
                copyTextToClipboard(parts.cert, '✅ Đã copy Certificate!');
            } else if (part === 'bundle') {
                copyTextToClipboard(parts.bundle, '✅ Đã copy CA Bundle!');
            } else {
                copyTextToClipboard(parts.all, '✅ Đã copy Cert + CA Bundle!');
            }
        }

        function downloadBundle() {
            const blob = new Blob([currentBundle], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = currentDomain + '_bundle.crt';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        async function verifyKeyAndCert(privateKeyPem, certBundle) {
            try {
                const privateKey = forge.pki.privateKeyFromPem(privateKeyPem);
                const certMatches = certBundle.match(/-----BEGIN CERTIFICATE-----[\s\S]+?-----END CERTIFICATE-----/g);
                if (!certMatches || certMatches.length === 0) throw new Error('No certificate found');
                
                let domainCert = null;
                for (const certPem of certMatches) {
                    const cert = forge.pki.certificateFromPem(certPem);
                    const subjectDN = cert.subject.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                    const issuerDN = cert.issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',');
                    if (subjectDN !== issuerDN) {
                        const isLeaf = !certMatches.some(otherPem => {
                            if (otherPem === certPem) return false;
                            try { return forge.pki.certificateFromPem(otherPem).issuer.attributes.map(a => `${a.shortName}=${a.value}`).join(',') === subjectDN; } catch (e) { return false; }
                        });
                        if (isLeaf) { domainCert = cert; break; }
                    }
                }
                if (!domainCert) domainCert = forge.pki.certificateFromPem(certMatches[0]);
                
                const certPublicKeyPem = forge.pki.publicKeyToPem(domainCert.publicKey);
                const privateKeyPublicKeyPem = forge.pki.publicKeyToPem(forge.pki.setRsaPublicKey(privateKey.n, privateKey.e));
                return certPublicKeyPem === privateKeyPublicKeyPem;
            } catch (error) {
                showSSLMessage('❌ Lỗi khi kiểm tra key: ' + error.message, 'error');
                return false;
            }
        }

        async function generatePemAndPfx() {
            const privateKey = privateKeyInput.value.trim();
            if (!privateKey || !currentBundle) { showSSLMessage('❌ Vui lòng nhập private key!', 'error'); return; }
            if (typeof forge === 'undefined') { showSSLMessage('❌ Đang tải thư viện...', 'error'); return; }

            showSSLMessage('🔧 Đang kiểm tra private key...', 'info');
            generateBtn.disabled = true;

            try {
                const isMatch = await verifyKeyAndCert(privateKey, currentBundle);
                if (!isMatch) { showSSLMessage('❌ Private key KHÔNG KHỚP với certificate!', 'error'); generateBtn.disabled = false; return; }
                
                showSSLMessage('✅ Key khớp! Đang tạo files...', 'success');
                await new Promise(r => setTimeout(r, 300));

                const pemContent = currentBundle + '\n' + privateKey;
                const pfxBuffer = await createPFX(privateKey, currentBundle, '123456');
                
                const zip = new JSZip();
                const domainName = currentDomain.replace(/\.zip$/i, '');
                const originalFolder = zip.folder('original');
                for (const [filename, content] of Object.entries(currentOriginalFiles)) originalFolder.file(filename, content);
                
                zip.file('private.key', privateKey);
                zip.file(domainName + '.pem', pemContent);
                zip.file(domainName + '.crt', currentBundle);
                zip.file(domainName + '.pfx', pfxBuffer);
                
                const zipBlob = await zip.generateAsync({type: 'blob'});
                displayResults(pemContent, pfxBuffer, zipBlob, domainName + '-package.zip');
                showSSLMessage('✅ Hoàn thành! Đã tạo PEM, PFX và ZIP.', 'success');
            } catch (error) {
                showSSLMessage('❌ Lỗi: ' + error.message, 'error');
            } finally {
                generateBtn.disabled = false;
            }
        }

        async function createPFX(privateKey, certBundle, password) {
            const privateKeyPem = forge.pki.privateKeyFromPem(privateKey);
            const certs = [];
            const certMatches = certBundle.match(/-----BEGIN CERTIFICATE-----[\s\S]+?-----END CERTIFICATE-----/g);
            certMatches.forEach(certPem => { try { certs.push(forge.pki.certificateFromPem(certPem)); } catch (e) {} });
            
            const p12Asn1 = forge.pkcs12.toPkcs12Asn1(privateKeyPem, certs, password, {algorithm: '3des'});
            const p12Der = forge.asn1.toDer(p12Asn1).getBytes();
            const uint8Array = new Uint8Array(p12Der.length);
            for (let i = 0; i < p12Der.length; i++) uint8Array[i] = p12Der.charCodeAt(i);
            return uint8Array;
        }

        function displayResults(pemContent, pfxBuffer, zipBlob, zipFilename) {
            const certMatches = currentBundle.match(/-----BEGIN CERTIFICATE-----[\s\S]*?-----END CERTIFICATE-----/g) || [];
            const domainCert = certMatches[0] || '';
            const caBundle = certMatches.slice(1).join('\n') || '';
            const privateKeyText = privateKeyInput.value.trim();
            
            const copyFormat = `SSL xác thực thành công. Kỹ thuật xin phép gửi Quý khách thông tin Cert:\nPrivate key:\n\n${privateKeyText}\n\nCert:\n\n${domainCert}\n\nCA bundle:\n\n${caBundle}`;
            
            document.getElementById('additionalResults').innerHTML = `
                <div class="result-box" style="background: #fef3c7;">
                    <h3>📋 Thông tin Cert (Copy)<div class="btn-group"><button class="btn btn-success" onclick="navigator.clipboard.writeText(decodeURIComponent('${encodeURIComponent(copyFormat)}')).then(()=>showSSLMessage('✅ Copied!','success'))">📋 Copy</button></div></h3>
                    <textarea readonly style="min-height: 180px;">${copyFormat}</textarea>
                </div>
                <div class="result-box">
                    <h3>📄 PEM File<div class="btn-group"><button class="btn btn-info" onclick="downloadFile('pem')">⬇️ Download</button></div></h3>
                    <textarea readonly style="min-height: 100px;">${pemContent.substring(0, 400)}...</textarea>
                </div>
                <div class="result-box">
                    <h3>🔐 PFX File (Password: 123456)<div class="btn-group"><button class="btn btn-info" onclick="downloadFile('pfx')">⬇️ Download</button></div></h3>
                    <p style="color: #64748b;">File PFX đã tạo với password: <strong>123456</strong></p>
                </div>
                <div class="result-box" style="background: #dcfce7;">
                    <h3>📦 Complete Package<div class="btn-group"><button class="btn btn-success" onclick="downloadFile('zip')">⬇️ Download ZIP</button></div></h3>
                    <p style="color: #64748b;">Chứa: private.key, .pem, .crt, .pfx</p>
                </div>`;
            
            window.sslFiles = { pem: pemContent, pfx: pfxBuffer, zip: zipBlob, zipName: zipFilename };
        }

        function downloadFile(type) {
            if (!window.sslFiles) return;
            const domainName = currentDomain.replace(/\.zip$/i, '');
            let blob, filename;
            
            if (type === 'pem') { blob = new Blob([window.sslFiles.pem], {type: 'text/plain'}); filename = domainName + '.pem'; }
            else if (type === 'pfx') { blob = new Blob([window.sslFiles.pfx], {type: 'application/x-pkcs12'}); filename = domainName + '.pfx'; }
            else if (type === 'zip') { blob = window.sslFiles.zip; filename = window.sslFiles.zipName; }
            
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        
        // ========== SSL Decoder Functions ==========
        function setSSLDecoderMode(mode) {
            const target = mode || 'match';
            const panelMap = {
                match: 'decoderPanelMatch',
                cert: 'decoderPanelCert',
                csr: 'decoderPanelCsr'
            };
            const buttonMap = {
                match: 'ssldecoderBtnMatch',
                cert: 'ssldecoderBtnCert',
                csr: 'ssldecoderBtnCsr'
            };

            Object.entries(panelMap).forEach(([key, id]) => {
                const panel = document.getElementById(id);
                if (panel) panel.classList.toggle('active', key === target);
            });
            Object.entries(buttonMap).forEach(([key, id]) => {
                const btn = document.getElementById(id);
                if (btn) btn.classList.toggle('active', key === target);
            });
        }

        const sslDecoderDebounceTimers = {
            match: null,
            cert: null,
            csr: null,
        };

        function debounceSSLDecoder(key, fn, delay = 1000) {
            if (sslDecoderDebounceTimers[key]) clearTimeout(sslDecoderDebounceTimers[key]);
            sslDecoderDebounceTimers[key] = setTimeout(fn, delay);
        }

        function setupSSLDecoderAutoRun() {
            const matchCertInput = document.getElementById('matchCertInput');
            const matchKeyInput = document.getElementById('matchKeyInput');
            const decodeCertInput = document.getElementById('decodeCertInput');
            const decodeCSRInput = document.getElementById('decodeCSRInput');
            const matchResult = document.getElementById('matchResult');
            const certResult = document.getElementById('certDecodeResult');
            const csrResult = document.getElementById('csrDecodeResult');

            if (matchCertInput && matchKeyInput && matchResult) {
                const triggerMatch = () => {
                    const certVal = matchCertInput.value.trim();
                    const keyVal = matchKeyInput.value.trim();
                    if (!certVal && !keyVal) {
                        matchResult.className = 'match-result pending';
                        matchResult.innerHTML = 'Nhập Certificate và Private Key để kiểm tra';
                        return;
                    }
                    if (!certVal || !keyVal) {
                        matchResult.className = 'match-result pending';
                        matchResult.innerHTML = '⚠️ Vui lòng nhập cả Certificate và Private Key';
                        return;
                    }
                    checkCertKeyMatch();
                };

                matchCertInput.addEventListener('input', () => debounceSSLDecoder('match', triggerMatch));
                matchKeyInput.addEventListener('input', () => debounceSSLDecoder('match', triggerMatch));
            }

            if (decodeCertInput && certResult) {
                decodeCertInput.addEventListener('input', () => {
                    debounceSSLDecoder('cert', () => {
                        const certVal = decodeCertInput.value.trim();
                        if (!certVal) {
                            certResult.innerHTML = '';
                            return;
                        }
                        decodeCertificate();
                    });
                });
            }

            if (decodeCSRInput && csrResult) {
                decodeCSRInput.addEventListener('input', () => {
                    debounceSSLDecoder('csr', () => {
                        const csrVal = decodeCSRInput.value.trim();
                        if (!csrVal) {
                            csrResult.innerHTML = '';
                            return;
                        }
                        decodeCSR();
                    });
                });
            }
        }

        function checkCertKeyMatch() {
            const certPem = document.getElementById('matchCertInput').value.trim();
            const keyPem = document.getElementById('matchKeyInput').value.trim();
            const resultDiv = document.getElementById('matchResult');
            
            if (!certPem || !keyPem) {
                resultDiv.className = 'match-result pending';
                resultDiv.innerHTML = '⚠️ Vui lòng nhập cả Certificate và Private Key';
                return;
            }
            
            try {
                // Parse certificate
                const cert = forge.pki.certificateFromPem(certPem);
                const certPublicKey = cert.publicKey;
                
                // Parse private key (support both RSA PRIVATE KEY and PRIVATE KEY)
                let privateKey;
                try {
                    privateKey = forge.pki.privateKeyFromPem(keyPem);
                } catch (e) {
                    resultDiv.className = 'match-result no-match';
                    resultDiv.innerHTML = '❌ Không thể parse Private Key. Kiểm tra định dạng PEM.';
                    return;
                }
                
                // Get public key from private key
                const privateKeyPublicKey = forge.pki.setRsaPublicKey(privateKey.n, privateKey.e);
                
                // Compare modulus (n)
                const certModulus = certPublicKey.n.toString(16);
                const keyModulus = privateKeyPublicKey.n.toString(16);
                
                if (certModulus === keyModulus) {
                    resultDiv.className = 'match-result match';
                    resultDiv.innerHTML = '✅ MATCH! Certificate và Private Key KHỚP nhau.';
                } else {
                    resultDiv.className = 'match-result no-match';
                    resultDiv.innerHTML = '❌ KHÔNG KHỚP! Certificate và Private Key không cùng cặp.';
                }
            } catch (e) {
                resultDiv.className = 'match-result no-match';
                resultDiv.innerHTML = '❌ Lỗi: ' + e.message;
            }
        }
        
        function decodeCertificate() {
            const certPem = document.getElementById('decodeCertInput').value.trim();
            const resultDiv = document.getElementById('certDecodeResult');
            
            if (!certPem) {
                resultDiv.innerHTML = '<div class="message message-error">Vui lòng nhập Certificate PEM</div>';
                return;
            }
            
            try {
                const cert = forge.pki.certificateFromPem(certPem);
                
                // Extract subject info
                const subject = cert.subject.attributes.reduce((obj, attr) => {
                    obj[attr.shortName || attr.name] = attr.value;
                    return obj;
                }, {});
                
                // Extract issuer info  
                const issuer = cert.issuer.attributes.reduce((obj, attr) => {
                    obj[attr.shortName || attr.name] = attr.value;
                    return obj;
                }, {});
                
                // Get SAN (Subject Alternative Names)
                let sans = [];
                const sanExt = cert.extensions.find(ext => ext.name === 'subjectAltName');
                if (sanExt && sanExt.altNames) {
                    sans = sanExt.altNames.filter(n => n.type === 2).map(n => n.value);
                }
                
                // Calculate days remaining
                const now = new Date();
                const notAfter = cert.validity.notAfter;
                const daysRemaining = Math.floor((notAfter - now) / (1000 * 60 * 60 * 24));
                let daysClass = 'success';
                if (daysRemaining < 0) daysClass = 'error';
                else if (daysRemaining < 30) daysClass = 'warning';
                
                // Serial number
                const serialNumber = cert.serialNumber.match(/.{2}/g).join(':').toUpperCase();
                
                // Signature algorithm
                const sigAlg = cert.signatureOid;
                const sigAlgName = {
                    '1.2.840.113549.1.1.11': 'SHA256withRSA',
                    '1.2.840.113549.1.1.12': 'SHA384withRSA',
                    '1.2.840.113549.1.1.13': 'SHA512withRSA',
                    '1.2.840.113549.1.1.5': 'SHA1withRSA',
                    '1.2.840.10045.4.3.2': 'ECDSA-SHA256',
                    '1.2.840.10045.4.3.3': 'ECDSA-SHA384'
                }[sigAlg] || sigAlg;
                
                // Key info
                let keyInfo = 'Unknown';
                if (cert.publicKey.n) {
                    const keyBits = cert.publicKey.n.bitLength();
                    keyInfo = `RSA ${keyBits} bits`;
                } else if (cert.publicKey.curve) {
                    keyInfo = `ECDSA ${cert.publicKey.curve}`;
                }
                
                resultDiv.innerHTML = `
                    <div class="decode-info-grid">
                        <div class="decode-info-item full">
                            <div class="label">Common Name (CN)</div>
                            <div class="value">${subject.CN || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Organization (O)</div>
                            <div class="value">${subject.O || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Country (C)</div>
                            <div class="value">${subject.C || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Valid From</div>
                            <div class="value">${cert.validity.notBefore.toISOString().split('T')[0]}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Valid To</div>
                            <div class="value">${cert.validity.notAfter.toISOString().split('T')[0]}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Days Remaining</div>
                            <div class="value ${daysClass}">${daysRemaining} days ${daysRemaining < 0 ? '(EXPIRED!)' : ''}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Key Type</div>
                            <div class="value">${keyInfo}</div>
                        </div>
                        <div class="decode-info-item full">
                            <div class="label">Issuer</div>
                            <div class="value">${issuer.CN || ''} ${issuer.O ? '(' + issuer.O + ')' : ''}</div>
                        </div>
                        <div class="decode-info-item full">
                            <div class="label">Subject Alternative Names (SAN)</div>
                            <div class="value mono">${sans.length > 0 ? sans.join(', ') : 'N/A'}</div>
                        </div>
                        <div class="decode-info-item full">
                            <div class="label">Serial Number</div>
                            <div class="value mono">${serialNumber}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Signature Algorithm</div>
                            <div class="value">${sigAlgName}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Version</div>
                            <div class="value">V${cert.version + 1}</div>
                        </div>
                    </div>
                `;
            } catch (e) {
                resultDiv.innerHTML = `<div class="message message-error">❌ Lỗi parse Certificate: ${e.message}</div>`;
            }
        }
        
        function decodeCSR() {
            const csrPem = document.getElementById('decodeCSRInput').value.trim();
            const resultDiv = document.getElementById('csrDecodeResult');
            
            if (!csrPem) {
                resultDiv.innerHTML = '<div class="message message-error">Vui lòng nhập CSR PEM</div>';
                return;
            }
            
            try {
                const csr = forge.pki.certificationRequestFromPem(csrPem);
                
                // Extract subject info
                const subject = csr.subject.attributes.reduce((obj, attr) => {
                    obj[attr.shortName || attr.name] = attr.value;
                    return obj;
                }, {});
                
                // Key info
                let keyInfo = 'Unknown';
                if (csr.publicKey.n) {
                    const keyBits = csr.publicKey.n.bitLength();
                    keyInfo = `RSA ${keyBits} bits`;
                } else if (csr.publicKey.curve) {
                    keyInfo = `ECDSA ${csr.publicKey.curve}`;
                }
                
                // Get SAN from extensions (if present)
                let sans = [];
                if (csr.attributes) {
                    const extReq = csr.attributes.find(attr => attr.name === 'extensionRequest');
                    if (extReq && extReq.extensions) {
                        const sanExt = extReq.extensions.find(ext => ext.name === 'subjectAltName');
                        if (sanExt && sanExt.altNames) {
                            sans = sanExt.altNames.filter(n => n.type === 2).map(n => n.value);
                        }
                    }
                }
                
                // Signature algorithm
                const sigAlg = csr.signatureOid || csr.siginfo?.algorithmOid || 'Unknown';
                const sigAlgName = {
                    '1.2.840.113549.1.1.11': 'SHA256withRSA',
                    '1.2.840.113549.1.1.12': 'SHA384withRSA',
                    '1.2.840.113549.1.1.13': 'SHA512withRSA',
                    '1.2.840.113549.1.1.5': 'SHA1withRSA',
                    '1.2.840.10045.4.3.2': 'ECDSA-SHA256'
                }[sigAlg] || sigAlg;
                
                resultDiv.innerHTML = `
                    <div class="decode-info-grid">
                        <div class="decode-info-item full">
                            <div class="label">Common Name (CN)</div>
                            <div class="value">${subject.CN || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Organization (O)</div>
                            <div class="value">${subject.O || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Organizational Unit (OU)</div>
                            <div class="value">${subject.OU || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Country (C)</div>
                            <div class="value">${subject.C || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">State/Province (ST)</div>
                            <div class="value">${subject.ST || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Locality (L)</div>
                            <div class="value">${subject.L || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Email</div>
                            <div class="value">${subject.E || subject.emailAddress || 'N/A'}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Key Type</div>
                            <div class="value">${keyInfo}</div>
                        </div>
                        <div class="decode-info-item">
                            <div class="label">Signature Algorithm</div>
                            <div class="value">${sigAlgName}</div>
                        </div>
                        <div class="decode-info-item full">
                            <div class="label">Subject Alternative Names (SAN)</div>
                            <div class="value mono">${sans.length > 0 ? sans.join(', ') : 'N/A (không có trong CSR)'}</div>
                        </div>
                    </div>
                `;
            } catch (e) {
                resultDiv.innerHTML = `<div class="message message-error">❌ Lỗi parse CSR: ${e.message}</div>`;
            }
        }

        // ========== Free SSL (ACME Providers) ==========
        // ========== Free SSL (ACME Providers) ==========

        // Safe fetch helper — trả về {ok, data, errorText}
        async function freeSslFetch(url, body = null, method = 'POST') {
            let resp;
            try {
                const options = { method, headers: {} };
                if (body !== null && method !== 'GET') {
                    options.headers['Content-Type'] = 'application/json';
                    options.body = JSON.stringify(body);
                }
                resp = await fetch(url, options);
            } catch (networkErr) {
                return { ok: false, data: null, errorText: 'Không kết nối được tới server. Hãy đảm bảo server đang chạy. (' + networkErr.message + ')' };
            }
            const text = await resp.text();
            if (!text || !text.trim().startsWith('{')) {
                // Server trả về HTML thay vì JSON — thường do server chưa restart
                const hint = !resp.ok
                    ? `Server trả về HTTP ${resp.status}. Hãy restart server Flask rồi thử lại.`
                    : 'Server trả về nội dung không hợp lệ. Hãy restart server Flask.';
                return { ok: false, data: null, errorText: hint };
            }
            let data;
            try { data = JSON.parse(text); } catch (e) {
                return { ok: false, data: null, errorText: 'JSON parse error: ' + e.message };
            }
            if (!resp.ok || data.error) {
                return { ok: false, data, errorText: data.error || `HTTP ${resp.status}` };
            }
            return { ok: true, data, errorText: null };
        }

        let freeSslSessionId = null;
        let freeSslStorageId = null;
        let freeSslSans = [];
        let freeSslChallengeType = 'dns-01';
        let freeSslProvider = 'letsencrypt';
        let freeSslResultData = null;
        let freeSslStatus = 'pending';
        let freeSslStatusMonitorTimer = null;
        let freeSslLogCursor = 0;
        let freeSslCurrentRunId = null;
        let freeSslCurrentOrderId = null;
        let freeSslSidebarLastFocus = null;

        function freeSslRenderDomainProgress(domains) {
            if (!Array.isArray(domains) || domains.length === 0) return;
            const html = domains.map(d => {
                const st = (d.status || 'pending').toLowerCase();
                const cls = st === 'valid' ? 'ok' : (st === 'invalid' ? 'fail' : 'pending');
                return `<div class="check-result-row ${cls}"><div><strong>${d.domain || '-'}</strong><br><span class="small-line">Authorization: ${st}</span></div></div>`;
            }).join('');
            document.getElementById('freesslCheckResults').innerHTML = html;
        }

        function freeSslApplyProgressLogs(logs, runId = null) {
            if (!Array.isArray(logs)) return;
            if (runId && runId !== freeSslCurrentRunId) {
                freeSslCurrentRunId = runId;
                freeSslClearLog();
            }
            const targetRunId = freeSslCurrentRunId || runId;
            const filtered = targetRunId ? logs.filter(x => (x && x.run_id) === targetRunId) : logs;
            if (filtered.length < freeSslLogCursor) freeSslLogCursor = 0;
            for (let i = freeSslLogCursor; i < filtered.length; i++) {
                const entry = filtered[i] || {};
                const lv = (entry.level || 'info').toLowerCase();
                const type = lv === 'error' ? 'error' : (lv === 'success' ? 'success' : (lv === 'loading' ? 'loading' : 'info'));
                const line = `[${entry.time || '...'}] ${entry.message || ''}`;
                freeSslLog(line, type);
            }
            freeSslLogCursor = filtered.length;
        }

        function freeSslStopStatusMonitor() {
            if (freeSslStatusMonitorTimer) {
                clearInterval(freeSslStatusMonitorTimer);
                freeSslStatusMonitorTimer = null;
            }
        }

        function freeSslStartStatusMonitor() {
            if (!freeSslSessionId && !freeSslStorageId) return;
            freeSslStopStatusMonitor();
            freeSslStatusMonitorTimer = setInterval(async () => {
                let ok = false;
                let data = null;

                if (freeSslSessionId) {
                    const sessionResp = await freeSslFetch('/api/ssl-free/session/' + encodeURIComponent(freeSslSessionId) + '/status', null, 'GET');
                    ok = sessionResp.ok;
                    data = sessionResp.data;
                }

                if (!ok && freeSslStorageId) {
                    const itemResp = await freeSslFetch('/api/ssl-free/item/' + encodeURIComponent(freeSslStorageId), null, 'GET');
                    ok = itemResp.ok;
                    data = itemResp.data;
                }

                if (!ok || !data) return;

                freeSslSetActionState(data.status || 'pending');
                freeSslApplyProgressLogs(data.progress_logs || [], data.current_run_id || freeSslCurrentRunId);
                freeSslRenderDomainProgress(data.domains || []);

                if (data.storage_id && !freeSslStorageId) {
                    freeSslRememberActiveStorageId(data.storage_id);
                }

                if (data.status === 'issued') {
                    freeSslStopStatusMonitor();
                    const result = data.result || data;
                    freeSslResultData = {
                        domain: result.domain || document.getElementById('freesslDomain').value.trim(),
                        certificate: result.certificate || '',
                        private_key: result.private_key || '',
                        ca_bundle: result.ca_bundle || '',
                        full_chain: result.full_chain || ''
                    };
                    document.getElementById('freesslCert').value = freeSslResultData.certificate;
                    document.getElementById('freesslPrivKey').value = freeSslResultData.private_key;
                    document.getElementById('freesslCaBundle').value = freeSslResultData.ca_bundle;
                    document.getElementById('freesslFullChain').value = freeSslResultData.full_chain;
                    document.getElementById('freesslResultArea').classList.add('show');
                    document.getElementById('freesslChallengeCard').style.display = 'none';
                    document.getElementById('freesslFinalizeCard').style.display = 'none';
                    freeSslSetStep(5);
                    freeSslSetActionState('issued');
                    freeSslShowMessage('Chứng chỉ đã cấp xong và được tải tự động.', 'success');
                    freeSslLog('ACME hoàn tất cấp cert', 'success');
                    await freeSslLoadStoredList();
                    return;
                }

                if (data.status === 'invalid') {
                    freeSslStopStatusMonitor();
                    freeSslSetActionState('invalid');
                    freeSslShowMessage('ACME báo lỗi xác thực. Bạn có thể Retry.', 'error');
                    freeSslLog('Trạng thái ACME: invalid', 'error');
                    await freeSslLoadStoredList();
                }
            }, 3000);
        }

        function freeSslClearLog() {
            const box = document.getElementById('freesslLogBox');
            if (!box) return;
            box.style.display = 'none';
            box.innerHTML = '';
            freeSslLogCursor = 0;
        }

        function freeSslLog(message, type = 'info') {
            const box = document.getElementById('freesslLogBox');
            if (!box) return;
            box.style.display = 'block';
            const row = document.createElement('div');
            row.className = 'freessl-log-row ' + type;
            row.textContent = message;
            box.appendChild(row);
            box.scrollTop = box.scrollHeight;
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function freeSslSetActionState(status) {
            freeSslStatus = status || 'pending';
            const verifyBtn = document.getElementById('freesslVerifyBtn');
            const finalizeBtn = document.getElementById('freesslFinalizeBtn');
            const retryBtn = document.getElementById('freesslRetryBtn');
            if (verifyBtn) {
                verifyBtn.disabled = (freeSslStatus === 'valid' || freeSslStatus === 'issued' || freeSslStatus === 'finalizing');
                if (freeSslStatus === 'finalizing') {
                    verifyBtn.textContent = '⏳ Đang tự cấp cert...';
                } else {
                    verifyBtn.textContent = '🔎 Bước 3: Kiểm tra xác thực (Pre-check)';
                }
            }
            if (finalizeBtn) {
                finalizeBtn.disabled = (freeSslStatus === 'processing' || freeSslStatus === 'finalizing' || freeSslStatus === 'issued');
            }
            if (retryBtn) {
                retryBtn.style.display = (freeSslStatus === 'invalid' || freeSslStatus === 'pending') ? 'inline-flex' : 'none';
            }
        }

        function freeSslRetryCurrentStep() {
            if (!freeSslSessionId) {
                freeSslLog('Chưa có session để retry', 'error');
                return;
            }
            freeSslSetActionState('pending');
            freeSslLog('Retry bước xác thực...', 'loading');
            freeSslCheck();
        }

        function freeSslRememberActiveStorageId(storageId) {
            freeSslStorageId = storageId || null;
            if (storageId) localStorage.setItem('freessl_active_storage_id', storageId);
            else localStorage.removeItem('freessl_active_storage_id');
        }

        async function freeSslRestoreActiveFromStorage() {
            const storageId = localStorage.getItem('freessl_active_storage_id');
            if (!storageId) return;
            const { ok, data } = await freeSslFetch('/api/ssl-free/item/' + encodeURIComponent(storageId), null, 'GET');
            if (!ok || !data) {
                localStorage.removeItem('freessl_active_storage_id');
                return;
            }
            freeSslApplyStoredItem(data);
            const statusText = data.status === 'issued' ? 'đã cấp' : 'đang xử lý';
            freeSslShowMessage('Đã khôi phục SSL ' + statusText + ' sau khi tải lại trang.', 'info');
        }

        function freeSslGetFocusableElements(container) {
            if (!container) return [];
            return Array.from(container.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'))
                .filter(el => !el.hasAttribute('hidden'));
        }

        function freeSslHandleSidebarKeydown(event) {
            const sidebar = document.getElementById('freesslStorageSidebar');
            if (!sidebar || !sidebar.classList.contains('show')) return;

            if (event.key === 'Escape') {
                event.preventDefault();
                freeSslToggleStorage(false);
                return;
            }

            if (event.key !== 'Tab') return;
            const focusables = freeSslGetFocusableElements(sidebar);
            if (focusables.length === 0) return;

            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            const active = document.activeElement;

            if (event.shiftKey && active === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && active === last) {
                event.preventDefault();
                first.focus();
            }
        }

        function freeSslPositionStorageModal() {
            const sidebar = document.getElementById('freesslStorageSidebar');
            if (!sidebar) return;

            const nav = document.querySelector('.tab-nav');
            let modalTop = 92;

            if (nav) {
                const rect = nav.getBoundingClientRect();
                modalTop = Math.max(72, Math.round(rect.bottom + 10));
            }

            sidebar.style.setProperty('--storage-modal-top', modalTop + 'px');
        }

        function freeSslToggleStorage(show) {
            const shouldShow = !!show;
            const sidebar = document.getElementById('freesslStorageSidebar');
            const backdrop = document.getElementById('freesslStorageBackdrop');
            const opener = document.getElementById('freesslOpenSidebarBtn');
            if (!sidebar || !backdrop) return;

            sidebar.classList.toggle('show', shouldShow);
            backdrop.classList.toggle('show', shouldShow);
            sidebar.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
            backdrop.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
            document.body.classList.toggle('no-scroll', shouldShow);

            if (shouldShow) {
                freeSslLoadStoredList();
                freeSslSidebarLastFocus = document.activeElement;
                document.removeEventListener('keydown', freeSslHandleSidebarKeydown);
                document.addEventListener('keydown', freeSslHandleSidebarKeydown);
                const focusables = freeSslGetFocusableElements(sidebar);
                if (focusables.length > 0) {
                    setTimeout(() => focusables[0].focus(), 0);
                }
            } else {
                document.removeEventListener('keydown', freeSslHandleSidebarKeydown);
                const fallback = opener || document.querySelector('.tab-btn.active');
                const focusTarget = freeSslSidebarLastFocus && document.contains(freeSslSidebarLastFocus)
                    ? freeSslSidebarLastFocus
                    : fallback;
                if (focusTarget) focusTarget.focus();
                freeSslSidebarLastFocus = null;
            }
        }

        function freeSslUpdateProviderNote() {
            const el = document.getElementById('freesslProviderNote');
            if (!el) return;
            if (freeSslProvider === 'sslcom') {
                el.innerHTML = '🔎 <strong>SSL.com:</strong> chỉ hỗ trợ <strong>1 domain</strong> (không wildcard, không multi-domain/SAN).';
            } else if (freeSslProvider === 'zerossl') {
                el.innerHTML = '🔎 <strong>ZeroSSL:</strong> hỗ trợ multi-domain, <strong>không hỗ trợ wildcard</strong>. Nếu chỉ nhập domain gốc, hệ thống tự thêm <strong>www</strong>.';
            } else {
                el.innerHTML = '🔎 <strong>Let\'s Encrypt:</strong> hỗ trợ wildcard + multi-domain. Nếu chỉ nhập domain gốc, hệ thống tự thêm <strong>www</strong>.';
            }
        }

        function freeSslSelectProvider(p) {
            freeSslProvider = p;
            const map = { letsencrypt: 'btnProvLe', zerossl: 'btnProvZero', sslcom: 'btnProvSslcom' };
            Object.entries(map).forEach(([k, id]) => {
                document.getElementById(id).classList.toggle('selected', k === p);
            });
            freeSslUpdateProviderNote();
        }

        function freeSslApplyStoredItem(data) {
            const incomingOrderId = data && data.id ? data.id : null;
            if (incomingOrderId !== freeSslCurrentOrderId) {
                freeSslClearLog();
            }
            freeSslCurrentOrderId = incomingOrderId;
            freeSslResultData = null;
            freeSslCurrentRunId = null;
            document.getElementById('freesslDomain').value = data.domain || '';
            freeSslSessionId = data.session_id || null;
            freeSslSans = Array.isArray(data.sans) ? data.sans : [];
            freeSslChallengeType = data.challenge_type || 'dns-01';
            freeSslProvider = data.provider || 'letsencrypt';
            freeSslRenderSans();
            freeSslSelectChallenge(freeSslChallengeType);
            freeSslSelectProvider(freeSslProvider);
            freeSslRememberActiveStorageId(data.id || null);
            freeSslSetActionState(data.status || 'pending');
            freeSslCurrentRunId = data.current_run_id || null;
            freeSslApplyProgressLogs(data.progress_logs || [], freeSslCurrentRunId);

            if (data.status === 'finalizing' || data.status === 'processing') {
                freeSslLog('Hệ thống đang xử lý ACME, sẽ tự cập nhật khi xong...', 'loading');
                freeSslStartStatusMonitor();
            } else {
                freeSslStopStatusMonitor();
            }

            if (data.status === 'issued') {
                freeSslStopStatusMonitor();
                freeSslResultData = data;
                document.getElementById('freesslCert').value = data.certificate || '';
                document.getElementById('freesslPrivKey').value = data.private_key || '';
                document.getElementById('freesslCaBundle').value = data.ca_bundle || '';
                document.getElementById('freesslFullChain').value = data.full_chain || '';
                document.getElementById('freesslResultArea').classList.add('show');
                document.getElementById('freesslChallengeCard').style.display = 'none';
                document.getElementById('freesslFinalizeCard').style.display = 'none';
                freeSslSetStep(5);
                freeSslSetActionState('issued');
                return;
            }

            // In-progress session restore
            document.getElementById('freesslResultArea').classList.remove('show');
            if (Array.isArray(data.challenges) && data.challenges.length > 0) {
                freeSslRenderChallenges(data.challenges, freeSslChallengeType, freeSslProvider);
                document.getElementById('freesslChallengeCard').style.display = 'block';
            } else {
                document.getElementById('freesslChallengeCard').style.display = 'none';
            }

            const checkResults = Array.isArray(data.last_check_results) ? data.last_check_results : [];
            if (checkResults.length > 0) {
                document.getElementById('freesslCheckResults').innerHTML = checkResults.map(r => `
                    <div class="check-result-row ${r.ok ? 'ok' : 'fail'}">
                        <div><strong>${r.domain}</strong><br><span class="small-line">${r.detail}</span></div>
                    </div>
                `).join('');
            } else {
                document.getElementById('freesslCheckResults').innerHTML = '';
            }

            if (Array.isArray(data.domains) && data.domains.length > 0 && checkResults.length === 0) {
                freeSslRenderDomainProgress(data.domains);
            }

            const ready = data.status === 'ready' || data.status === 'valid';
            document.getElementById('freesslFinalizeCard').style.display = ready ? 'block' : 'none';
            if (data.status === 'invalid') freeSslSetStep(3);
            else freeSslSetStep(ready ? 4 : 2);
        }

        async function freeSslLoadStoredList() {
            const keyword = document.getElementById('freesslStoredSearch').value.trim();
            const query = keyword ? `?q=${encodeURIComponent(keyword)}` : '';
            const listEl = document.getElementById('freesslStoredList');
            listEl.innerHTML = '<div class="freessl-storage-empty">Đang tải danh sách...</div>';
            const { ok, data, errorText } = await freeSslFetch('/api/ssl-free/list' + query, null, 'GET');
            if (!ok) {
                listEl.innerHTML = `<div class="freessl-storage-empty">❌ ${errorText}</div>`;
                return;
            }
            if (!data.items || data.items.length === 0) {
                listEl.innerHTML = `
                    <div class="freessl-storage-empty">
                        Chưa có SSL nào được lưu.
                        <div style="margin-top:12px; display:flex; justify-content:center;">
                            <button class="btn btn-green" onclick="freeSslNewOrder()">Tạo order SSL mới</button>
                        </div>
                    </div>
                `;
                return;
            }
            listEl.innerHTML = data.items.map(item => {
                const status = item.status || 'issued';
                const statusMap = {
                    issued: { text: '✅ issued', style: 'background:#dcfce7;color:#166534;' },
                    ready: { text: '🟢 ready', style: 'background:#dbeafe;color:#1d4ed8;' },
                    processing: { text: '🟡 processing', style: 'background:#fef3c7;color:#92400e;' },
                    finalizing: { text: '🟠 finalizing', style: 'background:#ffedd5;color:#9a3412;' },
                    pending: { text: '🟡 pending', style: 'background:#fef3c7;color:#92400e;' }
                };
                const st = statusMap[status] || { text: 'ℹ️ ' + status, style: 'background:#e2e8f0;color:#334155;' };

                return `
                <div class="freessl-storage-item">
                    <div>
                        <div class="freessl-storage-domain">${item.domain}</div>
                        <div class="freessl-storage-meta">
                            <span class="freessl-storage-badge">📅 Cấp: ${item.issued_at || '-'}</span>
                            <span class="freessl-storage-badge">⏳ Hết hạn: ${item.valid_to || '-'}</span>
                            <span class="freessl-storage-badge">🧩 ${item.challenge_type || '-'}</span>
                            <span class="freessl-storage-badge" style="background:#e0f2fe;color:#0369a1;">🏪 ${item.provider || 'letsencrypt'}</span>
                            <span class="freessl-storage-badge" style="${st.style}">${st.text}</span>
                        </div>
                    </div>
                    <div class="freessl-storage-actions">
                        <button class="btn btn-secondary" onclick="freeSslViewStoredItem('${item.id}')">👁️ Mở</button>
                        <button class="btn btn-danger" onclick="freeSslDeleteStoredItem('${item.id}')">🗑️ Xóa</button>
                    </div>
                </div>
            `;
            }).join('');
        }

        async function freeSslViewStoredItem(itemId) {
            const { ok, data, errorText } = await freeSslFetch('/api/ssl-free/item/' + encodeURIComponent(itemId), null, 'GET');
            if (!ok) { freeSslShowMessage(errorText, 'error'); return; }
            freeSslApplyStoredItem(data);
            freeSslToggleStorage(false);
            freeSslRememberActiveStorageId(itemId);
            const stateText = (data.status === 'issued') ? 'đã cấp' : 'đang xử lý';
            freeSslShowMessage('Đã tải SSL ' + stateText + ' cho domain ' + (data.domain || ''), 'success');
        }

        async function freeSslDeleteStoredItem(itemId) {
            if (!confirm('Xóa SSL đã lưu này?')) return;
            const { ok, errorText } = await freeSslFetch('/api/ssl-free/item/' + encodeURIComponent(itemId), null, 'DELETE');
            if (!ok) { freeSslShowMessage(errorText, 'error'); return; }
            if (localStorage.getItem('freessl_active_storage_id') === itemId) {
                freeSslRememberActiveStorageId(null);
            }
            freeSslShowMessage('Đã xóa SSL đã lưu.', 'success');
            await freeSslLoadStoredList();
        }

        function freeSslSelectChallenge(type) {
            freeSslChallengeType = type;
            document.getElementById('btnDns01').classList.toggle('selected', type === 'dns-01');
            document.getElementById('btnHttp01').classList.toggle('selected', type === 'http-01');
        }

        function freeSslAddSan() {
            const input = document.getElementById('freesslSanInput');
            const val = input.value.trim().toLowerCase();
            if (!val) return;
            if (!freeSslSans.includes(val)) {
                freeSslSans.push(val);
                freeSslRenderSans();
            }
            input.value = '';
            input.focus();
        }

        function freeSslRemoveSan(san) {
            freeSslSans = freeSslSans.filter(s => s !== san);
            freeSslRenderSans();
        }

        function freeSslRenderSans() {
            const container = document.getElementById('freesslSansTags');
            container.innerHTML = freeSslSans.map(s =>
                `<div class="sans-tag"><span>${s}</span><button onclick="freeSslRemoveSan('${s}')" title="Xóa">✕</button></div>`
            ).join('');
        }

        function freeSslUpdateSANsPreview() {
            // email is derived automatically on submit
        }

        function freeSslShowMessage(msg, type) {
            const el = document.getElementById('freesslMessage');
            el.innerHTML = `<div class="message-${type}">${msg}</div>`;
        }

        function freeSslSetLoading(show, text) {
            document.getElementById('freesslLoading').classList.toggle('show', show);
            if (text) document.getElementById('freesslLoadingText').textContent = text;
        }

        function freeSslSetStep(activeStep) {
            for (let i = 1; i <= 5; i++) {
                const el = document.getElementById('step' + i);
                el.classList.remove('active', 'done');
                if (i < activeStep) el.classList.add('done');
                else if (i === activeStep) el.classList.add('active');
            }
        }

        async function freeSslStart() {
            const domain = document.getElementById('freesslDomain').value.trim().toLowerCase();
            const _firstToken = (domain.split(/[\s,;]+/).find(Boolean) || '').replace(/^\*\./, '');
            const email = _firstToken ? `admin@${_firstToken.replace(/^www\./, '')}` : '';

            if (!domain) {
                freeSslShowMessage('Vui lòng nhập tên miền', 'error');
                freeSslLog('Vui lòng nhập tên miền', 'error');
                return;
            }

            const domainTokens = domain.split(/[\s,;]+/).filter(Boolean);
            const hasWildcard = [...domainTokens, ...freeSslSans].some(x => (x || '').trim().startsWith('*.'));
            const hasMultiDomain = (domainTokens.length + freeSslSans.length) > 1;
            if (freeSslProvider === 'sslcom') {
                if (hasWildcard) {
                    freeSslShowMessage('SSL.com không hỗ trợ wildcard domain.', 'error');
                    return;
                }
                if (hasMultiDomain) {
                    freeSslShowMessage('SSL.com chỉ hỗ trợ 1 domain (không multi-domain/SAN).', 'error');
                    return;
                }
            }
            if (freeSslProvider === 'zerossl' && hasWildcard) {
                freeSslShowMessage('ZeroSSL không hỗ trợ wildcard domain.', 'error');
                return;
            }

            freeSslShowMessage('', '');
            freeSslClearLog();
            freeSslLog('Đang tạo order ACME...', 'loading');
            freeSslSetLoading(true, '⏳ Đang tạo RSA Key + CSR và gửi ACME Order...');
            document.getElementById('freesslStartBtn').disabled = true;
            document.getElementById('freesslChallengeCard').style.display = 'none';
            document.getElementById('freesslFinalizeCard').style.display = 'none';
            document.getElementById('freesslResultArea').classList.remove('show');

            try {
                const { ok, data, errorText } = await freeSslFetch('/api/ssl-free/start', {
                    domain, sans: freeSslSans, challenge_type: freeSslChallengeType, email, provider: freeSslProvider
                });
                if (!ok) { freeSslShowMessage('❌ ' + errorText, 'error'); return; }

                freeSslSessionId = data.session_id;
                freeSslRememberActiveStorageId(data.storage_id || null);
                freeSslRenderChallenges(data.challenges, freeSslChallengeType, freeSslProvider);
                document.getElementById('freesslChallengeCard').style.display = 'block';
                document.getElementById('freesslCheckResults').innerHTML = '';
                document.getElementById('freesslFinalizeCard').style.display = 'none';
                freeSslSetStep(2);
                freeSslSetActionState('pending');
                freeSslLog('Order tạo thành công, vui lòng thêm record xác thực', 'success');
                freeSslShowMessage('Order đã tạo! Hãy thực hiện cấu hình xác thực bên dưới.', 'success');
            } catch (err) {
                freeSslLog(err.message, 'error');
                freeSslShowMessage(err.message, 'error');
            } finally {
                freeSslSetLoading(false);
                document.getElementById('freesslStartBtn').disabled = false;
            }
        }

        function freeSslRenderChallenges(challenges, type, provider) {
            const container = document.getElementById('freesslChallengeList');
            const providerNames = { letsencrypt: "Let's Encrypt", zerossl: 'ZeroSSL', sslcom: 'SSL.com' };
            const provName = providerNames[provider] || provider;
            let html = '';
            challenges.forEach((ch, idx) => {
                html += `<div class="challenge-info-box">
                    <div class="challenge-info-header">
                        <span>${type === 'dns-01' ? '🌐 DNS Challenge' : '📁 HTTP Challenge'} — <strong>${ch.domain}</strong></span>
                        <span class="freessl-storage-badge provider-badge">🏪 ${provName}</span>
                    </div>
                    <div class="challenge-info-body">`;

                if (type === 'dns-01') {
                    html += `
                        <div class="challenge-field">
                            <label>Loại bản ghi DNS</label>
                            <div class="challenge-value"><span>TXT</span></div>
                        </div>
                        <div class="challenge-field">
                            <label>Tên bản ghi (Host/Name)</label>
                            <div class="challenge-value">
                                <span id="dns_name_${idx}">${ch.dns_name}</span>
                                <button class="copy-btn-small" onclick="freeSslCopyText('dns_name_${idx}')">📋 Copy</button>
                            </div>
                        </div>
                        <div class="challenge-field">
                            <label>Giá trị TXT (Value)</label>
                            <div class="challenge-value">
                                <span id="dns_val_${idx}">${ch.dns_value}</span>
                                <button class="copy-btn-small" onclick="freeSslCopyText('dns_val_${idx}')">📋 Copy</button>
                            </div>
                        </div>
                        <div class="message-info challenge-note">
                            📌 Vào nhà cung cấp DNS, thêm bản ghi TXT với tên <code>${ch.dns_name}</code> và giá trị trên.
                            DNS có thể mất 1–5 phút để lan truyền.
                        </div>`;
                } else {
                    html += `
                        <div class="challenge-field">
                            <label>Đường dẫn file cần tạo (trên webserver)</label>
                            <div class="challenge-value">
                                <span id="file_path_${idx}">http://${ch.domain}${ch.file_path}</span>
                                <button class="copy-btn-small" onclick="freeSslCopyText('file_path_${idx}')">📋 Copy</button>
                            </div>
                        </div>
                        <div class="challenge-field">
                            <label>Nội dung file</label>
                            <div class="challenge-value">
                                <span id="file_content_${idx}">${ch.file_content}</span>
                                <button class="copy-btn-small" onclick="freeSslCopyText('file_content_${idx}')">📋 Copy</button>
                            </div>
                        </div>
                        <div class="message-info challenge-note">
                            📌 Tạo file tại đường dẫn trên webserver với đúng nội dung. File phải truy cập được từ internet (HTTP, không redirect sang HTTPS).
                        </div>`;
                }

                html += `</div></div>`;
            });
            container.innerHTML = html;
        }

        async function freeSslCheck() {
            if (!freeSslSessionId) {
                freeSslLog('Chưa có session. Hãy bắt đầu lại.', 'error');
                freeSslShowMessage('Chưa có session. Hãy bắt đầu lại.', 'error');
                return;
            }
            if (freeSslStatus === 'processing' || freeSslStatus === 'finalizing' || freeSslStatus === 'issued') {
                freeSslLog('Session đang xử lý, vui lòng chờ...', 'info');
                return;
            }
            freeSslClearLog();
            freeSslLog('Đang refresh DNS cache công cộng và kiểm tra DNS pre-check...', 'loading');
            freeSslSetStep(3);
            freeSslSetActionState('processing');

            try {
                const { ok, data, errorText } = await freeSslFetch('/api/ssl-free/check-challenge', { session_id: freeSslSessionId });
                if (!ok) {
                    freeSslSetActionState('invalid');
                    freeSslLog(errorText, 'error');
                    freeSslShowMessage(errorText, 'error');
                    return;
                }

                if (data.current_run_id) freeSslCurrentRunId = data.current_run_id;
                freeSslApplyProgressLogs(data.progress_logs || [], freeSslCurrentRunId);

                if (Array.isArray(data.dns_cache_clear) && data.dns_cache_clear.length > 0) {
                    freeSslLog('Đã gửi yêu cầu refresh DNS cache tới Google/Cloudflare/OpenDNS/Quad9', 'success');
                }

                let html = '';
                let okCount = 0;
                data.results.forEach(r => {
                    if (r.ok) okCount += 1;
                    html += `<div class="check-result-row ${r.ok ? 'ok' : 'fail'}">
                        <div><strong>${r.domain}</strong><br><span class="small-line">${r.detail}</span></div>
                    </div>`;
                });
                document.getElementById('freesslCheckResults').innerHTML = html;
                freeSslLog(`Kết quả pre-check: ${okCount}/${data.results.length} bản ghi hợp lệ`, data.all_ok ? 'success' : 'info');

                if (data.status === 'invalid') {
                    freeSslSetActionState('invalid');
                    freeSslShowMessage('ACME xác thực thất bại. Có thể Retry sau khi sửa DNS.', 'error');
                    freeSslLog('ACME xác thực thất bại, hãy sửa cấu hình và Retry', 'error');
                    return;
                }

                if (data.auto_finalized && data.certificate) {
                    freeSslStopStatusMonitor();
                    freeSslLog('[ĐANG CHẠY] Đã xác thực auth, đang finalize order...', 'loading');
                    freeSslResultData = data;
                    freeSslRememberActiveStorageId(data.storage_id || freeSslStorageId || null);
                    document.getElementById('freesslCert').value = data.certificate || '';
                    document.getElementById('freesslPrivKey').value = data.private_key || '';
                    document.getElementById('freesslCaBundle').value = data.ca_bundle || '';
                    document.getElementById('freesslFullChain').value = data.full_chain || '';
                    document.getElementById('freesslResultArea').classList.add('show');
                    document.getElementById('freesslChallengeCard').style.display = 'none';
                    document.getElementById('freesslFinalizeCard').style.display = 'none';
                    freeSslSetStep(5);
                    freeSslSetActionState('issued');
                    freeSslLog('[OK] Đã tải chứng chỉ thành công', 'success');
                    freeSslShowMessage('🎉 Chứng chỉ SSL đã được cấp thành công! Có hiệu lực 90 ngày.', 'success');
                    await freeSslLoadStoredList();
                    return;
                }

                if (data.status === 'processing' || data.status === 'finalizing') {
                    freeSslSetActionState(data.status);
                    freeSslShowMessage('Đã gửi challenge. Hệ thống đang tự xác thực và sẽ tự hiển thị kết quả.', 'info');
                    freeSslRenderDomainProgress(data.domains || []);
                    freeSslStartStatusMonitor();
                } else if (data.all_ok) {
                    document.getElementById('freesslFinalizeCard').style.display = 'block';
                    freeSslSetStep(4);
                    freeSslSetActionState('valid');
                    freeSslLog('Authorization đã valid, có thể finalize thủ công nếu cần', 'success');
                    freeSslShowMessage('Xác thực xong. Có thể finalize.', 'success');
                } else {
                    freeSslSetActionState('pending');
                    freeSslShowMessage('Một số xác thực chưa đúng. Kiểm tra lại và thử lại sau vài phút.', 'info');
                }
            } catch (err) {
                freeSslSetActionState('invalid');
                freeSslLog(err.message, 'error');
                freeSslShowMessage(err.message, 'error');
            }
        }

        async function freeSslFinalize() {
            if (!freeSslSessionId) {
                freeSslLog('Chưa có session để finalize', 'error');
                return;
            }
            freeSslClearLog();
            freeSslLog('Đang finalize order...', 'loading');
            freeSslSetLoading(true, '🔐 Đang yêu cầu Let\'s Encrypt xác thực & cấp chứng chỉ...');
            document.getElementById('freesslFinalizeBtn').disabled = true;
            freeSslSetStep(4);
            freeSslSetActionState('finalizing');
            freeSslStartStatusMonitor();

            try {
                const { ok, data, errorText } = await freeSslFetch('/api/ssl-free/finalize', { session_id: freeSslSessionId });
                if (!ok) {
                    freeSslSetActionState('invalid');
                    freeSslLog(errorText, 'error');
                    freeSslShowMessage(errorText, 'error');
                    document.getElementById('freesslFinalizeBtn').disabled = false;
                    return;
                }

                freeSslResultData = data;
                freeSslRememberActiveStorageId(data.storage_id || freeSslStorageId || null);
                freeSslStopStatusMonitor();
                document.getElementById('freesslCert').value = data.certificate || '';
                document.getElementById('freesslPrivKey').value = data.private_key || '';
                document.getElementById('freesslCaBundle').value = data.ca_bundle || '';
                document.getElementById('freesslFullChain').value = data.full_chain || '';

                document.getElementById('freesslResultArea').classList.add('show');
                document.getElementById('freesslChallengeCard').style.display = 'none';
                document.getElementById('freesslFinalizeCard').style.display = 'none';
                freeSslSetStep(5);
                freeSslSetActionState('issued');
                freeSslLog('Finalize thành công và đã tải cert', 'success');
                freeSslShowMessage('Chứng chỉ SSL đã được cấp thành công! Có hiệu lực 90 ngày.', 'success');
                await freeSslLoadStoredList();
            } catch (err) {
                freeSslSetActionState('invalid');
                freeSslLog(err.message, 'error');
                freeSslShowMessage(err.message, 'error');
                document.getElementById('freesslFinalizeBtn').disabled = false;
            } finally {
                freeSslSetLoading(false);
            }
        }

        function freeSslCopy(elementId) {
            const el = document.getElementById(elementId);
            el.select();
            document.execCommand('copy');
            freeSslShowMessage('Đã copy vào clipboard.', 'success');
        }

        function freeSslCopyText(elementId) {
            const el = document.getElementById(elementId);
            const text = el.textContent || el.innerText;
            navigator.clipboard.writeText(text).then(() => {
                freeSslShowMessage('Đã copy.', 'success');
            }).catch(() => {
                const tmp = document.createElement('textarea');
                tmp.value = text;
                document.body.appendChild(tmp);
                tmp.select();
                document.execCommand('copy');
                document.body.removeChild(tmp);
                freeSslShowMessage('Đã copy.', 'success');
            });
        }

        async function freeSslDownloadAll() {
            if (!freeSslResultData) return;
            const domainInput = document.getElementById('freesslDomain').value.trim() || freeSslResultData.domain || 'domain';
            const domain = domainInput.replace(/[\\/:*?"<>|\s]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '') || 'domain';

            const cert = (freeSslResultData.certificate || '').trim();
            const privateKey = (freeSslResultData.private_key || '').trim();
            const caBundle = (freeSslResultData.ca_bundle || '').trim();
            const fullchain = (freeSslResultData.full_chain || '').trim();

            if (!cert || !privateKey) {
                freeSslShowMessage('Thiếu cert hoặc private key, không thể tạo gói tải xuống.', 'error');
                return;
            }

            if (typeof forge === 'undefined') {
                freeSslShowMessage('Chưa tải xong thư viện tạo PFX, vui lòng thử lại sau vài giây.', 'error');
                return;
            }

            try {
                const pemContent = [privateKey, cert, caBundle].filter(Boolean).join('\n') + '\n';
                const pfxBuffer = await createPFX(privateKey, fullchain || [cert, caBundle].filter(Boolean).join('\n\n'), '123456');

                const zip = new JSZip();
                zip.file('cert.crt', cert + '\n');
                zip.file('private.key', privateKey + '\n');
                zip.file('ca-bundle.crt', caBundle ? (caBundle + '\n') : '');
                zip.file('fullchain.pem', fullchain ? (fullchain + '\n') : [cert, caBundle].filter(Boolean).join('\n\n') + '\n');
                zip.file(domain + '.pem', pemContent);
                zip.file(domain + '.pfx', pfxBuffer);

                const blob = await zip.generateAsync({ type: 'blob' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = domain + '-ssl.zip';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                freeSslShowMessage('Đã tạo ZIP gồm 6 file: cert, key, ca-bundle, fullchain, PEM, PFX (password PFX: 123456).', 'success');
            } catch (err) {
                freeSslShowMessage('Không thể tạo PEM/PFX: ' + (err.message || err), 'error');
            }
        }

        function installSslSetMessage(message, type = 'info') {
            const el = document.getElementById('installSslMessage');
            if (!el) return;
            el.innerHTML = `<div class="message-${type}">${message}</div>`;
        }

        function installSslUseCatalog(item) {
            document.getElementById('installSslDomain').value = item.domain || item.name || '';
            document.getElementById('installSslServer').value = item.server || '';
            document.getElementById('installSslKey').value = item.key || '';
            document.getElementById('installSslCert').value = item.cert || '';
            document.getElementById('installSslBundle').value = item.bundle || '';
            installSslSetMessage(`Đã nạp dữ liệu từ <strong>${(item.name || '').replace(/</g, '&lt;')}</strong>.`, 'success');
        }

        async function installSslLoadCatalog(pathOverride = null) {
            const listEl = document.getElementById('installSslCatalogList');
            const infoEl = document.getElementById('installSslCatalogInfo');
            const pathInputEl = document.getElementById('installSslCatalogPath');
            const pathInput = pathOverride !== null ? pathOverride : pathInputEl.value.trim();
            listEl.innerHTML = '<div class="installssl-empty">Đang quét thư mục SSL...</div>';
            const url = '/api/ssl-catalog' + (pathInput ? '?path=' + encodeURIComponent(pathInput) : '');
            const { ok, data, errorText } = await freeSslFetch(url, null, 'GET');
            if (!ok) {
                listEl.innerHTML = `<div class="installssl-empty">❌ ${errorText}</div>`;
                infoEl.textContent = 'Không thể tải danh sách SSL.';
                return;
            }
            const items = Array.isArray(data.items) ? data.items : [];
            const actualPath = data.base_dir || (pathInput || '/home/nvpa/Desktop/ssl');
            infoEl.textContent = `Đang dùng thư mục: ${actualPath}`;
            if (!items.length) {
                listEl.innerHTML = `<div class="installssl-empty">Không tìm thấy thư mục cert nào trong ${actualPath}.</div>`;
                return;
            }
            listEl.innerHTML = '';
            const fragment = document.createDocumentFragment();
            items.forEach((item, idx) => {
                const row = document.createElement('div');
                row.className = 'installssl-item';
                row.innerHTML = `
                    <div>
                        <div class="installssl-item-title">${(item.name || '').replace(/</g, '&lt;')}</div>
                        <div class="installssl-item-meta">Server: ${(item.server || '-').replace(/</g, '&lt;')}</div>
                    </div>
                    <button class="btn btn-secondary btn-compact" type="button" data-item-index="${idx}">Chọn</button>
                `;
                row.querySelector('button').addEventListener('click', () => installSslUseCatalog(item));
                fragment.appendChild(row);
            });
            listEl.appendChild(fragment);
        }

        function installSslChooseFolder() {
            document.getElementById('installSslUploadFolder').click();
        }

        async function installSslUploadFolderChanged(event) {
            const files = Array.from(event.target.files || []);
            if (!files.length) {
                return;
            }
            const outputEl = document.getElementById('installSslOutput');
            const infoEl = document.getElementById('installSslCatalogInfo');
            outputEl.style.display = 'block';
            outputEl.textContent = 'Đang upload thư mục SSL...\n';
            installSslSetMessage('Đang upload và scan thư mục...', 'info');

            const formData = new FormData();
            files.forEach(file => {
                formData.append('files', file, file.webkitRelativePath || file.name);
            });

            try {
                const resp = await fetch('/api/ssl-upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await resp.json();
                if (!resp.ok) {
                    outputEl.textContent += `Upload thất bại: ${data.error || resp.statusText}\n`;
                    installSslSetMessage('Upload thư mục thất bại.', 'error');
                    return;
                }
                outputEl.textContent += 'Upload thành công. Đang load danh sách...\n';
                document.getElementById('installSslCatalogPath').value = data.base_dir || '';
                installSslLoadCatalog(data.base_dir);
                installSslSetMessage('Upload thư mục thành công.', 'success');
            } catch (err) {
                outputEl.textContent += `Lỗi upload: ${err.message || err}\n`;
                installSslSetMessage('Upload thư mục thất bại.', 'error');
            }
        }

        function installSslResetCatalog() {
            const pathInputEl = document.getElementById('installSslCatalogPath');
            pathInputEl.value = '';
            installSslLoadCatalog('');
            installSslSetMessage('Đã reset về thư mục SSL mặc định.', 'success');
        }

        async function installSslSubmit() {
            const domain = document.getElementById('installSslDomain').value.trim();
            const serverInput = document.getElementById('installSslServer').value.trim();
            const password = document.getElementById('installSslPassword').value.trim();
            const key = document.getElementById('installSslKey').value.trim();
            const cert = document.getElementById('installSslCert').value.trim();
            const bundle = document.getElementById('installSslBundle').value.trim();

            if (!domain || !key || !cert || !bundle) {
                installSslSetMessage('Vui lòng nhập domain và 3 file SSL.', 'error');
                return;
            }

            const outputEl = document.getElementById('installSslOutput');
            outputEl.style.display = 'block';
            outputEl.textContent = 'Đang bắt đầu cài SSL...\n';
            installSslSetMessage('Đang cài SSL, vui lòng chờ...', 'info');

            const controller = new AbortController();
            const signal = controller.signal;

            try {
                const response = await fetch('/api/install-ssl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        domain,
                        server_input: serverInput,
                        password,
                        key,
                        cert,
                        bundle
                    }),
                    signal
                });

                if (!response.ok && !response.body) {
                    const text = await response.text();
                    outputEl.textContent += 'Lỗi phản hồi server: ' + response.status + '\n' + text;
                    installSslSetMessage('Cài SSL thất bại.', 'error');
                    return;
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder('utf-8');
                let finished = false;
                let success = false;

                while (!finished) {
                    const { value, done } = await reader.read();
                    if (done) {
                        finished = true;
                        break;
                    }
                    const chunk = decoder.decode(value, { stream: true });
                    outputEl.textContent += chunk;
                    outputEl.scrollTop = outputEl.scrollHeight;
                }

                const finalText = outputEl.textContent || '';
                if (/successfully|SUCCESS|Install SSL completed/i.test(finalText)) {
                    installSslSetMessage('Cài SSL hoàn tất.', 'success');
                    success = true;
                } else if (/failed|ERROR|error/i.test(finalText)) {
                    installSslSetMessage('Cài SSL thất bại. Xem log bên dưới.', 'error');
                } else {
                    installSslSetMessage('Hoàn thành, kiểm tra log để biết chi tiết.', 'info');
                }

                return success;
            } catch (err) {
                outputEl.textContent += '\nLỗi tải log realtime: ' + (err.message || err);
                installSslSetMessage('Cài SSL thất bại.', 'error');
            }
        }

        function installSslReset() {
            document.getElementById('installSslDomain').value = '';
            document.getElementById('installSslServer').value = '';
            document.getElementById('installSslPassword').value = '';
            document.getElementById('installSslKey').value = '';
            document.getElementById('installSslCert').value = '';
            document.getElementById('installSslBundle').value = '';
            installSslSetMessage('', 'info');
            document.getElementById('installSslOutput').style.display = 'none';
            document.getElementById('installSslOutput').textContent = '';
        }

        function freeSslReset() {
            freeSslSessionId = null;
            freeSslStopStatusMonitor();
            freeSslRememberActiveStorageId(null);
            freeSslSans = [];
            freeSslChallengeType = 'dns-01';
            freeSslProvider = 'letsencrypt';
            freeSslResultData = null;
            freeSslStatus = 'pending';
            freeSslCurrentRunId = null;
            freeSslCurrentOrderId = null;
            document.getElementById('freesslDomain').value = '';
            document.getElementById('freesslSansTags').innerHTML = '';
            document.getElementById('freesslChallengeCard').style.display = 'none';
            document.getElementById('freesslFinalizeCard').style.display = 'none';
            document.getElementById('freesslResultArea').classList.remove('show');
            document.getElementById('freesslCheckResults').innerHTML = '';
            document.getElementById('freesslMessage').innerHTML = '';
            freeSslClearLog();
            freeSslSelectChallenge('dns-01');
            freeSslSelectProvider('letsencrypt');
            freeSslSetStep(1);
            freeSslSetActionState('pending');
            freeSslLoadStoredList();
        }

        function freeSslNewOrder() {
            freeSslToggleStorage(false);
            freeSslReset();
            freeSslShowMessage('Sẵn sàng tạo order mới.', 'info');
            const input = document.getElementById('freesslDomain');
            if (input) {
                input.focus();
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        switchTab(document.querySelector('.tab-btn.active')?.dataset.tab || 'dns');
        initTabNavigationA11y();
        setDnsView(dnsViewMode);
        setAIMode('chat');
        loadAIState();
        renderAIChatList();
        renderAIChatMessages();
        toggleAIPromptPanel(false);
        freeSslPositionStorageModal();
        window.addEventListener('resize', freeSslPositionStorageModal);

        freeSslLoadStoredList();
        freeSslRestoreActiveFromStorage();
        installSslLoadCatalog();
        freeSslSetActionState('pending');
        freeSslUpdateProviderNote();
        setSSLDecoderMode('match');
        setupSSLDecoderAutoRun();
    </script>
</body>
</html>
